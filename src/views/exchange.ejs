<%- include('partials/header', { title: 'Method Exchange — @Melasbit' }) %>

<section class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-12">

  <div class="mb-6">
    <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-slate-900 transition">
      <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to Available Methods
    </a>
  </div>

  <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-sm">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">

      <!-- Left: Info + Direct DM & WhatsApp Buttons -->
      <div class="lg:col-span-2 space-y-4">
        <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full">
          <i class="fa-solid fa-arrows-rotate"></i> Supplier Method Exchange
        </span>

        <h1 class="text-2xl sm:text-3xl font-extrabold leading-tight">
          Exchange Methods with <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline">@Melasbit</a>
        </h1>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          Are you a supplier with working methods? Propose a method exchange using the form, message <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer" class="text-sky-400 font-bold hover:underline">@Melasbit (https://t.me/Melasbit)</a> on Telegram, send a <strong>DM directly on the site</strong>, or contact me on <strong>WhatsApp</strong>. Live screen-share proof available for both sides!
        </p>

        <div class="space-y-2.5 pt-2">
          <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer"
             class="w-full py-2.5 px-4 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-extrabold text-xs transition flex items-center justify-center gap-2">
            <i class="fa-brands fa-telegram text-sm"></i>
            <span>Telegram: @Melasbit (https://t.me/Melasbit)</span>
          </a>

          <a href="/chat?support=1" class="w-full py-2.5 px-4 rounded-xl bg-white text-slate-900 hover:bg-slate-100 font-bold text-xs transition flex items-center justify-center gap-2">
            <i class="fa-regular fa-comments"></i>
            <span>Send DM on Site (@Melasbit)</span>
          </a>

          <a href="https://wa.me/21627076373?text=Hello%20%40Melasbit!%20I%20would%20like%20to%20exchange%20a%20method%20with%20you." target="_blank" rel="noopener noreferrer"
             class="w-full py-2.5 px-4 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs transition flex items-center justify-center gap-2">
            <i class="fa-brands fa-whatsapp text-sm"></i>
            <span>WhatsApp: +21627076373</span>
          </a>

          <a href="https://t.me/LicenzioChannel" target="_blank" rel="noopener noreferrer"
             class="w-full py-2.5 px-4 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs transition flex items-center justify-center gap-2">
            <i class="fa-brands fa-telegram text-sm"></i>
            <span>Telegram Channel: @LicenzioChannel</span>
          </a>
        </div>
      </div>

      <!-- Right: In-Site Exchange Form -->
      <div class="lg:col-span-3 bg-white/5 border border-white/10 rounded-2xl p-5 sm:p-6 space-y-4">
        <div class="text-sm font-bold text-white">🔄 Method Exchange Request Form</div>

        <form id="exchange-form" class="space-y-3.5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-semibold text-slate-300 mb-1">Your Name / Telegram Handle</label>
              <input type="text" id="exch-name" required value="<%= user ? user.name : '' %>" placeholder="e.g. @YourHandle" class="w-full text-xs px-3 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400">
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-300 mb-1">Your Contact (WhatsApp / Telegram / Email)</label>
              <input type="text" id="exch-contact" required value="<%= user ? user.email : '' %>" placeholder="e.g. +216... or @handle" class="w-full text-xs px-3 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400">
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-semibold text-slate-300 mb-1">Method You Offer in Exchange</label>
            <input type="text" id="exch-offered" required placeholder="e.g. ChatGPT Plus method, Canva Pro script, etc." class="w-full text-xs px-3 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400">
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-[11px] font-semibold text-slate-300">Which Method(s) Do You Want?</label>
            </div>
            <div class="flex flex-wrap gap-2 text-xs">
              <% if (services && services.length > 0) { %>
                <% services.forEach((service, idx) => { %>
                  <label class="inline-flex items-center gap-1.5 bg-slate-800 border border-slate-700 px-3 py-1.5 rounded-lg cursor-pointer">
                    <input type="checkbox" name="wanted" value="<%= service.title %>" <%= idx === 0 ? 'checked' : '' %> class="rounded text-emerald-500">
                    <span><%= service.title %></span>
                  </label>
                <% }) %>
              <% } %>
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-semibold text-slate-300 mb-1">Details / Cost &amp; Proof (Optional)</label>
            <textarea id="exch-details" rows="3" placeholder="Explain cost per account, live screen-share proof availability, or bulk deal details..." class="w-full text-xs px-3 py-2 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400"></textarea>
          </div>

          <button type="submit" id="exch-submit-btn" class="w-full py-3 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs sm:text-sm transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Submit Exchange Request</span>
          </button>
        </form>

        <div id="exch-success-box" class="hidden p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-200 text-xs space-y-2">
          <div class="font-bold text-emerald-300"><i class="fa-solid fa-circle-check mr-1"></i> Exchange request sent to @Melasbit!</div>
          <p>You can also follow up directly via <a href="/chat?support=1" class="underline font-bold text-white">DM Chat</a> or <a id="exch-success-wa" href="#" target="_blank" rel="noopener noreferrer" class="underline font-bold text-emerald-300">WhatsApp</a>.</p>
        </div>
      </div>

    </div>
  </div>

</section>

<script>
  const exchForm = document.getElementById('exchange-form');
  if (exchForm) {
    exchForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const senderName = document.getElementById('exch-name').value.trim();
      const contact = document.getElementById('exch-contact').value.trim();
      const offeredMethod = document.getElementById('exch-offered').value.trim();
      const details = document.getElementById('exch-details').value.trim();
      const wantedMethods = Array.from(exchForm.querySelectorAll('input[name="wanted"]:checked')).map(cb => cb.value);
      const btn = document.getElementById('exch-submit-btn');

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';

      try {
        const res = await fetch('/api/store/exchange', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ senderName, contact, offeredMethod, wantedMethods, details })
        });
        const data = await res.json();
        if (data.success) {
          const waMsg = `Hello @Melasbit! Method Exchange Request:\nFrom: ${senderName} (${contact})\nI Offer: ${offeredMethod}\nI Want: ${wantedMethods.join(', ') || 'Any method'}${details ? '\nDetails: ' + details : ''}`;
          document.getElementById('exch-success-wa').href = `https://wa.me/21627076373?text=${encodeURIComponent(waMsg)}`;
          document.getElementById('exch-success-box').classList.remove('hidden');
          exchForm.reset();
          if (window.showToast) window.showToast('Exchange request submitted!', 'success');
        } else {
          if (window.showToast) window.showToast(data.error || 'Error submitting exchange request', 'error');
        }
      } catch (err) {
        if (window.showToast) window.showToast('Network error. Please try again.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> <span>Submit Exchange Request</span>';
      }
    });
  }
</script>

<%- include('partials/footer') %>

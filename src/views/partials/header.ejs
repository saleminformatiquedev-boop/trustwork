<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FAFAFA]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>TrustWork</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif']
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    @keyframes fadeSlide {
      from { transform: translateY(-10px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .toast-anim { animation: fadeSlide 0.22s ease-out; }
    @keyframes twUnreadPulse {
      0%   { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.65); transform: scale(1); }
      50%  { transform: scale(1.12); }
      70%  { box-shadow: 0 0 0 7px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); transform: scale(1); }
    }
    .tw-unread {
      background: #ef4444; color: #fff; font-weight: 800; line-height: 1;
      border-radius: 9999px; text-align: center; border: 2px solid #fff;
      animation: twUnreadPulse 1.6s ease-in-out infinite;
    }
    .tw-unread.hidden { display: none; }
    button, a { -webkit-tap-highlight-color: transparent; }
  </style>
</head>
<body class="flex flex-col min-h-screen text-slate-900 antialiased pb-16 md:pb-0">

  <!-- Toast Notifications -->
  <div id="toast-container" class="fixed top-20 right-4 left-4 sm:left-auto sm:right-6 sm:w-80 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Minimalist Top Navigation -->
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2.5 font-bold text-base text-slate-900 tracking-tight">
        <span class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs">
          <i class="fa-solid fa-layer-group"></i>
        </span>
        <span>TrustWork</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium text-slate-600">
        <a href="/" class="px-3 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100/80 transition">
          Explore
        </a>
        <a href="/services/new" class="px-3 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100/80 transition">
          Publish
        </a>
        <% if (user) { %>
          <a href="/dashboard" class="px-3 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100/80 transition">
            Dashboard
          </a>
          <a href="/chat" class="px-3 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100/80 transition flex items-center gap-1.5">
            <span>Messages</span>
            <span id="header-unread-badge" class="tw-unread <%= (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) ? '' : 'hidden' %> px-1.5 py-1 text-[10px] min-w-[20px]">
              <%= typeof unreadChatCount !== 'undefined' ? (unreadChatCount > 9 ? '9+' : unreadChatCount) : 0 %>
            </span>
          </a>
          <a href="/chat?support=1" class="px-3 py-1.5 rounded-lg hover:text-slate-900 hover:bg-slate-100/80 transition text-slate-500">
            Support
          </a>
        <% } %>
        <% if (user && user.role === 'ADMIN') { %>
          <a href="/admin/disputes" class="px-3 py-1.5 rounded-lg text-amber-700 bg-amber-50 hover:bg-amber-100 font-semibold transition">
            Disputes
          </a>
        <% } %>
      </nav>

      <!-- User / Wallet -->
      <div class="flex items-center gap-2">
        <% if (user) { %>
          <!-- Browser Notification Toggle Button -->
          <button
            type="button"
            id="browser-notif-btn"
            onclick="window.requestBrowserNotificationPermission(true)"
            title="Enable Browser Notifications"
            class="relative w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200/80 text-slate-600 hover:text-slate-900 flex items-center justify-center transition">
            <i id="browser-notif-icon" class="fa-regular fa-bell text-xs"></i>
            <span id="browser-notif-dot" class="hidden absolute top-1 right-1 w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-white"></span>
          </button>

          <a href="/dashboard" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200/70 transition py-1.5 px-3 rounded-lg text-xs font-semibold text-slate-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span id="header-wallet-balance"><%= user.walletBalance.toFixed(2) %></span>
            <span class="text-slate-500">USDT</span>
          </a>

          <a href="/dashboard" class="flex items-center gap-2 p-1 rounded-full hover:bg-slate-100 transition" title="<%= user.name %>">
            <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + user.name %>" alt="<%= user.name %>" class="w-8 h-8 rounded-full border border-slate-200 object-cover">
          </a>

          <a href="/logout" title="Sign out" class="text-slate-400 hover:text-slate-700 transition text-sm p-1.5">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
          </a>
        <% } else { %>
          <a href="/login" class="inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-white bg-slate-900 rounded-lg hover:bg-slate-800 transition">
            Sign In
          </a>
        <% } %>
      </div>

    </div>
  </header>

  <!-- Mobile Bottom Navigation -->
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-slate-200 flex items-center justify-around h-14 px-2">
    <a href="/" class="flex flex-col items-center justify-center text-[11px] font-medium text-slate-600 hover:text-slate-900 flex-1 py-1">
      <i class="fa-solid fa-compass text-sm mb-0.5"></i>
      <span>Explore</span>
    </a>
    <a href="/services/new" class="flex flex-col items-center justify-center text-[11px] font-medium text-slate-600 hover:text-slate-900 flex-1 py-1">
      <i class="fa-solid fa-plus text-sm mb-0.5"></i>
      <span>Publish</span>
    </a>
    <% if (user) { %>
      <% const hasUnreadNav = (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0); %>
      <a id="bottom-messages-link" href="/chat" class="flex flex-col items-center justify-center text-[11px] <%= hasUnreadNav ? 'font-bold text-slate-900' : 'font-medium text-slate-600' %> hover:text-slate-900 flex-1 py-1 relative">
        <div class="relative">
          <i id="bottom-messages-icon" class="<%= hasUnreadNav ? 'fa-solid text-red-500' : 'fa-regular' %> fa-comment text-base mb-0.5"></i>
          <span id="bottom-unread-badge" class="tw-unread <%= (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) ? '' : 'hidden' %> absolute -top-2 -right-4 px-1 py-[3px] text-[10px] min-w-[18px]">
            <%= typeof unreadChatCount !== 'undefined' ? (unreadChatCount > 9 ? '9+' : unreadChatCount) : 0 %>
          </span>
        </div>
        <span>Messages</span>
      </a>
    <% } %>
    <a href="<%= user ? '/dashboard' : '/login' %>" class="flex flex-col items-center justify-center text-[11px] font-medium text-slate-600 hover:text-slate-900 flex-1 py-1">
      <i class="fa-regular fa-user text-sm mb-0.5"></i>
      <span><%= user ? 'Account' : 'Sign In' %></span>
    </a>
  </nav>

  <script>
    // Register Service Worker for Native Browser Notifications (Desktop & Mobile)
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }

    window.playNotificationSound = function() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, ctx.currentTime); // D5
        osc.frequency.setValueAtTime(880, ctx.currentTime + 0.08); // A5
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.28);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.28);
      } catch (e) {}
    };

    window.updateBrowserNotifButton = function() {
      const btn = document.getElementById('browser-notif-btn');
      const icon = document.getElementById('browser-notif-icon');
      const dot = document.getElementById('browser-notif-dot');
      if (!btn || !('Notification' in window)) {
        if (btn) btn.classList.add('hidden');
        return;
      }
      const perm = Notification.permission;
      if (perm === 'granted') {
        icon.className = 'fa-solid fa-bell text-xs text-emerald-600';
        dot.className = ' absolute top-1 right-1 w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-white';
        btn.title = 'Browser Notifications Enabled (Click to test)';
      } else if (perm === 'denied') {
        icon.className = 'fa-regular fa-bell-slash text-xs text-rose-500';
        dot.className = 'hidden';
        btn.title = 'Browser Notifications Blocked in Browser Settings';
      } else {
        icon.className = 'fa-regular fa-bell text-xs text-slate-600';
        dot.className = ' absolute top-1 right-1 w-2 h-2 rounded-full bg-amber-500 animate-pulse ring-2 ring-white';
        btn.title = 'Click to Enable Browser Notifications';
      }
    };

    window.triggerBrowserNotification = async function({ title, body, url = '/dashboard', tag = 'trustwork-notif', skipToast = false }) {
      window.playNotificationSound();
      if (!skipToast) {
        window.showToast(`${title} — ${body}`, 'info', url);
      }
      if (!('Notification' in window) || Notification.permission !== 'granted') return;

      const options = {
        body: body || '',
        tag: tag + '-' + Date.now(),
        renotify: true,
        data: { url }
      };

      try {
        if ('serviceWorker' in navigator) {
          const reg = await navigator.serviceWorker.getRegistration();
          if (reg && typeof reg.showNotification === 'function') {
            await reg.showNotification(title, options);
            return;
          }
        }
        const n = new Notification(title, options);
        n.onclick = function() {
          window.focus();
          if (url) window.location.href = url;
          n.close();
        };
      } catch (err) {
        console.warn('Browser notification fallback error:', err);
      }
    };

    window.requestBrowserNotificationPermission = async function(manualClick = false) {
      if (!('Notification' in window)) {
        if (manualClick) window.showToast('This browser does not support desktop/mobile notifications.', 'error');
        return;
      }
      if (Notification.permission === 'granted') {
        window.updateBrowserNotifButton();
        if (manualClick) {
          window.triggerBrowserNotification({
            title: '🔔 TrustWork Notifications Active',
            body: 'You will receive real-time alerts for messages, orders, and payments.',
            url: window.location.pathname
          });
        }
        return;
      }
      if (Notification.permission === 'denied') {
        window.updateBrowserNotifButton();
        if (manualClick) {
          window.showToast('Notifications are blocked. Please allow notifications in your browser address bar settings.', 'error');
        }
        return;
      }
      try {
        const perm = await Notification.requestPermission();
        window.updateBrowserNotifButton();
        if (perm === 'granted') {
          window.triggerBrowserNotification({
            title: '🔔 Browser Notifications Enabled!',
            body: 'Instant alerts for messages and escrow updates are now active.',
            url: window.location.pathname
          });
        }
      } catch (e) {}
    };

    document.addEventListener('DOMContentLoaded', () => {
      window.updateBrowserNotifButton();
      // Gently prompt on first user click if permission is still 'default'
      if ('Notification' in window && Notification.permission === 'default' && !sessionStorage.getItem('tw_notif_prompted')) {
        const autoAsk = () => {
          sessionStorage.setItem('tw_notif_prompted', '1');
          window.requestBrowserNotificationPermission(false);
          document.removeEventListener('click', autoAsk);
        };
        document.addEventListener('click', autoAsk, { once: true });
      }
    });

    <% if (user) { %>
      // Unread-messages badge: red pulsing pastille + "(N)" in the browser tab title
      window.setUnreadBadge = function (n) {
        n = parseInt(n, 10) || 0;
        const label = n > 9 ? '9+' : String(n);
        ['header-unread-badge', 'bottom-unread-badge'].forEach(id => {
          const b = document.getElementById(id);
          if (!b) return;
          b.textContent = label;
          b.classList.toggle('hidden', n <= 0);
        });
        // Footer (mobile) Messages button: solid red bubble + bold label while there are unread messages
        const navIcon = document.getElementById('bottom-messages-icon');
        const navLink = document.getElementById('bottom-messages-link');
        if (navIcon) {
          navIcon.classList.toggle('fa-solid', n > 0);
          navIcon.classList.toggle('fa-regular', n <= 0);
          navIcon.classList.toggle('text-red-500', n > 0);
        }
        if (navLink) {
          navLink.classList.toggle('font-bold', n > 0);
          navLink.classList.toggle('text-slate-900', n > 0);
          navLink.classList.toggle('font-medium', n <= 0);
          navLink.classList.toggle('text-slate-600', n <= 0);
        }
        const base = document.title.replace(/^\(\d+\+?\)\s*/, '');
        document.title = n > 0 ? `(${label}) ${base}` : base;
      };
      window.refreshUnreadBadge = async function () {
        try {
          const r = await fetch('/api/chat/unread-count', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
          if (!r.ok) return;
          const d = await r.json();
          if (d && d.success) window.setUnreadBadge(d.count);
        } catch (e) {}
      };
      window.setUnreadBadge(<%= parseInt(typeof unreadChatCount !== 'undefined' ? unreadChatCount : 0, 10) || 0 %>);
      setInterval(() => { if (document.visibilityState === 'visible') window.refreshUnreadBadge(); }, 15000);
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') window.refreshUnreadBadge(); });
      window.addEventListener('pageshow', () => window.refreshUnreadBadge());

      if (typeof io !== 'undefined') {
        const globalUserSocket = io();
        globalUserSocket.emit('join_user');

        globalUserSocket.on('chat_notification', (notif) => {
          const isViewingThisConversation = (window.location.pathname === '/chat' && window.location.search.includes(notif.conversationId) && document.visibilityState === 'visible');
          if (isViewingThisConversation) {
            // Already reading this conversation: it is marked read, just resync the counter shortly
            setTimeout(window.refreshUnreadBadge, 1500);
          } else {
            window.setUnreadBadge(notif.unreadTotal || 1);
          }
          if (!isViewingThisConversation) {
            window.triggerBrowserNotification({
              title: `💬 New message from ${notif.senderName}`,
              body: notif.preview || 'Tap to view conversation',
              url: `/chat?conversationId=${notif.conversationId}`,
              tag: `chat-${notif.conversationId}`
            });
          }
        });

        globalUserSocket.on('user_notification', (notif) => {
          if (!notif) return;
          const isSameVisibleOrderPage = (notif.url && window.location.pathname === notif.url && document.visibilityState === 'visible' && notif.type === 'order_message');
          if (!isSameVisibleOrderPage) {
            window.triggerBrowserNotification({
              title: notif.title || '🔔 TrustWork Notification',
              body: notif.body || 'You have a new update on TrustWork.',
              url: notif.url || '/dashboard',
              tag: notif.type || 'trustwork-event'
            });
          }
        });
      }
    <% } %>

    window.showToast = function(message, type = 'success', url = null) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      const bg = type === 'success' ? 'bg-slate-900' : (type === 'error' ? 'bg-rose-600' : 'bg-slate-800');
      toast.className = `toast-anim pointer-events-auto flex items-center justify-between gap-2.5 px-4 py-3 rounded-xl text-white text-xs font-medium shadow-lg ${bg} ${url ? 'cursor-pointer hover:bg-slate-700 transition' : ''}`;
      const textSpan = document.createElement('span');
      textSpan.textContent = message;
      toast.appendChild(textSpan);
      if (url) {
        const arrow = document.createElement('i');
        arrow.className = 'fa-solid fa-chevron-right text-[10px] text-slate-400 shrink-0';
        toast.appendChild(arrow);
        toast.addEventListener('click', () => {
          window.location.href = url;
        });
      }
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    };

    // Automatic CSRF Token Protection for all POST forms and fetch() calls
    (function() {
      const meta = document.querySelector('meta[name="csrf-token"]');
      const token = meta ? meta.getAttribute('content') : '';
      if (!token) return;

      const origFetch = window.fetch;
      window.fetch = function(input, init = {}) {
        const method = (init.method || 'GET').toUpperCase();
        if (['POST', 'PUT', 'DELETE', 'PATCH'].includes(method)) {
          init.headers = Object.assign({}, init.headers || {}, { 'X-CSRF-Token': token });
        }
        return origFetch.call(this, input, init);
      };

      function protectForms() {
        document.querySelectorAll('form').forEach(form => {
          const method = (form.getAttribute('method') || 'GET').toUpperCase();
          if (method === 'POST') {
            if (!form.querySelector('input[name="_csrf"]')) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = '_csrf';
              input.value = token;
              form.appendChild(input);
            }
            const enctype = (form.getAttribute('enctype') || '').toLowerCase();
            const action = form.getAttribute('action') || '';
            if (enctype === 'multipart/form-data' && action && !action.includes('_csrf=')) {
              const sep = action.includes('?') ? '&' : '?';
              form.setAttribute('action', action + sep + '_csrf=' + encodeURIComponent(token));
            }
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', protectForms);
      } else {
        protectForms();
      }
    })();
  </script>

  <main class="flex-grow">

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>TrustWork - PDF Guides & Methods (Guaranteed Escrow)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    @keyframes slideIn {
      from { transform: translateY(-20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .toast-anim { animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    button, a { -webkit-tap-highlight-color: transparent; }
  </style>
</head>
<body class="flex flex-col min-h-screen text-slate-800 antialiased pb-16 md:pb-0">

  <!-- Dynamic Global Toast Container -->
  <div id="toast-container" class="fixed top-16 right-4 left-4 sm:left-auto sm:right-6 sm:w-80 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Main Navbar -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
      
      <!-- Logo & Mobile Hamburger -->
      <div class="flex items-center gap-2.5">
        <button id="mobile-menu-toggle" type="button" class="md:hidden w-9 h-9 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition" aria-label="Main menu">
          <i class="fa-solid fa-bars text-base" id="hamburger-icon"></i>
        </button>

        <a href="/" class="flex items-center gap-2 font-bold text-lg sm:text-xl text-slate-900 group flex-shrink-0">
          <span class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shadow-md shadow-emerald-200 group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-file-pdf text-base sm:text-lg"></i>
          </span>
          <div class="flex flex-col leading-none">
            <span>Trust<span class="text-emerald-600">Work</span></span>
            <span class="text-[9px] font-bold text-slate-400 tracking-wider uppercase">PDF Guides & Methods</span>
          </div>
        </a>
      </div>

      <!-- Navigation links (Desktop) -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="/" class="hover:text-emerald-600 transition flex items-center gap-1.5">
          <i class="fa-solid fa-book-open text-xs text-emerald-600"></i> Guides & Méthodes
        </a>
        <a href="/services/new" class="hover:text-emerald-600 transition flex items-center gap-1.5">
          <i class="fa-solid fa-circle-arrow-up text-xs text-emerald-600"></i> Publier
        </a>
        <% if (user) { %>
          <a href="/history" class="hover:text-emerald-600 transition flex items-center gap-1.5">
            <i class="fa-solid fa-clock-rotate-left text-xs"></i> Mes Achats
          </a>
          <a href="/chat" class="hover:text-emerald-600 transition flex items-center gap-1.5 relative group">
            <i class="fa-regular fa-comments text-xs text-emerald-600"></i>
            <span>Messages</span>
            <span id="header-unread-badge" class="<%= (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) ? '' : 'hidden' %> px-1.5 py-0.2 bg-emerald-600 text-white text-[10px] font-black rounded-full min-w-[18px] text-center shadow-xs">
              <%= typeof unreadChatCount !== 'undefined' ? unreadChatCount : 0 %>
            </span>
          </a>
          <a href="/chat?support=1" class="hover:text-amber-600 text-slate-600 transition flex items-center gap-1.5" title="Contacter l'administrateur ou l'arbitrage TrustWork">
            <i class="fa-solid fa-headset text-xs text-amber-500"></i>
            <span>Support</span>
          </a>
        <% } %>
        <% if (user && user.role === 'ADMIN') { %>
          <a href="/admin/disputes" class="text-amber-600 hover:text-amber-700 font-semibold flex items-center gap-1.5">
            <i class="fa-solid fa-gavel"></i> Litiges
          </a>
        <% } %>
      </nav>

      <!-- User Area / Balance & Profile -->
      <div class="flex items-center gap-2 sm:gap-3">
        <% if (user) { %>
          <!-- Balances Badges -->
          <a href="/dashboard" class="flex items-center gap-1.5 sm:gap-2 bg-slate-100 hover:bg-slate-200/80 transition py-1.5 px-2.5 sm:px-3 rounded-full text-[11px] sm:text-xs font-semibold">
            <span class="text-emerald-700 flex items-center gap-1" title="Available USDT balance">
              <i class="fa-solid fa-wallet text-[10px] sm:text-xs"></i> 
              <span id="header-wallet-balance"><%= user.walletBalance.toFixed(0) %></span><span class="hidden sm:inline">.<%= (user.walletBalance % 1).toFixed(2).slice(2) %></span> <span class="text-[9px] sm:text-[11px]">USDT</span>
            </span>
            <% if (user.escrowBalance > 0) { %>
              <span class="text-slate-300">|</span>
              <span class="text-amber-700 flex items-center gap-1" title="Funds in escrow">
                <i class="fa-solid fa-lock text-[10px] sm:text-xs"></i> 
                <span id="header-escrow-balance"><%= user.escrowBalance.toFixed(0) %></span> <span class="text-[9px] sm:text-[11px]">USDT</span>
              </span>
            <% } %>
          </a>

          <!-- Profile link -->
          <a href="/dashboard" class="flex items-center gap-2 py-1 px-1.5 rounded-lg hover:bg-slate-100 transition flex-shrink-0">
            <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + user.name %>" alt="<%= user.name %>" class="w-8 h-8 rounded-full border border-slate-200 object-cover">
            <span class="text-xs font-semibold hidden lg:inline max-w-[100px] truncate"><%= user.name %></span>
          </a>

          <!-- Logout (Desktop) -->
          <a href="/logout" title="Logout" class="hidden sm:flex items-center text-slate-400 hover:text-rose-500 transition text-sm p-1">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
          </a>
        <% } else { %>
          <a href="/login" class="text-xs sm:text-sm font-semibold text-slate-700 hover:text-emerald-600 px-2 py-1">Login</a>
          <a href="/login" class="inline-flex items-center justify-center px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm font-semibold text-white bg-emerald-600 rounded-lg hover:bg-emerald-700 shadow-sm transition">
            Get Started
          </a>
        <% } %>
      </div>

    </div>

    <!-- Mobile Sub-Navigation -->
    <div class="md:hidden flex items-center justify-between gap-4 px-4 py-2 border-t border-slate-200 bg-white/95 backdrop-blur overflow-x-auto scrollbar-none text-xs font-semibold">
      <a href="/" class="text-slate-700 hover:text-emerald-600 transition flex-shrink-0 flex items-center gap-1">
        <i class="fa-solid fa-book-open text-emerald-600"></i> Guides PDF
      </a>
      <span class="text-slate-300">•</span>
      <a href="/services/new" class="text-slate-700 hover:text-emerald-600 transition flex-shrink-0 flex items-center gap-1">
        <i class="fa-solid fa-circle-arrow-up text-emerald-600"></i> Publier
      </a>
      <% if (user) { %>
        <span class="text-slate-300">•</span>
        <a href="/history" class="text-slate-700 hover:text-emerald-600 transition flex-shrink-0 flex items-center gap-1">
          <i class="fa-solid fa-clock-rotate-left text-[11px] text-slate-500"></i> Mes Achats
        </a>
        <span class="text-slate-300">•</span>
        <a href="/chat" class="text-slate-700 hover:text-emerald-600 transition flex-shrink-0 flex items-center gap-1 relative">
          <i class="fa-regular fa-comments text-[11px] text-emerald-600"></i> Messages
          <span id="mobile-unread-badge" class="<%= (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) ? '' : 'hidden' %> px-1.5 py-0.2 bg-emerald-600 text-white text-[9px] font-black rounded-full min-w-[16px] text-center shadow-xs">
            <%= typeof unreadChatCount !== 'undefined' ? unreadChatCount : 0 %>
          </span>
        </a>
        <span class="text-slate-300">•</span>
        <a href="/chat?support=1" class="text-slate-700 hover:text-amber-600 transition flex-shrink-0 flex items-center gap-1">
          <i class="fa-solid fa-headset text-[11px] text-amber-500"></i> Support
        </a>
      <% } %>
      <% if (user && user.role === 'ADMIN') { %>
        <span class="text-slate-300">•</span>
        <a href="/admin/disputes" class="text-amber-600 hover:text-amber-700 font-bold flex-shrink-0 flex items-center gap-1">
          <i class="fa-solid fa-gavel text-[11px]"></i> Litiges
        </a>
      <% } %>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-dropdown-menu" class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur px-4 py-3 space-y-2">
      <a href="/" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition">
        <i class="fa-solid fa-compass text-emerald-600 w-5"></i>
        <span>Explore Guides</span>
      </a>
      <a href="/services/new" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition">
        <i class="fa-solid fa-circle-plus text-emerald-600 w-5"></i>
        <span>Publish Method</span>
      </a>
      <% if (user) { %>
        <a href="/history" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition">
          <i class="fa-solid fa-clock-rotate-left text-emerald-600 w-5"></i>
          <span>History</span>
        </a>
        <a href="/chat" class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 transition">
          <div class="flex items-center gap-2.5">
            <i class="fa-regular fa-comments text-emerald-600 w-5"></i>
            <span>Direct Messages</span>
          </div>
          <span id="drawer-unread-badge" class="<%= (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) ? '' : 'hidden' %> px-2 py-0.5 bg-emerald-600 text-white text-[10px] font-bold rounded-full">
            <%= typeof unreadChatCount !== 'undefined' ? unreadChatCount : 0 %>
          </span>
        </a>
      <% } %>
      <% if (user && user.role === 'ADMIN') { %>
        <a href="/admin/disputes" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 transition">
          <i class="fa-solid fa-gavel text-amber-600 w-5"></i>
          <span>Dispute Resolution</span>
        </a>
      <% } %>
    </div>
  </header>

  <!-- Bottom Navigation Bar for Mobile -->
  <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-slate-200 flex items-center justify-around h-14 px-1 shadow-lg">
    <a href="/" class="flex flex-col items-center justify-center text-[10px] font-medium text-slate-600 hover:text-emerald-600 transition flex-1 py-1">
      <i class="fa-solid fa-compass text-sm mb-0.5"></i>
      <span>Explore</span>
    </a>
    <a href="/services/new" class="flex flex-col items-center justify-center text-[10px] font-medium text-slate-600 hover:text-emerald-600 transition flex-1 py-1">
      <i class="fa-solid fa-circle-plus text-sm mb-0.5 text-emerald-600"></i>
      <span>Publish</span>
    </a>
    <% if (user) { %>
      <a href="/chat" class="flex flex-col items-center justify-center text-[10px] font-medium text-slate-600 hover:text-emerald-600 transition flex-1 py-1 relative">
        <div class="relative">
          <i class="fa-regular fa-comments text-sm mb-0.5 text-emerald-600"></i>
          <span id="bottom-unread-badge" class="<%= (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) ? '' : 'hidden' %> absolute -top-1.5 -right-2 px-1 bg-emerald-600 text-white text-[8px] font-black rounded-full min-w-[14px] text-center shadow-xs">
            <%= typeof unreadChatCount !== 'undefined' ? unreadChatCount : 0 %>
          </span>
        </div>
        <span>Chat</span>
      </a>
    <% } %>
    <a href="/dashboard" class="flex flex-col items-center justify-center text-[10px] font-medium text-slate-600 hover:text-emerald-600 transition flex-1 py-1">
      <i class="fa-solid fa-wallet text-sm mb-0.5"></i>
      <span>Balance</span>
    </a>
    <% if (user && user.role === 'ADMIN') { %>
      <a href="/admin/disputes" class="flex flex-col items-center justify-center text-[10px] font-medium text-amber-600 hover:text-amber-700 transition flex-1 py-1">
        <i class="fa-solid fa-gavel text-sm mb-0.5"></i>
        <span>Disputes</span>
      </a>
    <% } %>
  </nav>

  <script>
    // Global Socket.io for live notifications
    <% if (user) { %>
      if (typeof io !== 'undefined') {
        const globalUserSocket = io();
        const currentGlobalUserId = "<%= user.id %>";
        globalUserSocket.emit('join_user', { userId: currentGlobalUserId });

        globalUserSocket.on('chat_notification', (notif) => {
          // Update unread badges
          const badges = [
            document.getElementById('header-unread-badge'),
            document.getElementById('mobile-unread-badge'),
            document.getElementById('drawer-unread-badge'),
            document.getElementById('bottom-unread-badge')
          ];
          badges.forEach(b => {
            if (b) {
              b.textContent = notif.unreadTotal || 1;
              b.classList.remove('hidden');
            }
          });

          // If not in the conversation, show toast
          const currentPath = window.location.pathname;
          const currentSearch = window.location.search;
          if (currentPath !== '/chat' || !currentSearch.includes(notif.conversationId)) {
            window.showToast(`💬 ${notif.senderName}: "${notif.preview}"`, 'info');
          }
        });
      }
    <% } %>
    // Toggle mobile hamburger menu
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const dropdownMenu = document.getElementById('mobile-dropdown-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');

    if (toggleBtn && dropdownMenu) {
      toggleBtn.addEventListener('click', () => {
        const isHidden = dropdownMenu.classList.contains('hidden');
        if (isHidden) {
          dropdownMenu.classList.remove('hidden');
          hamburgerIcon.classList.remove('fa-bars');
          hamburgerIcon.classList.add('fa-xmark');
        } else {
          dropdownMenu.classList.add('hidden');
          hamburgerIcon.classList.remove('fa-xmark');
          hamburgerIcon.classList.add('fa-bars');
        }
      });
    }

    // Toast helper
    window.showToast = function(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      const bg = type === 'success' ? 'bg-emerald-600' : (type === 'error' ? 'bg-rose-600' : 'bg-slate-800');
      const icon = type === 'success' ? 'fa-circle-check' : (type === 'error' ? 'fa-triangle-exclamation' : 'fa-info-circle');
      toast.className = `toast-anim pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl text-white text-xs font-semibold shadow-lg ${bg}`;
      
      const iconEl = document.createElement('i');
      iconEl.className = `fa-solid ${icon} text-sm flex-shrink-0`;
      const textSpan = document.createElement('span');
      textSpan.textContent = message;
      
      toast.appendChild(iconEl);
      toast.appendChild(textSpan);
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.4s';
        setTimeout(() => toast.remove(), 400);
      }, 3500);
    };
  </script>

  <main class="flex-grow">

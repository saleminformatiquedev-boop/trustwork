<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">

  <!-- User Profile & Quick Demo Switch -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 sm:p-6 rounded-2xl border border-slate-200/90">
    <div class="flex items-center gap-3.5 min-w-0">
      <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + user.name %>" class="w-12 h-12 rounded-full border border-slate-200 object-cover flex-shrink-0">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h1 class="text-lg font-bold text-slate-900 truncate"><%= user.name %></h1>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md <%= user.role === 'ADMIN' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600' %>">
            <%= user.role %>
          </span>
        </div>
        <p class="text-xs text-slate-400 truncate"><%= user.email %></p>
      </div>
    </div>

    <% if (typeof demoModeEnabled !== 'undefined' && demoModeEnabled) { %>
      <div class="flex items-center gap-1.5 text-xs">
        <span class="text-slate-400 mr-1 hidden sm:inline">Demo sandbox:</span>
        <a href="/auth/demo-login/buyer" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition">Buyer</a>
        <a href="/auth/demo-login/seller" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition">Seller</a>
        <a href="/auth/demo-login/admin" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition">Admin</a>
      </div>
    <% } %>
  </div>

  <!-- Wallet & Escrow Summary -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    
    <!-- Available Balance -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl flex flex-col justify-between">
      <div>
        <span class="text-xs text-slate-400 font-medium">Available Balance</span>
        <div class="text-3xl font-extrabold mt-1">
          <span id="dash-wallet-balance"><%= user.walletBalance.toFixed(2) %></span> <span class="text-sm font-semibold text-slate-400">USDT</span>
        </div>
      </div>

      <div class="mt-6 flex gap-2">
        <button id="open-deposit-modal-btn" class="flex-1 py-2.5 px-3 bg-[#F0B90B] hover:bg-[#FCD535] text-slate-950 text-xs font-bold rounded-xl transition">
          + Top Up
        </button>
        <button id="open-withdraw-btn" class="flex-1 py-2.5 px-3 bg-white/10 hover:bg-white/15 text-white text-xs font-semibold rounded-xl transition">
          Withdraw
        </button>
      </div>
    </div>

      <!-- In Escrow / Admin Commission -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/90 flex flex-col justify-between">
        <% if (user.role === 'ADMIN') { %>
          <div>
            <span class="text-xs text-emerald-700 font-semibold">Admin Commission Earned (15%)</span>
            <div class="text-3xl font-extrabold text-emerald-600 mt-1">
              <span><%= (typeof totalAdminCommission !== 'undefined' ? totalAdminCommission : 0).toFixed(2) %></span> <span class="text-sm font-semibold text-slate-400">USDT</span>
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-4 flex items-center gap-1.5">
            <i class="fa-solid fa-percent text-emerald-600"></i> 15% automatically collected on every completed order
          </p>
        <% } else { %>
          <div>
            <span class="text-xs text-slate-400 font-medium">In Escrow (Active Orders)</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1">
              <span id="dash-escrow-balance"><%= user.escrowBalance.toFixed(2) %></span> <span class="text-sm font-semibold text-slate-400">USDT</span>
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-4 flex items-center gap-1.5">
            <i class="fa-solid fa-lock text-emerald-600"></i> Released upon buyer approval (85% net to author, 15% fee)
          </p>
        <% } %>
      </div>

    <!-- Binance Pay ID / USDT Payout Address -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/90 flex flex-col justify-between">
      <div>
        <span class="text-xs text-slate-400 font-medium block mb-1">USDT Address (TRC20 / BEP20) or Binance ID</span>
        <form id="binance-form" class="mt-2 space-y-2">
          <input type="text" id="binanceId-input" name="binanceId" value="<%= user.binanceId || '' %>" placeholder="TRC20 (T...), BEP20 (0x...), or Binance ID" class="w-full text-xs px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl text-slate-900 focus:bg-white focus:border-slate-900 focus:outline-none">
          <button type="submit" id="binance-save-btn" class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs rounded-xl transition">
            Save Payout Address / ID
          </button>
        </form>
      </div>
    </div>

  </div>

  <!-- Tabbed Lists (Purchases / Sales / Wallet History) -->
  <div class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden">
    
    <div class="px-5 pt-4 border-b border-slate-100 flex items-center gap-6 text-xs sm:text-sm font-semibold overflow-x-auto">
      <button type="button" class="dash-tab border-b-2 border-slate-900 text-slate-900 pb-3 transition whitespace-nowrap" data-tab="tab-purchases">
        My Purchases (<%= buyerOrders.length %>)
      </button>
      <button type="button" class="dash-tab border-b-2 border-transparent text-slate-400 hover:text-slate-700 pb-3 transition whitespace-nowrap" data-tab="tab-sales">
        My Sales (<%= sellerOrders.length %>)
      </button>
      <button type="button" class="dash-tab border-b-2 border-transparent text-slate-400 hover:text-slate-700 pb-3 transition whitespace-nowrap" data-tab="tab-wallet">
        Deposits & Withdrawals (<%= (typeof deposits !== 'undefined' ? deposits.length : 0) + (typeof withdrawals !== 'undefined' ? withdrawals.length : 0) %>)
      </button>
    </div>

    <!-- Tab 1: My Purchases -->
    <div id="tab-purchases" class="dash-panel divide-y divide-slate-100">
      <% if (buyerOrders && buyerOrders.length > 0) { %>
        <% buyerOrders.forEach(ord => { %>
          <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between gap-4 hover:bg-slate-50/80 transition block">
            <div class="min-w-0">
              <div class="text-xs text-slate-400 mb-0.5">Author: <%= ord.sellerName %></div>
              <h4 class="text-sm font-bold text-slate-900 truncate"><%= ord.serviceTitle %></h4>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <span class="text-xs font-bold text-slate-900"><%= ord.amount.toFixed(2) %> USDT</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : (ord.status === 'DISPUTED' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700') %>">
                <%= ord.status === 'COMPLETED' ? 'Completed' : (ord.status === 'DELIVERED' ? 'Ready to review' : (ord.status === 'DISPUTED' ? 'Disputed' : 'In Escrow')) %>
              </span>
              <i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12 text-slate-400 text-xs">
          No purchased methods yet. <a href="/" class="text-slate-900 font-semibold underline ml-1">Browse catalog</a>
        </div>
      <% } %>
    </div>

    <!-- Tab 2: My Sales -->
    <div id="tab-sales" class="dash-panel hidden divide-y divide-slate-100">
      <% if (sellerOrders && sellerOrders.length > 0) { %>
        <% sellerOrders.forEach(ord => { %>
          <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between gap-4 hover:bg-slate-50/80 transition block">
            <div class="min-w-0">
              <div class="text-xs text-slate-400 mb-0.5">Buyer: <%= ord.buyerName %></div>
              <h4 class="text-sm font-bold text-slate-900 truncate"><%= ord.serviceTitle %></h4>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <div class="text-right">
                <span class="text-xs font-bold text-emerald-600 block">+<%= (ord.sellerNetAmount || (ord.amount * 0.85)).toFixed(2) %> USDT net</span>
                <span class="text-[10px] text-slate-400">Gross: <%= ord.amount.toFixed(2) %> (15% fee)</span>
              </div>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : (ord.status === 'DISPUTED' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700') %>">
                <%= ord.status === 'COMPLETED' ? 'Paid (85%)' : (ord.status === 'DELIVERED' ? 'Delivered' : (ord.status === 'DISPUTED' ? 'Disputed' : 'In Escrow')) %>
              </span>
              <i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12 text-slate-400 text-xs">
          No sales yet. <a href="/services/new" class="text-slate-900 font-semibold underline ml-1">Publish a method</a>
        </div>
      <% } %>
    </div>

    <!-- Tab 3: Deposits & Withdrawals -->
    <div id="tab-wallet" class="dash-panel hidden divide-y divide-slate-100">
      <% const allTx = [
           ...(typeof deposits !== 'undefined' ? deposits.map(d => ({ ...d, txType: 'DEPOSIT' })) : []),
           ...(typeof withdrawals !== 'undefined' ? withdrawals.map(w => ({ ...w, txType: 'WITHDRAW' })) : [])
         ]; %>
      <% if (allTx.length > 0) { %>
        <% allTx.forEach(tx => { %>
          <div class="p-5 flex items-center justify-between gap-4">
            <div>
              <div class="text-xs font-bold text-slate-900">
                <%= tx.txType === 'DEPOSIT' ? 'Binance Pay Top-Up' : 'Binance Pay Withdrawal' %>
              </div>
              <div class="text-[11px] text-slate-400">
                <%= new Date(tx.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </div>
            </div>
            <div class="text-right">
              <div class="text-xs font-bold <%= tx.txType === 'DEPOSIT' ? 'text-emerald-600' : 'text-slate-900' %>">
                <%= tx.txType === 'DEPOSIT' ? '+' : '-' %><%= tx.amount.toFixed(2) %> USDT
              </div>
              <span class="text-[10px] font-semibold <%= tx.status === 'COMPLETED' ? 'text-emerald-600' : (tx.status === 'REJECTED' ? 'text-rose-600' : 'text-amber-600') %>">
                <%= tx.status === 'COMPLETED' ? 'Completed' : (tx.status === 'REJECTED' ? 'Rejected' : 'Pending Verification') %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12 text-slate-400 text-xs">
          No deposit or withdrawal transactions yet.
        </div>
      <% } %>
    </div>

  </div>

</div>

<!-- Binance Pay Top-Up Modal -->
<div id="deposit-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4 overflow-y-auto">
  <div class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-xl border border-slate-200 toast-anim space-y-4 my-auto">
    
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="font-bold text-slate-900 text-base">Top Up via Binance Pay / USDT</h3>
      <button id="close-deposit-modal" class="text-slate-400 hover:text-slate-700 w-8 h-8 flex items-center justify-center">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs font-medium text-slate-600">
        <span>Amount (USDT)</span>
        <span class="font-bold text-slate-900" id="deposit-amount-display">50.00 USDT</span>
      </div>
      <div class="grid grid-cols-4 gap-2">
        <button type="button" data-amount="1" class="quick-amt-btn py-2 text-xs font-semibold rounded-xl border border-slate-200 hover:border-slate-900 text-slate-700 transition">1</button>
        <button type="button" data-amount="20" class="quick-amt-btn py-2 text-xs font-semibold rounded-xl border border-slate-200 hover:border-slate-900 text-slate-700 transition">20</button>
        <button type="button" data-amount="50" class="quick-amt-btn active py-2 text-xs font-semibold rounded-xl border-2 border-slate-900 bg-slate-900 text-white transition">50</button>
        <button type="button" data-amount="100" class="quick-amt-btn py-2 text-xs font-semibold rounded-xl border border-slate-200 hover:border-slate-900 text-slate-700 transition">100</button>
      </div>
      <input type="number" id="deposit-amount-input" step="0.01" min="0.5" value="50" placeholder="Custom amount (min 0.50 USDT)..." class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs font-semibold focus:border-slate-900 focus:outline-none">
    </div>

    <div class="bg-[#FAFAFA] border border-slate-200 p-4 rounded-xl text-center space-y-3">
      <!-- Method 1: Instant 0% Fee Binance Pay ID -->
      <div class="bg-white border border-amber-200 rounded-xl p-3 text-left space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700">1. Instant Binance Pay (0% Fee)</span>
          <span class="text-[10px] font-semibold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full">Auto-Credited</span>
        </div>
        <div class="flex items-center justify-between bg-slate-50 px-3 py-2 rounded-lg border border-slate-200/80">
          <span class="text-xs text-slate-500">Admin Pay ID:</span>
          <div class="flex items-center gap-2">
            <code id="deposit-binance-id-text" class="font-mono font-extrabold text-sm text-slate-900 select-all"><%= typeof platformBinancePayId !== 'undefined' ? platformBinancePayId : '1229901779' %></code>
            <button type="button" id="copy-binance-id-btn" class="px-2 py-0.5 rounded bg-emerald-600 text-white text-[11px] font-semibold hover:bg-emerald-700 transition">Copy ID</button>
          </div>
        </div>
        <a id="binance-app-pay-btn" href="bnc://app.binance.com/home/main" class="w-full py-2.5 px-4 bg-[#F0B90B] hover:bg-[#FCD535] text-slate-950 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2 cursor-pointer">
          <i class="fa-solid fa-copy"></i>
          <span id="binance-app-pay-btn-text">Copy Pay ID (1229901779) & Open Binance App</span>
        </a>
        <p id="binance-pay-helper-msg" class="text-[11px] text-slate-500 leading-relaxed">
          In Binance App: tap <strong>Pay</strong> (top-right) &rarr; <strong>Send</strong> &rarr; paste Pay ID <strong>1229901779</strong> &rarr; send USDT, then paste your <strong>Order ID</strong> below.
        </p>
      </div>

      <!-- Method 2: On-Chain USDT QR Code (TRC20 / BEP20) -->
      <div class="pt-2 border-t border-slate-200/80 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-semibold text-slate-600">2. Or Scan On-Chain USDT Address:</span>
          <div class="inline-flex rounded-lg border border-slate-200 bg-white p-0.5 text-[10px] font-bold">
            <button type="button" data-net="TRC20" class="qr-net-btn px-2 py-1 rounded-md bg-slate-900 text-white transition">TRC20</button>
            <button type="button" data-net="BEP20" class="qr-net-btn px-2 py-1 rounded-md text-slate-600 hover:text-slate-900 transition">BEP20</button>
          </div>
        </div>

        <div class="relative inline-block mx-auto bg-white p-2 rounded-xl border border-slate-200">
          <img id="deposit-qr-image" src="<%= typeof trc20QrDataUrl !== 'undefined' ? trc20QrDataUrl : '' %>" alt="USDT Deposit Address QR" class="w-36 h-36 object-contain mx-auto block">
          <div id="deposit-qr-loader" class="<%= typeof trc20QrDataUrl !== 'undefined' && trc20QrDataUrl ? 'hidden' : '' %> absolute inset-0 bg-white/95 rounded-xl flex items-center justify-center">
            <i class="fa-solid fa-spinner fa-spin text-lg text-slate-400"></i>
          </div>
        </div>

        <div class="text-left space-y-1.5 text-[11px]">
          <div class="flex items-center justify-between gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-200/70">
            <span class="text-slate-400 shrink-0 font-medium">TRC20:</span>
            <code id="deposit-trc20-text" class="font-mono text-slate-700 truncate select-all"><%= typeof trc20Address !== 'undefined' ? trc20Address : 'TNw9pxbxwf6qtvymRSnr2quaWxVCi5fwqu' %></code>
            <button type="button" data-copy-target="deposit-trc20-text" class="copy-addr-btn text-[11px] font-semibold text-emerald-600 hover:underline shrink-0">Copy</button>
          </div>
          <div class="flex items-center justify-between gap-2 bg-white px-2.5 py-1.5 rounded-lg border border-slate-200/70">
            <span class="text-slate-400 shrink-0 font-medium">BEP20:</span>
            <code id="deposit-bep20-text" class="font-mono text-slate-700 truncate select-all"><%= typeof bep20Address !== 'undefined' ? bep20Address : '0x284b2c731c9a9449f88f42bc707c05511bb9b222' %></code>
            <button type="button" data-copy-target="deposit-bep20-text" class="copy-addr-btn text-[11px] font-semibold text-emerald-600 hover:underline shrink-0">Copy</button>
          </div>
        </div>
      </div>
    </div>

    <form id="deposit-confirm-form" class="space-y-3">
      <div>
        <label class="text-xs font-medium text-slate-600 block mb-1">Binance Pay Order ID or Blockchain TxID (Auto-Verified via API):</label>
        <input type="text" id="deposit-txid-input" required placeholder="e.g. 463780934864084992" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs font-mono focus:border-slate-900 focus:outline-none">
      </div>
      <div class="flex gap-2">
        <button type="button" id="cancel-deposit-btn" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition">Cancel</button>
        <button type="submit" id="submit-deposit-btn" class="flex-1 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl transition">Verify via Binance API</button>
      </div>
    </form>

  </div>
</div>

<!-- Withdraw USDT Modal -->
<div id="withdraw-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200 toast-anim space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="font-bold text-slate-900 text-base">Withdraw USDT</h3>
      <button id="close-withdraw-modal" class="text-slate-400 hover:text-slate-700 w-8 h-8 flex items-center justify-center">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="bg-[#FAFAFA] p-3.5 rounded-xl border border-slate-200 text-xs space-y-1.5">
      <div class="flex justify-between">
        <span class="text-slate-500">Available balance:</span>
        <span class="font-bold text-slate-900"><%= user.walletBalance.toFixed(2) %> USDT</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Binance Pay ID:</span>
        <span class="font-semibold text-slate-800"><%= user.binanceId || 'Not configured' %></span>
      </div>
    </div>

    <form id="withdraw-form" class="space-y-4">
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="text-xs font-medium text-slate-600">Amount to withdraw (USDT)</label>
          <button type="button" id="withdraw-max-btn" class="text-xs font-semibold text-emerald-600 hover:underline">Max</button>
        </div>
        <input type="number" id="withdraw-amount-input" step="0.01" min="1" max="<%= user.walletBalance %>" required placeholder="50.00" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs font-semibold focus:border-slate-900 focus:outline-none">
      </div>

      <div class="flex gap-2">
        <button type="button" id="cancel-withdraw-btn" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition">Cancel</button>
        <button type="submit" id="submit-withdraw-btn" <%= !user.binanceId ? 'disabled' : '' %> class="flex-1 py-2.5 bg-slate-900 hover:bg-slate-800 disabled:bg-slate-200 disabled:text-slate-400 text-white font-semibold text-xs rounded-xl transition">Confirm</button>
      </div>
    </form>
  </div>
</div>

<script>
  const dashTabs = document.querySelectorAll('.dash-tab');
  const dashPanels = document.querySelectorAll('.dash-panel');
  dashTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      dashTabs.forEach(t => {
        t.classList.remove('border-slate-900', 'text-slate-900');
        t.classList.add('border-transparent', 'text-slate-400');
      });
      tab.classList.add('border-slate-900', 'text-slate-900');
      tab.classList.remove('border-transparent', 'text-slate-400');
      dashPanels.forEach(p => p.classList.toggle('hidden', p.id !== tab.dataset.tab));
    });
  });

  const openDepositModalBtn = document.getElementById('open-deposit-modal-btn');
  const depositModal = document.getElementById('deposit-modal');
  const closeDepositModal = document.getElementById('close-deposit-modal');
  const cancelDepositBtn = document.getElementById('cancel-deposit-btn');
  const depositAmountInput = document.getElementById('deposit-amount-input');
  const depositAmountDisplay = document.getElementById('deposit-amount-display');
  const depositQrImage = document.getElementById('deposit-qr-image');
  const depositQrLoader = document.getElementById('deposit-qr-loader');
  const binanceAppPayBtn = document.getElementById('binance-app-pay-btn');
  const depositConfirmForm = document.getElementById('deposit-confirm-form');
  const depositTxidInput = document.getElementById('deposit-txid-input');
  const submitDepositBtn = document.getElementById('submit-deposit-btn');
  const copyBinanceIdBtn = document.getElementById('copy-binance-id-btn');
  const depositBinanceIdText = document.getElementById('deposit-binance-id-text');
  const quickAmtBtns = document.querySelectorAll('.quick-amt-btn');
  const qrNetBtns = document.querySelectorAll('.qr-net-btn');
  const copyAddrBtns = document.querySelectorAll('.copy-addr-btn');
  const binanceAppPayBtnText = document.getElementById('binance-app-pay-btn-text');
  const binancePayHelperMsg = document.getElementById('binance-pay-helper-msg');

  let qrDebounceTimeout = null;
  let currentQrNetwork = 'TRC20';
  const preloadedQrMap = {
    TRC20: <%- JSON.stringify(typeof trc20QrDataUrl !== 'undefined' ? trc20QrDataUrl : '') %>,
    BEP20: <%- JSON.stringify(typeof bep20QrDataUrl !== 'undefined' ? bep20QrDataUrl : '') %>
  };

  async function loadDepositQR(amount, network) {
    if (!depositQrImage) return;
    if (network) currentQrNetwork = network;
    const amtVal = parseFloat(amount) || 50;
    if (depositAmountDisplay) depositAmountDisplay.textContent = `${amtVal.toFixed(2)} USDT`;

    if (preloadedQrMap[currentQrNetwork]) {
      depositQrImage.src = preloadedQrMap[currentQrNetwork];
      if (depositQrLoader) depositQrLoader.classList.add('hidden');
      return;
    }

    if (depositQrLoader) depositQrLoader.classList.remove('hidden');
    try {
      const res = await fetch(`/api/wallet/deposit-qr?amount=${encodeURIComponent(amtVal)}&network=${encodeURIComponent(currentQrNetwork)}`);
      const data = await res.json();
      if (data.success && data.qrCodeDataUrl) {
        preloadedQrMap[currentQrNetwork] = data.qrCodeDataUrl;
        depositQrImage.src = data.qrCodeDataUrl;
      }
    } catch (e) {
      console.warn(e);
    } finally {
      if (depositQrLoader) depositQrLoader.classList.add('hidden');
    }
  }

  function openDepositModal() {
    depositModal.classList.remove('hidden');
    depositModal.classList.add('flex');
    loadDepositQR(depositAmountInput ? depositAmountInput.value : 50, currentQrNetwork);
  }
  function closeDepositModalFn() {
    depositModal.classList.add('hidden');
    depositModal.classList.remove('flex');
  }

  if (openDepositModalBtn) openDepositModalBtn.addEventListener('click', openDepositModal);
  if (closeDepositModal) closeDepositModal.addEventListener('click', closeDepositModalFn);
  if (cancelDepositBtn) cancelDepositBtn.addEventListener('click', closeDepositModalFn);

  quickAmtBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      quickAmtBtns.forEach(b => {
        b.classList.remove('border-2', 'border-slate-900', 'bg-slate-900', 'text-white');
        b.classList.add('border-slate-200', 'text-slate-700');
      });
      btn.classList.add('border-2', 'border-slate-900', 'bg-slate-900', 'text-white');
      btn.classList.remove('border-slate-200', 'text-slate-700');
      const amt = btn.getAttribute('data-amount');
      if (depositAmountInput) depositAmountInput.value = amt;
      if (depositAmountDisplay) depositAmountDisplay.textContent = `${parseFloat(amt).toFixed(2)} USDT`;
      loadDepositQR(amt, currentQrNetwork);
    });
  });

  qrNetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      qrNetBtns.forEach(b => {
        b.classList.remove('bg-slate-900', 'text-white');
        b.classList.add('text-slate-600');
      });
      btn.classList.add('bg-slate-900', 'text-white');
      btn.classList.remove('text-slate-600');
      const net = btn.getAttribute('data-net') || 'TRC20';
      loadDepositQR(depositAmountInput ? depositAmountInput.value : 50, net);
    });
  });

  if (depositAmountInput) {
    depositAmountInput.addEventListener('input', (e) => {
      clearTimeout(qrDebounceTimeout);
      const val = parseFloat(e.target.value);
      quickAmtBtns.forEach(b => {
        if (parseFloat(b.getAttribute('data-amount')) === val) {
          b.classList.add('border-2', 'border-slate-900', 'bg-slate-900', 'text-white');
          b.classList.remove('border-slate-200', 'text-slate-700');
        } else {
          b.classList.remove('border-2', 'border-slate-900', 'bg-slate-900', 'text-white');
          b.classList.add('border-slate-200', 'text-slate-700');
        }
      });
      if (!isNaN(val) && val > 0) {
        if (depositAmountDisplay) depositAmountDisplay.textContent = `${val.toFixed(2)} USDT`;
        qrDebounceTimeout = setTimeout(() => loadDepositQR(val, currentQrNetwork), 300);
      }
    });
  }

  if (copyBinanceIdBtn && depositBinanceIdText) {
    copyBinanceIdBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(depositBinanceIdText.textContent.trim()).then(() => {
        copyBinanceIdBtn.textContent = 'Copied!';
        window.showToast('Binance Pay ID 1229901779 copied!', 'success');
        setTimeout(() => { copyBinanceIdBtn.textContent = 'Copy ID'; }, 1800);
      });
    });
  }

  copyAddrBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-copy-target');
      const el = document.getElementById(targetId);
      if (!el) return;
      navigator.clipboard.writeText(el.textContent.trim()).then(() => {
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        window.showToast('USDT Deposit Address copied!', 'success');
        setTimeout(() => { btn.textContent = orig; }, 1800);
      });
    });
  });

  if (binanceAppPayBtn && depositBinanceIdText) {
    binanceAppPayBtn.addEventListener('click', () => {
      const payId = depositBinanceIdText.textContent.trim();
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(payId).catch(() => {});
        }
      } catch (e) {}
      if (binanceAppPayBtnText) binanceAppPayBtnText.textContent = `Pay ID ${payId} Copied! Opening Binance App...`;
      if (binancePayHelperMsg) {
        binancePayHelperMsg.innerHTML = `<span class="text-emerald-700 font-semibold">✅ Pay ID <strong>${payId}</strong> copied to clipboard!</span> In Binance: tap the <strong>Pay icon</strong> (top-right) &rarr; <strong>Envoyer / Send</strong> &rarr; <strong>Paste ${payId}</strong>.`;
      }
      window.showToast(`Pay ID ${payId} copied! Opening Binance App...`, 'success');
      setTimeout(() => {
        if (binanceAppPayBtnText) binanceAppPayBtnText.textContent = `Copy Pay ID (${payId}) & Open Binance App`;
      }, 3000);
      // Do NOT call preventDefault(): the native 2-segment ARouter route href="bnc://app.binance.com/home/main" opens the Binance App cleanly without any deep-link error popup
    });
  }

  if (depositConfirmForm) {
    depositConfirmForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const amount = parseFloat(depositAmountInput.value);
      const txId = depositTxidInput.value.trim();
      if (!amount || !txId) return;
      submitDepositBtn.disabled = true;
      submitDepositBtn.textContent = 'Verifying...';
      try {
        const res = await fetch('/api/wallet/deposit-binance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, txId })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(data.message, 'success');
          closeDepositModalFn();
          setTimeout(() => window.location.reload(), 900);
        } else {
          window.showToast(data.error || 'Error', 'error');
        }
      } catch (err) {
        window.showToast('Network error', 'error');
      } finally {
        submitDepositBtn.disabled = false;
        submitDepositBtn.textContent = 'Verify & Credit';
      }
    });
  }

  const binanceForm = document.getElementById('binance-form');
  const binanceInput = document.getElementById('binanceId-input');
  const binanceSaveBtn = document.getElementById('binance-save-btn');
  if (binanceForm) {
    binanceForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      binanceSaveBtn.disabled = true;
      try {
        const res = await fetch('/api/wallet/update-binance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ binanceId: binanceInput.value.trim() })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast('Binance Pay ID saved', 'success');
          setTimeout(() => window.location.reload(), 800);
        }
      } finally {
        binanceSaveBtn.disabled = false;
      }
    });
  }

  const openWithdrawBtn = document.getElementById('open-withdraw-btn');
  const withdrawModal = document.getElementById('withdraw-modal');
  const closeWithdrawModal = document.getElementById('close-withdraw-modal');
  const cancelWithdrawBtn = document.getElementById('cancel-withdraw-btn');
  const withdrawForm = document.getElementById('withdraw-form');
  const withdrawAmountInput = document.getElementById('withdraw-amount-input');
  const withdrawMaxBtn = document.getElementById('withdraw-max-btn');
  const submitWithdrawBtn = document.getElementById('submit-withdraw-btn');

  function closeWithdrawModalFn() {
    withdrawModal.classList.add('hidden');
    withdrawModal.classList.remove('flex');
  }
  if (openWithdrawBtn) openWithdrawBtn.addEventListener('click', () => {
    withdrawModal.classList.remove('hidden');
    withdrawModal.classList.add('flex');
  });
  if (closeWithdrawModal) closeWithdrawModal.addEventListener('click', closeWithdrawModalFn);
  if (cancelWithdrawBtn) cancelWithdrawBtn.addEventListener('click', closeWithdrawModalFn);

  if (withdrawMaxBtn && withdrawAmountInput) {
    withdrawMaxBtn.addEventListener('click', () => {
      const currentBal = parseFloat(document.getElementById('dash-wallet-balance').textContent) || 0;
      withdrawAmountInput.value = currentBal.toFixed(2);
    });
  }

  if (withdrawForm) {
    withdrawForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const amount = parseFloat(withdrawAmountInput.value);
      if (!amount || amount <= 0) return;
      submitWithdrawBtn.disabled = true;
      try {
        const res = await fetch('/api/wallet/withdraw', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast('Withdrawal completed', 'success');
          closeWithdrawModalFn();
          setTimeout(() => window.location.reload(), 900);
        } else {
          window.showToast(data.error || 'Error', 'error');
        }
      } finally {
        submitWithdrawBtn.disabled = false;
      }
    });
  }
</script>

<%- include('partials/footer') %>

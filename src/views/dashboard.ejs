<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-6 sm:space-y-8">

  <!-- User Header & Quick Test Switch -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm">
    <div class="flex items-center gap-3.5 sm:gap-4">
      <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + user.name %>" class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl border border-slate-200 flex-shrink-0 object-cover">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h1 class="text-lg sm:text-xl font-bold text-slate-900 truncate"><%= user.name %></h1>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full flex-shrink-0 <%= user.role === 'ADMIN' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700' %>">
            <%= user.role %>
          </span>
        </div>
        <p class="text-xs text-slate-500 truncate"><%= user.email %></p>
      </div>
    </div>

    <!-- Quick test role selector -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 text-xs bg-slate-50 p-2 rounded-xl border border-slate-200">
      <span class="text-slate-500 font-semibold pl-1 text-[11px] sm:text-xs">Switch test role:</span>
      <div class="grid grid-cols-3 sm:flex gap-1.5">
        <a href="/auth/demo-login/buyer" class="text-center px-2.5 py-1 bg-white border border-slate-200 hover:border-blue-400 text-blue-700 font-medium rounded-lg text-[11px] transition">Buyer</a>
        <a href="/auth/demo-login/seller" class="text-center px-2.5 py-1 bg-white border border-slate-200 hover:border-purple-400 text-purple-700 font-medium rounded-lg text-[11px] transition">Seller</a>
        <a href="/auth/demo-login/admin" class="text-center px-2.5 py-1 bg-white border border-slate-200 hover:border-amber-400 text-amber-700 font-medium rounded-lg text-[11px] transition">Admin</a>
      </div>
    </div>
  </div>

  <!-- Wallet & Escrow Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    
    <!-- Available Balance -->
    <div class="bg-gradient-to-br from-emerald-600 to-emerald-700 text-white p-5 sm:p-6 rounded-2xl shadow-md flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-emerald-100 text-xs font-semibold mb-2">
          <span>Available Balance (USDT)</span>
          <i class="fa-solid fa-wallet text-base"></i>
        </div>
        <div class="text-2xl sm:text-3xl font-black">
          <span id="dash-wallet-balance"><%= user.walletBalance.toFixed(2) %></span> <span class="text-base sm:text-lg font-bold">USDT</span>
        </div>
        <p class="text-[11px] text-emerald-100 mt-2">Ready to purchase guides or withdraw to Binance.</p>
      </div>

      <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-emerald-500/50 flex flex-wrap gap-2">
        <button id="open-deposit-modal-btn" class="flex-1 min-w-[140px] px-3.5 py-2.5 bg-[#F0B90B] hover:bg-[#FCD535] text-slate-950 text-xs font-black rounded-xl transition flex items-center justify-center gap-2 shadow-md">
          <i class="fa-brands fa-bitcoin text-base text-slate-950"></i> Top Up (Binance Pay)
        </button>
        <button id="open-withdraw-btn" class="flex-1 min-w-[120px] px-3 py-2.5 bg-emerald-800/90 hover:bg-emerald-900 text-white text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 border border-emerald-400/40 shadow-sm">
          <i class="fa-solid fa-arrow-up-from-bracket text-[10px]"></i> Withdraw USDT
        </button>
      </div>
    </div>

    <!-- Escrow Balance -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-500 text-xs font-semibold mb-2">
          <span>In Escrow (Locked Funds)</span>
          <i class="fa-solid fa-lock text-amber-500 text-base"></i>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-slate-900">
          <span id="dash-escrow-balance"><%= user.escrowBalance.toFixed(2) %></span> <span class="text-base sm:text-lg font-bold text-slate-400">USDT</span>
        </div>
        <p class="text-[11px] text-slate-500 mt-2">
          Funds locked in orders pending delivery or buyer approval.
        </p>
      </div>

      <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-slate-100 text-[11px] sm:text-xs text-slate-400 flex items-center gap-1.5">
        <i class="fa-solid fa-shield-halved text-emerald-600"></i> Guaranteed protection
      </div>
    </div>

    <!-- Binance Pay Integration -->
    <div class="sm:col-span-2 lg:col-span-1 bg-slate-900 text-white p-5 sm:p-6 rounded-2xl shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-amber-400 text-xs font-bold mb-2">
          <span class="flex items-center gap-1.5">
            <i class="fa-brands fa-bitcoin text-sm"></i> Binance Pay
          </span>
          <span class="bg-amber-400/20 text-amber-300 text-[10px] px-2 py-0.5 rounded-full">Active</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed mb-3">
          Configure your Binance Pay ID to receive payouts directly to your wallet.
        </p>
        <form id="binance-form" class="space-y-2">
          <input type="text" id="binanceId-input" name="binanceId" value="<%= user.binanceId || '' %>" placeholder="Your Binance Pay ID (e.g. 123456789)" class="w-full text-xs px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-amber-400">
          <button type="submit" id="binance-save-btn" class="w-full py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-lg transition">
            Save Binance Pay ID
          </button>
        </form>
      </div>
    </div>

  </div>

  <!-- Direct Messaging Shortcut -->
  <div class="bg-gradient-to-r from-emerald-50 via-teal-50 to-white p-4 sm:p-5 rounded-2xl border border-emerald-200/80 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-3.5">
      <span class="w-12 h-12 rounded-2xl bg-emerald-600 text-white flex items-center justify-center text-xl shadow-sm flex-shrink-0">
        <i class="fa-regular fa-comments"></i>
      </span>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="font-bold text-slate-900 text-sm sm:text-base">Secure Direct Messaging</h3>
          <% if (typeof unreadChatCount !== 'undefined' && unreadChatCount > 0) { %>
            <span class="px-2 py-0.5 bg-emerald-600 text-white text-[10px] font-black rounded-full shadow-xs animate-pulse">
              <%= unreadChatCount %> new
            </span>
          <% } %>
        </div>
        <p class="text-xs text-slate-500 mt-0.5">
          Communicate in real-time with authors, buyers, and dispute support.
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto flex-shrink-0">
      <a href="/chat" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-sm transition flex items-center gap-1.5">
        <i class="fa-solid fa-paper-plane text-[10px]"></i>
        <span>Open Chat</span>
      </a>
      <a href="/chat?support=1" class="px-3.5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition flex items-center gap-1.5">
        <i class="fa-solid fa-headset text-amber-500"></i>
        <span>Support</span>
      </a>
    </div>
  </div>

  <!-- Orders & Sales Grids -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
    
    <!-- My Orders (As Buyer) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
          <i class="fa-solid fa-file-pdf text-rose-500"></i> My Purchased PDF Guides
        </h2>
        <span class="text-xs text-slate-500"><%= buyerOrders.length %> guide(s)</span>
      </div>

      <div class="divide-y divide-slate-100">
        <% if (buyerOrders && buyerOrders.length > 0) { %>
          <% buyerOrders.forEach(ord => { %>
            <a href="/orders/<%= ord.id %>" class="p-4 sm:p-5 flex items-center justify-between gap-3 hover:bg-slate-50 transition block">
              <div class="space-y-1 min-w-0">
                <span class="text-[10px] sm:text-[11px] font-bold text-slate-400 block truncate">#<%= ord.id %> • Author: <%= ord.sellerName %></span>
                <h4 class="text-xs sm:text-sm font-bold text-slate-800 truncate"><%= ord.serviceTitle %></h4>
                <div class="text-[11px] sm:text-xs text-slate-500 flex items-center gap-2">
                  <span><%= ord.amount.toFixed(2) %> USDT</span>
                  <span class="text-emerald-600 font-semibold flex items-center gap-1"><i class="fa-solid fa-download text-[10px]"></i> PDF Available</span>
                </div>
              </div>
              <div class="text-right flex-shrink-0">
                <span class="inline-block text-[10px] sm:text-xs font-bold px-2.5 py-0.5 sm:py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (ord.status === 'DELIVERED' ? 'bg-amber-100 text-amber-800' : (ord.status === 'DISPUTED' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800')) %>">
                  <%= ord.status %>
                </span>
                <span class="block text-[10px] sm:text-[11px] text-slate-400 mt-1">View <i class="fa-solid fa-chevron-right text-[8px]"></i></span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="text-center py-10 text-slate-400 text-xs">
            You have not purchased any PDF guides yet.
          </div>
        <% } %>
      </div>
    </div>

    <!-- My Sales (As Author / Seller) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
          <i class="fa-solid fa-book-bookmark text-blue-600"></i> My Published PDF Methods
        </h2>
        <span class="text-xs text-slate-500"><%= sellerOrders.length %> sale(s)</span>
      </div>

      <div class="divide-y divide-slate-100">
        <% if (sellerOrders && sellerOrders.length > 0) { %>
          <% sellerOrders.forEach(ord => { %>
            <a href="/orders/<%= ord.id %>" class="p-4 sm:p-5 flex items-center justify-between gap-3 hover:bg-slate-50 transition block">
              <div class="space-y-1 min-w-0">
                <span class="text-[10px] sm:text-[11px] font-bold text-slate-400 block truncate">#<%= ord.id %> • Buyer: <%= ord.buyerName %></span>
                <h4 class="text-xs sm:text-sm font-bold text-slate-800 truncate"><%= ord.serviceTitle %></h4>
                <div class="text-[11px] sm:text-xs text-emerald-600 font-semibold">+<%= ord.amount.toFixed(2) %> USDT</div>
              </div>
              <div class="text-right flex-shrink-0">
                <span class="inline-block text-[10px] sm:text-xs font-bold px-2.5 py-0.5 sm:py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (ord.status === 'DELIVERED' ? 'bg-amber-100 text-amber-800' : (ord.status === 'DISPUTED' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800')) %>">
                  <%= ord.status %>
                </span>
                <span class="block text-[10px] sm:text-[11px] text-slate-400 mt-1">Details <i class="fa-solid fa-chevron-right text-[8px]"></i></span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="text-center py-10 text-slate-400 text-xs">
            No sales recorded for your PDF methods yet.
          </div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Binance Pay Flows (Deposits & Withdrawals) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
    
    <!-- 1. Binance Deposit History -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
          <i class="fa-solid fa-circle-down text-emerald-600"></i> Binance Deposit History
        </h2>
        <span class="text-xs text-slate-500"><%= typeof deposits !== 'undefined' ? deposits.length : 0 %> deposit(s)</span>
      </div>

      <div class="divide-y divide-slate-100" id="deposits-list">
        <% if (typeof deposits !== 'undefined' && deposits.length > 0) { %>
          <% deposits.forEach(d => { %>
            <div class="p-4 sm:p-5 flex items-center justify-between gap-3 hover:bg-slate-50 transition">
              <div class="space-y-1 min-w-0">
                <span class="text-[10px] text-slate-400 font-bold block truncate">#<%= d.id %> • TxID: <%= d.txId || 'N/A' %></span>
                <div class="text-xs font-bold text-slate-800"><%= new Date(d.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
                <span class="text-[10px] text-slate-500 block truncate">Pay ID: <%= d.binancePayId || 'Binance Pay' %></span>
              </div>
              <div class="text-right flex-shrink-0">
                <div class="text-xs sm:text-sm font-black text-emerald-600">+<%= d.amount.toFixed(2) %> USDT</div>
                <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded-full mt-1 bg-emerald-100 text-emerald-800">
                  <%= d.status === 'COMPLETED' ? 'Credited' : 'Pending' %>
                </span>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-8 text-slate-400 text-xs">
            No deposits completed yet.
          </div>
        <% } %>
      </div>
    </div>

    <!-- 2. Binance Pay Withdrawal History -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
          <i class="fa-solid fa-clock-rotate-left text-amber-500"></i> Binance Pay Withdrawal History
        </h2>
        <span class="text-xs text-slate-500"><%= typeof withdrawals !== 'undefined' ? withdrawals.length : 0 %> request(s)</span>
      </div>

      <div class="divide-y divide-slate-100" id="withdrawals-list">
        <% if (typeof withdrawals !== 'undefined' && withdrawals.length > 0) { %>
          <% withdrawals.forEach(w => { %>
            <div class="p-4 sm:p-5 flex items-center justify-between gap-3 hover:bg-slate-50 transition">
              <div class="space-y-1 min-w-0">
                <span class="text-[10px] text-slate-400 font-bold block truncate">#<%= w.id %> • Binance Pay ID: <%= w.binanceId %></span>
                <div class="text-xs font-bold text-slate-800"><%= new Date(w.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
              </div>
              <div class="text-right flex-shrink-0">
                <div class="text-xs sm:text-sm font-black text-rose-600">-<%= w.amount.toFixed(2) %> USDT</div>
                <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded-full mt-1 <%= w.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (w.status === 'REJECTED' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800') %>">
                  <%= w.status === 'COMPLETED' ? 'Paid' : (w.status === 'REJECTED' ? 'Rejected' : 'Pending') %>
                </span>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-8 text-slate-400 text-xs">
            No withdrawal requests made yet.
          </div>
        <% } %>
      </div>
    </div>

  </div>

</div>

<!-- Binance Pay Top-Up Modal -->
<div id="deposit-modal" class="fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm hidden items-center justify-center p-3 sm:p-4 overflow-y-auto">
  <div class="bg-white rounded-3xl max-w-md w-full p-5 sm:p-6 shadow-2xl border border-slate-100 toast-anim space-y-4 my-6 max-h-[92vh] overflow-y-auto">
    
    <!-- Binance Pay Header -->
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-2xl bg-[#F0B90B] text-slate-950 flex items-center justify-center shadow-md shadow-amber-200 flex-shrink-0">
          <i class="fa-brands fa-bitcoin text-xl"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-black text-slate-900 text-sm sm:text-base">Binance Pay Top-Up</h3>
            <span class="text-[9px] font-extrabold bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full uppercase">0% Fees</span>
          </div>
          <p class="text-[11px] text-slate-500">Instant USDT credit guaranteed</p>
        </div>
      </div>
      <button id="close-deposit-modal" class="text-slate-400 hover:text-slate-600 w-8 h-8 rounded-lg flex items-center justify-center transition">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <!-- 1. Amount Selection -->
    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs font-bold text-slate-700">
        <span>1. Select Amount to Top Up:</span>
        <span class="text-xs font-black text-emerald-600" id="deposit-amount-display">50.00 USDT</span>
      </div>
      
      <!-- Quick Buttons -->
      <div class="grid grid-cols-4 gap-1.5" id="quick-amounts-container">
        <button type="button" data-amount="20" class="quick-amt-btn py-1.5 px-1 text-xs font-bold rounded-xl border border-slate-200 hover:border-amber-400 hover:bg-amber-50 text-slate-700 transition">20 $</button>
        <button type="button" data-amount="50" class="quick-amt-btn active py-1.5 px-1 text-xs font-bold rounded-xl border-2 border-amber-500 bg-amber-50 text-amber-900 transition">50 $</button>
        <button type="button" data-amount="100" class="quick-amt-btn py-1.5 px-1 text-xs font-bold rounded-xl border border-slate-200 hover:border-amber-400 hover:bg-amber-50 text-slate-700 transition">100 $</button>
        <button type="button" data-amount="250" class="quick-amt-btn py-1.5 px-1 text-xs font-bold rounded-xl border border-slate-200 hover:border-amber-400 hover:bg-amber-50 text-slate-700 transition">250 $</button>
      </div>

      <!-- Custom Input -->
      <div class="relative">
        <input type="number" id="deposit-amount-input" step="0.01" min="1" value="50" placeholder="Custom amount (USDT)..." class="w-full pl-3.5 pr-14 py-2 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-amber-400 focus:outline-none">
        <span class="absolute right-3.5 top-2 text-xs font-black text-amber-600">USDT</span>
      </div>
    </div>

    <!-- 2. QR Code & Pay on Binance -->
    <div class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white p-4 rounded-2xl space-y-3 text-center shadow-inner">
      <div class="text-[11px] text-amber-400 font-bold uppercase tracking-wider flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-qrcode"></i> Scan with Binance App
      </div>

      <!-- QR Code Frame -->
      <div class="relative inline-block mx-auto bg-white p-2.5 rounded-2xl shadow-lg border border-slate-800">
        <img id="deposit-qr-image" src="" alt="Binance Pay QR Code" class="w-44 h-44 sm:w-48 sm:h-48 object-contain rounded-xl mx-auto block">
        <div id="deposit-qr-loader" class="absolute inset-0 bg-white/95 rounded-2xl flex flex-col items-center justify-center gap-2">
          <i class="fa-solid fa-spinner fa-spin text-2xl text-amber-500"></i>
          <span class="text-[10px] font-bold text-slate-600">Generating QR Code...</span>
        </div>
      </div>

      <!-- PAY ON BINANCE APP BUTTON -->
      <div>
        <a id="binance-app-pay-btn" href="#" target="_blank" rel="noopener noreferrer" class="w-full py-3 px-4 bg-[#F0B90B] hover:bg-[#FCD535] active:scale-95 text-slate-950 font-black text-xs sm:text-sm rounded-xl shadow-lg shadow-amber-500/25 transition flex items-center justify-center gap-2">
          <i class="fa-brands fa-bitcoin text-base"></i>
          <span>Pay on Binance App</span>
          <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-75"></i>
        </a>
      </div>

      <!-- Payee Binance Pay Details with Copy -->
      <div class="bg-slate-800/90 border border-slate-700/80 rounded-xl p-2.5 text-left space-y-1.5 text-[11px]">
        <div class="flex items-center justify-between">
          <span class="text-slate-400">Binance Pay ID:</span>
          <div class="flex items-center gap-1.5">
            <code id="deposit-binance-id-text" class="text-amber-400 font-mono font-bold"><%= typeof platformBinancePayId !== 'undefined' ? platformBinancePayId : 'BINANCE-PAY-789456' %></code>
            <button type="button" id="copy-binance-id-btn" class="px-2 py-0.5 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded text-[10px] font-bold transition flex items-center gap-1">
              <i class="fa-regular fa-copy"></i> Copy
            </button>
          </div>
        </div>
        <div class="flex items-center justify-between text-slate-400 border-t border-slate-700/60 pt-1.5">
          <span>Accepted Network:</span>
          <span class="text-slate-200 font-semibold">Binance Pay / USDT</span>
        </div>
      </div>
    </div>

    <!-- 3. Form to Declare TxID / Order ID -->
    <form id="deposit-confirm-form" class="space-y-3">
      <div>
        <label class="text-xs font-bold text-slate-700 block mb-1">
          2. Enter your Binance Transaction ID / TxID:
        </label>
        <input type="text" id="deposit-txid-input" required placeholder="e.g. 298492019482 (Order ID in Binance Pay)" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs font-mono focus:ring-2 focus:ring-amber-400 focus:outline-none">
        <p class="text-[10px] text-slate-400 mt-1">
          Available in your Binance app history (Pay > Payment History).
        </p>
      </div>

      <div class="flex gap-2 pt-1">
        <button type="button" id="cancel-deposit-btn" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
          Close
        </button>
        <button type="submit" id="submit-deposit-btn" class="flex-2 w-2/3 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center justify-center gap-1.5">
          <i class="fa-solid fa-circle-check"></i>
          <span>Verify & Credit</span>
        </button>
      </div>
    </form>

  </div>
</div>

<!-- Withdrawal Request Modal -->
<div id="withdraw-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 toast-anim space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
        <i class="fa-solid fa-arrow-up-from-bracket text-emerald-600"></i> Request USDT Withdrawal
      </h3>
      <button id="close-withdraw-modal" class="text-slate-400 hover:text-slate-600 w-8 h-8 rounded-lg flex items-center justify-center transition">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs space-y-1">
      <div class="flex justify-between">
        <span class="text-slate-500">Available balance:</span>
        <span class="font-bold text-emerald-600"><%= user.walletBalance.toFixed(2) %> USDT</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Binance Pay ID:</span>
        <span class="font-bold text-slate-800"><%= user.binanceId || 'Not configured' %></span>
      </div>
    </div>

    <% if (!user.binanceId) { %>
      <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl text-xs text-amber-800 flex items-start gap-2">
        <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5"></i>
        <span>Please configure your <strong>Binance Pay ID</strong> first to enable withdrawals.</span>
      </div>
    <% } %>

    <form id="withdraw-form" class="space-y-4">
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="text-xs font-bold text-slate-700">Amount to withdraw (USDT):</label>
          <button type="button" id="withdraw-max-btn" class="text-[11px] font-bold text-emerald-600 hover:text-emerald-700">
            Withdraw all
          </button>
        </div>
        <div class="relative">
          <input type="number" id="withdraw-amount-input" step="0.01" min="1" max="<%= user.walletBalance %>" required placeholder="e.g. 50.00" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">USDT</span>
        </div>
      </div>

      <div class="text-[11px] text-slate-500">
        ⚡ Funds are transferred directly via the Binance Pay network upon automated processing.
      </div>

      <div class="flex gap-2">
        <button type="button" id="cancel-withdraw-btn" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
          Cancel
        </button>
        <button type="submit" id="submit-withdraw-btn" <%= !user.binanceId ? 'disabled' : '' %> class="flex-1 py-2.5 bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-bold text-xs rounded-xl shadow-md transition flex items-center justify-center gap-1.5">
          <span>Confirm Withdrawal</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- AJAX Scripts & Binance Pay -->
<script>
  // ==========================================
  // BINANCE PAY TOP-UP HANDLING
  // ==========================================
  const openDepositModalBtn = document.getElementById('open-deposit-modal-btn');
  const depositModal = document.getElementById('deposit-modal');
  const closeDepositModal = document.getElementById('close-deposit-modal');
  const cancelDepositBtn = document.getElementById('cancel-deposit-btn');
  const depositAmountInput = document.getElementById('deposit-amount-input');
  const depositAmountDisplay = document.getElementById('deposit-amount-display');
  const depositQrImage = document.getElementById('deposit-qr-image');
  const depositQrLoader = document.getElementById('deposit-qr-loader');
  const binanceAppPayBtn = document.getElementById('binance-app-pay-btn');
  const depositConfirmForm = document.getElementById('deposit-confirm-form');
  const depositTxidInput = document.getElementById('deposit-txid-input');
  const submitDepositBtn = document.getElementById('submit-deposit-btn');
  const copyBinanceIdBtn = document.getElementById('copy-binance-id-btn');
  const depositBinanceIdText = document.getElementById('deposit-binance-id-text');
  const quickAmtBtns = document.querySelectorAll('.quick-amt-btn');

  let qrDebounceTimeout = null;

  async function loadDepositQR(amount) {
    if (!depositQrImage) return;
    if (depositQrLoader) depositQrLoader.classList.remove('hidden');

    try {
      const amtVal = parseFloat(amount) || 50;
      const res = await fetch(`/api/wallet/deposit-qr?amount=${encodeURIComponent(amtVal)}`);
      const data = await res.json();
      
      if (data.success) {
        depositQrImage.src = data.qrCodeDataUrl;
        if (depositAmountDisplay) depositAmountDisplay.textContent = `${parseFloat(data.amount).toFixed(2)} USDT`;
        if (binanceAppPayBtn) {
          binanceAppPayBtn.href = data.deepLink;
        }
      }
    } catch (e) {
      console.warn("Error loading Binance QR Code:", e);
    } finally {
      if (depositQrLoader) depositQrLoader.classList.add('hidden');
    }
  }

  function openDepositModal() {
    if (depositModal) {
      depositModal.classList.remove('hidden');
      depositModal.classList.add('flex');
      loadDepositQR(depositAmountInput ? depositAmountInput.value : 50);
    }
  }

  function closeDepositModalFn() {
    if (depositModal) {
      depositModal.classList.add('hidden');
      depositModal.classList.remove('flex');
    }
  }

  if (openDepositModalBtn) openDepositModalBtn.addEventListener('click', openDepositModal);
  if (closeDepositModal) closeDepositModal.addEventListener('click', closeDepositModalFn);
  if (cancelDepositBtn) cancelDepositBtn.addEventListener('click', closeDepositModalFn);

  // Quick amount buttons
  quickAmtBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      quickAmtBtns.forEach(b => {
        b.classList.remove('active', 'border-2', 'border-amber-500', 'bg-amber-50', 'text-amber-900');
        b.classList.add('border-slate-200', 'text-slate-700');
      });
      btn.classList.add('active', 'border-2', 'border-amber-500', 'bg-amber-50', 'text-amber-900');
      btn.classList.remove('border-slate-200', 'text-slate-700');

      const amt = btn.getAttribute('data-amount');
      if (depositAmountInput) depositAmountInput.value = amt;
      loadDepositQR(amt);
    });
  });

  // Custom amount changes
  if (depositAmountInput) {
    depositAmountInput.addEventListener('input', (e) => {
      clearTimeout(qrDebounceTimeout);
      const val = parseFloat(e.target.value);
      if (!isNaN(val) && val > 0) {
        qrDebounceTimeout = setTimeout(() => {
          loadDepositQR(val);
        }, 350);
      }
    });
  }

  // 1-click Binance Pay ID copy
  if (copyBinanceIdBtn && depositBinanceIdText) {
    copyBinanceIdBtn.addEventListener('click', () => {
      const text = depositBinanceIdText.textContent.trim();
      navigator.clipboard.writeText(text).then(() => {
        copyBinanceIdBtn.innerHTML = '<i class="fa-solid fa-check text-emerald-400"></i> Copied!';
        setTimeout(() => {
          copyBinanceIdBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Copy';
        }, 2000);
      }).catch(() => {
        window.showToast('Binance ID copied: ' + text, 'info');
      });
    });
  }

  // Deposit confirmation submission
  if (depositConfirmForm) {
    depositConfirmForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const amount = parseFloat(depositAmountInput ? depositAmountInput.value : 0);
      const txId = (depositTxidInput ? depositTxidInput.value : '').trim();

      if (isNaN(amount) || amount <= 0) {
        window.showToast('Please specify a valid amount greater than 0.', 'error');
        return;
      }
      if (!txId) {
        window.showToast('Please enter your Binance transaction ID / TxID.', 'error');
        return;
      }

      submitDepositBtn.disabled = true;
      submitDepositBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Verifying payment...';

      try {
        const res = await fetch('/api/wallet/deposit-binance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, txId })
        });
        const data = await res.json();

        if (data.success) {
          window.showToast(data.message, 'success');
          const dashBal = document.getElementById('dash-wallet-balance');
          if (dashBal) dashBal.textContent = data.newWalletBalance.toFixed(2);
          const headerBal = document.getElementById('header-wallet-balance');
          if (headerBal) headerBal.textContent = data.newWalletBalance.toFixed(0);

          closeDepositModalFn();
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.showToast(data.error || 'Verification error', 'error');
        }
      } catch (err) {
        window.showToast('Network error during verification', 'error');
      } finally {
        submitDepositBtn.disabled = false;
        submitDepositBtn.innerHTML = '<i class="fa-solid fa-circle-check"></i> <span>Verify & Credit</span>';
      }
    });
  }

  // ==========================================
  // BINANCE PAY PROFILE CONFIGURATION
  // ==========================================
  const binanceForm = document.getElementById('binance-form');
  const binanceInput = document.getElementById('binanceId-input');
  const binanceSaveBtn = document.getElementById('binance-save-btn');

  if (binanceForm) {
    binanceForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      binanceSaveBtn.disabled = true;
      binanceSaveBtn.textContent = 'Saving...';
      try {
        const res = await fetch('/api/wallet/update-binance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ binanceId: binanceInput.value.trim() })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast('Binance Pay ID saved successfully!', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          window.showToast('Error saving Binance ID', 'error');
        }
      } catch (err) {
        window.showToast('Network error', 'error');
      } finally {
        binanceSaveBtn.disabled = false;
        binanceSaveBtn.textContent = 'Save Binance Pay ID';
      }
    });
  }

  // ==========================================
  // WITHDRAWAL MODAL HANDLING
  // ==========================================
  const openWithdrawBtn = document.getElementById('open-withdraw-btn');
  const withdrawModal = document.getElementById('withdraw-modal');
  const closeWithdrawModal = document.getElementById('close-withdraw-modal');
  const cancelWithdrawBtn = document.getElementById('cancel-withdraw-btn');
  const withdrawForm = document.getElementById('withdraw-form');
  const withdrawAmountInput = document.getElementById('withdraw-amount-input');
  const withdrawMaxBtn = document.getElementById('withdraw-max-btn');
  const submitWithdrawBtn = document.getElementById('submit-withdraw-btn');

  function openWithdrawModalFn() {
    if (withdrawModal) {
      withdrawModal.classList.remove('hidden');
      withdrawModal.classList.add('flex');
    }
  }

  function closeWithdrawModalFn() {
    if (withdrawModal) {
      withdrawModal.classList.add('hidden');
      withdrawModal.classList.remove('flex');
    }
  }

  if (openWithdrawBtn) openWithdrawBtn.addEventListener('click', openWithdrawModalFn);
  if (closeWithdrawModal) closeWithdrawModal.addEventListener('click', closeWithdrawModalFn);
  if (cancelWithdrawBtn) cancelWithdrawBtn.addEventListener('click', closeWithdrawModalFn);

  if (withdrawMaxBtn && withdrawAmountInput) {
    withdrawMaxBtn.addEventListener('click', () => {
      const currentBal = parseFloat(document.getElementById('dash-wallet-balance').textContent) || 0;
      withdrawAmountInput.value = currentBal.toFixed(2);
    });
  }

  if (withdrawForm) {
    withdrawForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const amount = parseFloat(withdrawAmountInput.value);
      if (isNaN(amount) || amount <= 0) {
        window.showToast('Invalid amount', 'error');
        return;
      }

      submitWithdrawBtn.disabled = true;
      submitWithdrawBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';

      try {
        const res = await fetch('/api/wallet/withdraw', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(data.message || 'Withdrawal requested successfully!', 'success');
          closeWithdrawModalFn();
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.showToast(data.error || 'Error during withdrawal', 'error');
        }
      } catch (err) {
        window.showToast('Network error', 'error');
      } finally {
        submitWithdrawBtn.disabled = false;
        submitWithdrawBtn.innerHTML = 'Confirm Withdrawal';
      }
    });
  }
</script>

<%- include('partials/footer') %>

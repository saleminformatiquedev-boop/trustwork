<%- include('partials/header', { title: 'Dashboard' }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">

  <!-- User Profile & Quick Demo Switch -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 sm:p-6 rounded-2xl border border-slate-200/90">
    <div class="flex items-center gap-3.5 min-w-0">
      <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + user.name %>" class="w-12 h-12 rounded-full border border-slate-200 object-cover flex-shrink-0">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h1 class="text-lg font-bold text-slate-900 truncate"><%= user.name %></h1>
          <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md <%= user.role === 'ADMIN' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600' %>">
            <%= user.role %>
          </span>
        </div>
        <p class="text-xs text-slate-400 truncate"><%= user.email %></p>
      </div>
    </div>

    <% if (typeof demoModeEnabled !== 'undefined' && demoModeEnabled) { %>
      <div class="flex items-center gap-1.5 text-xs">
        <span class="text-slate-400 mr-1 hidden sm:inline">Demo sandbox:</span>
        <a href="/auth/demo-login/buyer" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition">Buyer</a>
        <a href="/auth/demo-login/seller" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition">Seller</a>
        <a href="/auth/demo-login/admin" class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg transition">Admin</a>
      </div>
    <% } %>
  </div>

  <!-- Wallet & Escrow Summary -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    
    <!-- Available Balance -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl flex flex-col justify-between">
      <div>
        <span class="text-xs text-slate-400 font-medium">Available Balance</span>
        <div class="text-3xl font-extrabold mt-1">
          <span id="dash-wallet-balance"><%= user.walletBalance.toFixed(2) %></span> <span class="text-sm font-semibold text-slate-400">USD</span>
        </div>
      </div>

      <div class="mt-6 flex gap-2">
        <button id="open-deposit-modal-btn" class="flex-1 py-2.5 px-3 bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-bold rounded-xl transition">
          + Top Up
        </button>
        <button id="open-withdraw-btn" class="flex-1 py-2.5 px-3 bg-white/10 hover:bg-white/15 text-white text-xs font-semibold rounded-xl transition">
          Withdraw
        </button>
      </div>
    </div>

      <!-- In Escrow / Admin Commission -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/90 flex flex-col justify-between">
        <% if (user.role === 'ADMIN') { %>
          <div>
            <span class="text-xs text-emerald-700 font-semibold">Admin Commission Earned (15%)</span>
            <div class="text-3xl font-extrabold text-emerald-600 mt-1">
              <span><%= (typeof totalAdminCommission !== 'undefined' ? totalAdminCommission : 0).toFixed(2) %></span> <span class="text-sm font-semibold text-slate-400">USD</span>
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-4 flex items-center gap-1.5">
            <i class="fa-solid fa-percent text-emerald-600"></i> 15% automatically collected on every completed order
          </p>
        <% } else { %>
          <div>
            <span class="text-xs text-slate-400 font-medium">In Escrow (Active Orders)</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1">
              <span id="dash-escrow-balance"><%= user.escrowBalance.toFixed(2) %></span> <span class="text-sm font-semibold text-slate-400">USD</span>
            </div>
          </div>
          <p class="text-xs text-slate-400 mt-4 flex items-center gap-1.5">
            <i class="fa-solid fa-lock text-emerald-600"></i> Released upon buyer approval (85% net to author, 15% fee)
          </p>
        <% } %>
      </div>

    <!-- Payout details -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/90 flex flex-col justify-between">
      <div>
        <span class="text-xs text-slate-400 font-medium block mb-1">Payout details (IBAN / PayPal / Fragment)</span>
        <p class="text-[11px] text-slate-500 mb-2 leading-relaxed">Payouts are processed manually by the admin. Telegram Stars cannot be transferred directly to users, so payouts are sent through your chosen method.</p>
        <form id="payout-form" class="mt-2 space-y-2">
          <input type="text" id="payout-input" name="payoutDetails" value="<%= user.binanceId || '' %>" placeholder="IBAN, PayPal email, Fragment username..." class="w-full text-xs px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl text-slate-900 focus:bg-white focus:border-slate-900 focus:outline-none">
          <button type="submit" id="payout-save-btn" class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs rounded-xl transition">
            Save Payout Details
          </button>
        </form>
      </div>
    </div>

  </div>

  <!-- Tabbed Lists (Purchases / Sales / Wallet History) -->
  <div class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden">
    
    <div class="px-5 pt-4 border-b border-slate-100 flex items-center gap-6 text-xs sm:text-sm font-semibold overflow-x-auto">
      <button type="button" class="dash-tab border-b-2 border-slate-900 text-slate-900 pb-3 transition whitespace-nowrap" data-tab="tab-purchases">
        My Purchases (<%= buyerOrders.length %>)
      </button>
      <button type="button" class="dash-tab border-b-2 border-transparent text-slate-400 hover:text-slate-700 pb-3 transition whitespace-nowrap" data-tab="tab-sales">
        My Sales (<%= sellerOrders.length %>)
      </button>
      <button type="button" class="dash-tab border-b-2 border-transparent text-slate-400 hover:text-slate-700 pb-3 transition whitespace-nowrap" data-tab="tab-wallet">
        Deposits & Withdrawals (<%= (typeof deposits !== 'undefined' ? deposits.length : 0) + (typeof withdrawals !== 'undefined' ? withdrawals.length : 0) %>)
      </button>
    </div>

    <!-- Tab 1: My Purchases -->
    <div id="tab-purchases" class="dash-panel divide-y divide-slate-100">
      <% if (buyerOrders && buyerOrders.length > 0) { %>
        <% buyerOrders.forEach(ord => { %>
          <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between gap-4 hover:bg-slate-50/80 transition block">
            <div class="min-w-0">
              <div class="text-xs text-slate-400 mb-0.5">Author: <%= ord.sellerName %></div>
              <h4 class="text-sm font-bold text-slate-900 truncate"><%= ord.serviceTitle %></h4>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <span class="text-xs font-bold text-slate-900"><%= ord.amount.toFixed(2) %> USD</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : (ord.status === 'DISPUTED' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700') %>">
                <%= ord.status === 'COMPLETED' ? 'Completed' : (ord.status === 'DELIVERED' ? 'Ready to review' : (ord.status === 'DISPUTED' ? 'Disputed' : 'In Escrow')) %>
              </span>
              <i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12 text-slate-400 text-xs">
          No purchased methods yet. <a href="/" class="text-slate-900 font-semibold underline ml-1">Browse catalog</a>
        </div>
      <% } %>
    </div>

    <!-- Tab 2: My Sales -->
    <div id="tab-sales" class="dash-panel hidden divide-y divide-slate-100">
      <% if (sellerOrders && sellerOrders.length > 0) { %>
        <% sellerOrders.forEach(ord => { %>
          <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between gap-4 hover:bg-slate-50/80 transition block">
            <div class="min-w-0">
              <div class="text-xs text-slate-400 mb-0.5">Buyer: <%= ord.buyerName %></div>
              <h4 class="text-sm font-bold text-slate-900 truncate"><%= ord.serviceTitle %></h4>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <div class="text-right">
                <span class="text-xs font-bold text-emerald-600 block">+<%= (ord.sellerNetAmount || (ord.amount * 0.85)).toFixed(2) %> USD net</span>
                <span class="text-[10px] text-slate-400">Gross: <%= ord.amount.toFixed(2) %> (15% fee)</span>
              </div>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : (ord.status === 'DISPUTED' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700') %>">
                <%= ord.status === 'COMPLETED' ? 'Paid (85%)' : (ord.status === 'DELIVERED' ? 'Delivered' : (ord.status === 'DISPUTED' ? 'Disputed' : 'In Escrow')) %>
              </span>
              <i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12 text-slate-400 text-xs">
          No sales yet. <a href="/services/new" class="text-slate-900 font-semibold underline ml-1">Publish a method</a>
        </div>
      <% } %>
    </div>

    <!-- Tab 3: Deposits & Withdrawals -->
    <div id="tab-wallet" class="dash-panel hidden divide-y divide-slate-100">
      <% const allTx = [
           ...(typeof deposits !== 'undefined' ? deposits.map(d => ({ ...d, txType: 'DEPOSIT' })) : []),
           ...(typeof withdrawals !== 'undefined' ? withdrawals.map(w => ({ ...w, txType: 'WITHDRAW' })) : [])
         ]; %>
      <% if (allTx.length > 0) { %>
        <% allTx.forEach(tx => { %>
          <div class="p-5 flex items-center justify-between gap-4">
            <div>
              <div class="text-xs font-bold text-slate-900">
                <%= tx.txType === 'DEPOSIT' ? 'Telegram Stars Top-Up' : 'Manual Payout' %>
              </div>
              <div class="text-[11px] text-slate-400">
                <%= new Date(tx.createdAt).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </div>
            </div>
            <div class="text-right">
              <div class="text-xs font-bold <%= tx.txType === 'DEPOSIT' ? 'text-emerald-600' : 'text-slate-900' %>">
                <%= tx.txType === 'DEPOSIT' ? '+' : '-' %><%= tx.amount.toFixed(2) %> USD
              </div>
              <span class="text-[10px] font-semibold <%= tx.status === 'COMPLETED' ? 'text-emerald-600' : (tx.status === 'REJECTED' ? 'text-rose-600' : 'text-amber-600') %>">
                <%= tx.status === 'COMPLETED' ? 'Completed' : (tx.status === 'REJECTED' ? 'Rejected' : 'Pending Verification') %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-12 text-slate-400 text-xs">
          No deposit or withdrawal transactions yet.
        </div>
      <% } %>
    </div>

  </div>

</div>

<!-- Telegram Stars Top-Up Modal -->
<div id="deposit-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4 overflow-y-auto">
  <div class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-xl border border-slate-200 toast-anim space-y-4 my-auto">

    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div>
        <h3 class="font-bold text-slate-900 text-base">
          <i class="fa-solid fa-star text-amber-500 mr-1"></i> Top Up with Telegram Stars
        </h3>
        <p class="text-[11px] text-slate-400 mt-0.5">Secure XTR invoice — credited automatically after payment.</p>
      </div>
      <button id="close-deposit-modal" class="text-slate-400 hover:text-slate-700 w-8 h-8 flex items-center justify-center">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs font-medium text-slate-600">
        <span>Amount to add (USD)</span>
        <span class="font-bold text-slate-900" id="deposit-amount-display">50.00 USD</span>
      </div>
      <div class="grid grid-cols-4 gap-2">
        <button type="button" data-amount="1" class="quick-amt-btn py-2 text-xs font-semibold rounded-xl border border-slate-200 hover:border-slate-900 text-slate-700 transition">$1</button>
        <button type="button" data-amount="5" class="quick-amt-btn py-2 text-xs font-semibold rounded-xl border border-slate-200 hover:border-slate-900 text-slate-700 transition">$5</button>
        <button type="button" data-amount="10" class="quick-amt-btn py-2 text-xs font-semibold rounded-xl border border-slate-200 hover:border-slate-900 text-slate-700 transition">$10</button>
        <button type="button" data-amount="50" class="quick-amt-btn active py-2 text-xs font-semibold rounded-xl border-2 border-slate-900 bg-slate-900 text-white transition">$50</button>
      </div>
      <input type="number" id="deposit-amount-input" step="0.01" min="0.5" value="50" placeholder="Custom amount (min $0.50)..." class="w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs font-semibold focus:border-slate-900 focus:outline-none">
    </div>

    <div class="bg-sky-50/70 border border-sky-200 rounded-xl p-4 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="text-slate-600">You will pay</span>
        <span class="font-extrabold text-amber-700 text-sm" id="deposit-stars-display">⭐ 3,850 Stars</span>
      </div>
      <div class="flex items-center justify-between text-[11px] text-slate-500">
        <span>Conversion rate</span>
        <span><%= typeof starsPerUsd !== 'undefined' ? starsPerUsd : 77 %> Stars = $1 USD</span>
      </div>
      <p class="text-[11px] text-slate-500 leading-relaxed border-t border-sky-200/70 pt-2">
        Telegram opens the official Stars invoice. Stars can be purchased inside Telegram with your card, Apple Pay, Google Pay, or Telegram Premium balance.
      </p>
    </div>

    <div id="deposit-status-box" class="hidden p-3 rounded-xl text-[11px] leading-relaxed"></div>

    <div class="flex gap-2">
      <button type="button" id="cancel-deposit-btn" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition">Cancel</button>
      <button type="button" id="submit-deposit-btn" class="flex-1 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold text-xs rounded-xl transition flex items-center justify-center gap-1.5">
        <i class="fa-solid fa-star text-amber-300"></i>
        <span>Pay with Stars</span>
      </button>
    </div>

  </div>
</div>

<!-- Request Payout Modal -->
<div id="withdraw-modal" class="fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200 toast-anim space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <div>
        <h3 class="font-bold text-slate-900 text-base">Request a Payout</h3>
        <p class="text-[11px] text-slate-400 mt-0.5">Processed manually by the admin.</p>
      </div>
      <button id="close-withdraw-modal" class="text-slate-400 hover:text-slate-700 w-8 h-8 flex items-center justify-center">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="bg-[#FAFAFA] p-3.5 rounded-xl border border-slate-200 text-xs space-y-1.5">
      <div class="flex justify-between">
        <span class="text-slate-500">Available balance:</span>
        <span class="font-bold text-slate-900"><%= user.walletBalance.toFixed(2) %> USD</span>
      </div>
      <div class="flex justify-between gap-3">
        <span class="text-slate-500 shrink-0">Payout details:</span>
        <span class="font-semibold text-slate-800 truncate text-right"><%= user.binanceId || 'Not configured' %></span>
      </div>
    </div>

    <p class="text-[11px] text-slate-500 leading-relaxed">
      Telegram Stars cannot be transferred directly between users. Payouts are sent manually by the admin via your saved method (bank transfer, PayPal, Fragment, etc.).
    </p>

    <form id="withdraw-form" class="space-y-4">
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="text-xs font-medium text-slate-600">Amount to withdraw (USD)</label>
          <button type="button" id="withdraw-max-btn" class="text-xs font-semibold text-emerald-600 hover:underline">Max</button>
        </div>
        <input type="number" id="withdraw-amount-input" step="0.01" min="1" max="<%= user.walletBalance > 1 ? user.walletBalance : 1 %>" required placeholder="10.00" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs font-semibold focus:border-slate-900 focus:outline-none">
      </div>

      <div class="flex gap-2">
        <button type="button" id="cancel-withdraw-btn" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition">Cancel</button>
        <button type="submit" id="submit-withdraw-btn" <%= !user.binanceId ? 'disabled' : '' %> class="flex-1 py-2.5 bg-slate-900 hover:bg-slate-800 disabled:bg-slate-200 disabled:text-slate-400 text-white font-semibold text-xs rounded-xl transition">Request Payout</button>
      </div>
    </form>
  </div>
</div>

<script>
  const STARS_PER_USD = <%- JSON.stringify(typeof starsPerUsd !== 'undefined' ? starsPerUsd : 77) %>;
  const TELEGRAM_STARS_CONFIGURED = <%- JSON.stringify(typeof telegramStarsConfigured !== 'undefined' ? telegramStarsConfigured : false) %>;

  const dashTabs = document.querySelectorAll('.dash-tab');
  const dashPanels = document.querySelectorAll('.dash-panel');
  dashTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      dashTabs.forEach(t => {
        t.classList.remove('border-slate-900', 'text-slate-900');
        t.classList.add('border-transparent', 'text-slate-400');
      });
      tab.classList.add('border-slate-900', 'text-slate-900');
      tab.classList.remove('border-transparent', 'text-slate-400');
      dashPanels.forEach(p => p.classList.toggle('hidden', p.id !== tab.dataset.tab));
    });
  });

  function starsFromUsd(usd) {
    const value = Number(usd);
    if (!Number.isFinite(value) || value <= 0) return 0;
    return Math.max(1, Math.ceil(value * STARS_PER_USD));
  }

  const openDepositModalBtn = document.getElementById('open-deposit-modal-btn');
  const depositModal = document.getElementById('deposit-modal');
  const closeDepositModal = document.getElementById('close-deposit-modal');
  const cancelDepositBtn = document.getElementById('cancel-deposit-btn');
  const depositAmountInput = document.getElementById('deposit-amount-input');
  const depositAmountDisplay = document.getElementById('deposit-amount-display');
  const depositStarsDisplay = document.getElementById('deposit-stars-display');
  const depositStatusBox = document.getElementById('deposit-status-box');
  const submitDepositBtn = document.getElementById('submit-deposit-btn');
  const quickAmtBtns = document.querySelectorAll('.quick-amt-btn');
  let topupPollTimer = null;

  function renderDepositEstimate() {
    const amount = parseFloat(depositAmountInput ? depositAmountInput.value : 50) || 0;
    const stars = starsFromUsd(amount);
    if (depositAmountDisplay) depositAmountDisplay.textContent = `${amount.toFixed(2)} USD`;
    if (depositStarsDisplay) depositStarsDisplay.textContent = `⭐ ${stars.toLocaleString('en-US')} Stars`;
    return stars;
  }

  function showDepositStatus(message, tone) {
    if (!depositStatusBox) return;
    depositStatusBox.classList.remove('hidden');
    depositStatusBox.textContent = message;
    depositStatusBox.className = `p-3 rounded-xl text-[11px] leading-relaxed ${
      tone === 'success'
        ? 'bg-emerald-50 border border-emerald-200 text-emerald-800'
        : (tone === 'error' ? 'bg-rose-50 border border-rose-200 text-rose-700' : 'bg-sky-50 border border-sky-200 text-sky-800')
    }`;
  }

  function openDepositModal() {
    depositModal.classList.remove('hidden');
    depositModal.classList.add('flex');
    renderDepositEstimate();
  }
  function closeDepositModalFn() {
    depositModal.classList.add('hidden');
    depositModal.classList.remove('flex');
    if (topupPollTimer) {
      clearInterval(topupPollTimer);
      topupPollTimer = null;
    }
  }

  function pollTopupStatus(invoiceId) {
    if (topupPollTimer) clearInterval(topupPollTimer);
    const startedAt = Date.now();

    const tick = async () => {
      if (Date.now() - startedAt > 10 * 60 * 1000) {
        clearInterval(topupPollTimer);
        topupPollTimer = null;
        showDepositStatus('Still waiting for Telegram. You can close this window and check your balance later.', 'pending');
        return;
      }
      try {
        const res = await fetch(`/api/wallet/topup/${encodeURIComponent(invoiceId)}/status`);
        const data = await res.json();
        if (!data.success || !data.invoice) return;

        if (data.invoice.status === 'PAID') {
          clearInterval(topupPollTimer);
          topupPollTimer = null;
          showDepositStatus(`✅ Payment confirmed — +$${parseFloat(data.invoice.amount).toFixed(2)} credited to your wallet (${data.invoice.stars} Stars).`, 'success');
          if (window.showToast) window.showToast('Wallet topped up with Telegram Stars!', 'success');
          setTimeout(() => window.location.reload(), 1200);
        } else if (data.invoice.status === 'FAILED' || data.invoice.status === 'REFUNDED') {
          clearInterval(topupPollTimer);
          topupPollTimer = null;
          showDepositStatus(`Invoice status: ${data.invoice.status}. Please create a new top-up.`, 'error');
        } else {
          showDepositStatus('⏳ Waiting for Telegram payment confirmation...', 'pending');
        }
      } catch (_) {}
    };

    tick();
    topupPollTimer = setInterval(tick, 3000);
  }

  if (openDepositModalBtn) openDepositModalBtn.addEventListener('click', openDepositModal);
  if (closeDepositModal) closeDepositModal.addEventListener('click', closeDepositModalFn);
  if (cancelDepositBtn) cancelDepositBtn.addEventListener('click', closeDepositModalFn);

  quickAmtBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      quickAmtBtns.forEach(b => {
        b.classList.remove('border-2', 'border-slate-900', 'bg-slate-900', 'text-white');
        b.classList.add('border-slate-200', 'text-slate-700');
      });
      btn.classList.add('border-2', 'border-slate-900', 'bg-slate-900', 'text-white');
      btn.classList.remove('border-slate-200', 'text-slate-700');
      if (depositAmountInput) depositAmountInput.value = btn.getAttribute('data-amount');
      renderDepositEstimate();
    });
  });

  if (depositAmountInput) {
    depositAmountInput.addEventListener('input', renderDepositEstimate);
  }

  if (submitDepositBtn) {
    submitDepositBtn.addEventListener('click', async () => {
      if (!TELEGRAM_STARS_CONFIGURED) {
        showDepositStatus('Telegram Stars is not configured on this server yet. Please contact @Melasbit.', 'error');
        return;
      }

      const amount = parseFloat(depositAmountInput.value);
      if (!Number.isFinite(amount) || amount < 0.5 || amount > 50000) {
        showDepositStatus('Please enter an amount between $0.50 and $50,000.', 'error');
        return;
      }

      const original = submitDepositBtn.innerHTML;
      submitDepositBtn.disabled = true;
      submitDepositBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating invoice...';

      try {
        const res = await fetch('/api/wallet/topup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        });
        const data = await res.json();
        if (!data.success) {
          showDepositStatus(data.error || 'Unable to create the top-up invoice.', 'error');
          return;
        }

        showDepositStatus(`Invoice created: ${data.stars} Stars for $${data.amount.toFixed(2)}. Approve it in Telegram — this window updates automatically.`, 'pending');

        if (depositStatusBox) {
          const link = document.createElement('a');
          link.href = data.invoiceLink;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.className = 'block mt-1 font-bold underline text-sky-700';
          link.textContent = 'Open the Telegram Stars invoice →';
          depositStatusBox.appendChild(link);
        }

        try { window.open(data.invoiceLink, '_blank', 'noopener'); } catch (_) {}
        pollTopupStatus(data.invoiceId);
      } catch (err) {
        showDepositStatus('Network error. Please try again.', 'error');
      } finally {
        submitDepositBtn.disabled = false;
        submitDepositBtn.innerHTML = original;
      }
    });
  }

  const payoutForm = document.getElementById('payout-form');
  const payoutInput = document.getElementById('payout-input');
  const payoutSaveBtn = document.getElementById('payout-save-btn');
  if (payoutForm) {
    payoutForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      payoutSaveBtn.disabled = true;
      try {
        const res = await fetch('/api/wallet/update-payout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ payoutDetails: payoutInput.value.trim() })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast('Payout details saved', 'success');
          setTimeout(() => window.location.reload(), 800);
        } else {
          window.showToast(data.error || 'Unable to save payout details', 'error');
        }
      } catch (_) {
        window.showToast('Network error', 'error');
      } finally {
        payoutSaveBtn.disabled = false;
      }
    });
  }

  const openWithdrawBtn = document.getElementById('open-withdraw-btn');
  const withdrawModal = document.getElementById('withdraw-modal');
  const closeWithdrawModal = document.getElementById('close-withdraw-modal');
  const cancelWithdrawBtn = document.getElementById('cancel-withdraw-btn');
  const withdrawForm = document.getElementById('withdraw-form');
  const withdrawAmountInput = document.getElementById('withdraw-amount-input');
  const withdrawMaxBtn = document.getElementById('withdraw-max-btn');
  const submitWithdrawBtn = document.getElementById('submit-withdraw-btn');

  function closeWithdrawModalFn() {
    withdrawModal.classList.add('hidden');
    withdrawModal.classList.remove('flex');
  }
  if (openWithdrawBtn) openWithdrawBtn.addEventListener('click', () => {
    withdrawModal.classList.remove('hidden');
    withdrawModal.classList.add('flex');
  });
  if (closeWithdrawModal) closeWithdrawModal.addEventListener('click', closeWithdrawModalFn);
  if (cancelWithdrawBtn) cancelWithdrawBtn.addEventListener('click', closeWithdrawModalFn);

  if (withdrawMaxBtn && withdrawAmountInput) {
    withdrawMaxBtn.addEventListener('click', () => {
      const currentBal = parseFloat(document.getElementById('dash-wallet-balance').textContent) || 0;
      withdrawAmountInput.value = currentBal.toFixed(2);
    });
  }

  if (withdrawForm) {
    withdrawForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const amount = parseFloat(withdrawAmountInput.value);
      if (!amount || amount < 1) {
        window.showToast('Minimum payout is $1.00', 'error');
        return;
      }
      submitWithdrawBtn.disabled = true;
      submitWithdrawBtn.textContent = 'Submitting...';
      try {
        const res = await fetch('/api/wallet/withdraw', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(data.message || 'Payout request submitted', 'success');
          closeWithdrawModalFn();
          setTimeout(() => window.location.reload(), 900);
        } else {
          window.showToast(data.error || 'Error', 'error');
        }
      } catch (_) {
        window.showToast('Network error', 'error');
      } finally {
        submitWithdrawBtn.disabled = false;
        submitWithdrawBtn.textContent = 'Request Payout';
      }
    });
  }
</script>

<%- include('partials/footer') %>

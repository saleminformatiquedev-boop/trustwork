<%- include('partials/header', { title: 'Tableau de bord' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">

  <!-- Header utilisateur & Switch rapide pour test -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
    <div class="flex items-center gap-4">
      <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + user.name %>" class="w-14 h-14 rounded-2xl border border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-xl font-bold text-slate-900"><%= user.name %></h1>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full <%= user.role === 'ADMIN' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700' %>">
            <%= user.role %>
          </span>
        </div>
        <p class="text-xs text-slate-500"><%= user.email %></p>
      </div>
    </div>

    <!-- Sélecteur rapide de profil de test -->
    <div class="flex items-center gap-2 text-xs bg-slate-50 p-2 rounded-xl border border-slate-200">
      <span class="text-slate-500 font-semibold pl-1">Tester un autre rôle :</span>
      <a href="/auth/demo-login/buyer" class="px-2.5 py-1 bg-white border border-slate-200 hover:border-blue-400 text-blue-700 font-medium rounded-lg transition">Acheteur</a>
      <a href="/auth/demo-login/seller" class="px-2.5 py-1 bg-white border border-slate-200 hover:border-purple-400 text-purple-700 font-medium rounded-lg transition">Vendeur</a>
      <a href="/auth/demo-login/admin" class="px-2.5 py-1 bg-white border border-slate-200 hover:border-amber-400 text-amber-700 font-medium rounded-lg transition">Admin</a>
    </div>
  </div>

  <!-- Cartes Portefeuille Binance & Escrow Dynamiques -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    
    <!-- Solde Disponible -->
    <div class="bg-gradient-to-br from-emerald-600 to-emerald-700 text-white p-6 rounded-2xl shadow-md flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-emerald-100 text-xs font-semibold mb-2">
          <span>Solde Disponible (USDT)</span>
          <i class="fa-solid fa-wallet text-base"></i>
        </div>
        <div class="text-3xl font-black">
          <span id="dash-wallet-balance"><%= user.walletBalance.toFixed(2) %></span> <span class="text-lg font-bold">USDT</span>
        </div>
        <p class="text-[11px] text-emerald-100 mt-2">Prêt pour commander ou retirer sur Binance.</p>
      </div>

      <div class="mt-6 pt-4 border-t border-emerald-500/50 flex gap-2">
        <button id="deposit-btn" class="px-3 py-1.5 bg-white text-emerald-800 text-xs font-bold rounded-lg hover:bg-emerald-50 transition flex items-center gap-1.5">
          <i class="fa-solid fa-plus"></i> Recharger +50 USDT (Test direct)
        </button>
      </div>
    </div>

    <!-- Solde Sous Séquestre -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-500 text-xs font-semibold mb-2">
          <span>Argent Sous Séquestre (Escrow)</span>
          <i class="fa-solid fa-lock text-amber-500 text-base"></i>
        </div>
        <div class="text-3xl font-black text-slate-900">
          <span id="dash-escrow-balance"><%= user.escrowBalance.toFixed(2) %></span> <span class="text-lg font-bold text-slate-400">USDT</span>
        </div>
        <p class="text-[11px] text-slate-500 mt-2">
          Fonds bloqués dans des commandes en attente de livraison ou de validation.
        </p>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-400 flex items-center gap-1.5">
        <i class="fa-solid fa-shield-halved text-emerald-600"></i> Protection garantie
      </div>
    </div>

    <!-- Intégration Binance Pay Dynamique -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-amber-400 text-xs font-bold mb-2">
          <span class="flex items-center gap-1.5">
            <i class="fa-brands fa-bitcoin"></i> Binance Pay
          </span>
          <span class="bg-amber-400/20 text-amber-300 text-[10px] px-2 py-0.5 rounded-full">Actif</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed mb-3">
          Configurez votre Binance Pay ID pour recevoir vos paiements directement sur votre compte Binance.
        </p>
        <form id="binance-form" class="space-y-2">
          <input type="text" id="binanceId-input" name="binanceId" value="<%= user.binanceId || '' %>" placeholder="Votre Binance Pay ID (ex: 123456789)" class="w-full text-xs px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-amber-400">
          <button type="submit" id="binance-save-btn" class="w-full py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-lg transition">
            Enregistrer mon Binance ID
          </button>
        </form>
      </div>
    </div>

  </div>

  <!-- Commandes Achat / Vente -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    <!-- Mes Commandes (En tant qu'Acheteur) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-base flex items-center gap-2">
          <i class="fa-solid fa-cart-shopping text-emerald-600"></i> Mes Achats
        </h2>
        <span class="text-xs text-slate-500"><%= buyerOrders.length %> commande(s)</span>
      </div>

      <div class="divide-y divide-slate-100">
        <% if (buyerOrders && buyerOrders.length > 0) { %>
          <% buyerOrders.forEach(ord => { %>
            <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between hover:bg-slate-50 transition block">
              <div class="space-y-1">
                <span class="text-[11px] font-bold text-slate-400">#<%= ord.id %> • <%= ord.sellerName %></span>
                <h4 class="text-sm font-bold text-slate-800"><%= ord.serviceTitle %></h4>
                <div class="text-xs text-slate-500"><%= ord.amount.toFixed(2) %> USDT sous séquestre</div>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (ord.status === 'DELIVERED' ? 'bg-amber-100 text-amber-800' : (ord.status === 'DISPUTED' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800')) %>">
                  <%= ord.status %>
                </span>
                <span class="block text-[11px] text-slate-400 mt-1">Détails <i class="fa-solid fa-chevron-right text-[9px]"></i></span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="text-center py-10 text-slate-400 text-xs">
            Vous n'avez pas encore passé de commande.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Mes Ventes (En tant que Travailleur) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-base flex items-center gap-2">
          <i class="fa-solid fa-briefcase text-blue-600"></i> Mes Ventes (Prestations)
        </h2>
        <span class="text-xs text-slate-500"><%= sellerOrders.length %> mission(s)</span>
      </div>

      <div class="divide-y divide-slate-100">
        <% if (sellerOrders && sellerOrders.length > 0) { %>
          <% sellerOrders.forEach(ord => { %>
            <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between hover:bg-slate-50 transition block">
              <div class="space-y-1">
                <span class="text-[11px] font-bold text-slate-400">#<%= ord.id %> • Acheteur : <%= ord.buyerName %></span>
                <h4 class="text-sm font-bold text-slate-800"><%= ord.serviceTitle %></h4>
                <div class="text-xs text-emerald-600 font-semibold">+<%= ord.amount.toFixed(2) %> USDT à recevoir</div>
              </div>
              <div class="text-right">
                <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (ord.status === 'DELIVERED' ? 'bg-amber-100 text-amber-800' : (ord.status === 'DISPUTED' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800')) %>">
                  <%= ord.status %>
                </span>
                <span class="block text-[11px] text-slate-400 mt-1">Voir <i class="fa-solid fa-chevron-right text-[9px]"></i></span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="text-center py-10 text-slate-400 text-xs">
            Aucune commande reçue pour vos services pour le moment.
          </div>
        <% } %>
      </div>
    </div>

  </div>

</div>

<!-- Script interactif AJAX sans rechargement de page -->
<script>
  // Recharge rapide USDT en AJAX
  const depositBtn = document.getElementById('deposit-btn');
  if (depositBtn) {
    depositBtn.addEventListener('click', async () => {
      depositBtn.disabled = true;
      depositBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Rechargement...';
      try {
        const res = await fetch('/api/wallet/deposit-test', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          document.getElementById('dash-wallet-balance').textContent = data.newWalletBalance.toFixed(2);
          const headerWallet = document.getElementById('header-wallet-balance');
          if (headerWallet) headerWallet.textContent = data.newWalletBalance.toFixed(2);
          window.showToast('+50 USDT crédités avec succès !', 'success');
        } else {
          window.showToast(data.error || 'Erreur lors du dépôt', 'error');
        }
      } catch (err) {
        window.showToast('Erreur réseau', 'error');
      } finally {
        depositBtn.disabled = false;
        depositBtn.innerHTML = '<i class="fa-solid fa-plus"></i> Recharger +50 USDT (Test direct)';
      }
    });
  }

  // Enregistrement Binance ID en AJAX
  const binanceForm = document.getElementById('binance-form');
  const binanceInput = document.getElementById('binanceId-input');
  const binanceSaveBtn = document.getElementById('binance-save-btn');

  if (binanceForm) {
    binanceForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      binanceSaveBtn.disabled = true;
      binanceSaveBtn.textContent = 'Enregistrement...';
      try {
        const res = await fetch('/api/wallet/update-binance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ binanceId: binanceInput.value.trim() })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast('Binance Pay ID enregistré avec succès !', 'success');
        } else {
          window.showToast('Erreur lors de la mise à jour', 'error');
        }
      } catch (err) {
        window.showToast('Erreur réseau', 'error');
      } finally {
        binanceSaveBtn.disabled = false;
        binanceSaveBtn.textContent = 'Enregistrer mon Binance ID';
      }
    });
  }
</script>

<%- include('partials/footer') %>

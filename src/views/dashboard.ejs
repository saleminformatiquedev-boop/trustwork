<%- include('partials/header', { title: 'Tableau de bord' }) %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-6 sm:space-y-8">

  <!-- Header utilisateur & Switch rapide pour test -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm">
    <div class="flex items-center gap-3.5 sm:gap-4">
      <img src="<%= user.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + user.name %>" class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl border border-slate-200 flex-shrink-0 object-cover">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h1 class="text-lg sm:text-xl font-bold text-slate-900 truncate"><%= user.name %></h1>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full flex-shrink-0 <%= user.role === 'ADMIN' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700' %>">
            <%= user.role %>
          </span>
        </div>
        <p class="text-xs text-slate-500 truncate"><%= user.email %></p>
      </div>
    </div>

    <!-- Sélecteur rapide de profil de test (Responsive mobile) -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 text-xs bg-slate-50 p-2 rounded-xl border border-slate-200">
      <span class="text-slate-500 font-semibold pl-1 text-[11px] sm:text-xs">Changer de rôle test :</span>
      <div class="grid grid-cols-3 sm:flex gap-1.5">
        <a href="/auth/demo-login/buyer" class="text-center px-2.5 py-1 bg-white border border-slate-200 hover:border-blue-400 text-blue-700 font-medium rounded-lg text-[11px] transition">Acheteur</a>
        <a href="/auth/demo-login/seller" class="text-center px-2.5 py-1 bg-white border border-slate-200 hover:border-purple-400 text-purple-700 font-medium rounded-lg text-[11px] transition">Vendeur</a>
        <a href="/auth/demo-login/admin" class="text-center px-2.5 py-1 bg-white border border-slate-200 hover:border-amber-400 text-amber-700 font-medium rounded-lg text-[11px] transition">Admin</a>
      </div>
    </div>
  </div>

  <!-- Cartes Portefeuille Binance & Escrow (Adaptatif Mobile/Desktop) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    
    <!-- Solde Disponible -->
    <div class="bg-gradient-to-br from-emerald-600 to-emerald-700 text-white p-5 sm:p-6 rounded-2xl shadow-md flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-emerald-100 text-xs font-semibold mb-2">
          <span>Solde Disponible (USDT)</span>
          <i class="fa-solid fa-wallet text-base"></i>
        </div>
        <div class="text-2xl sm:text-3xl font-black">
          <span id="dash-wallet-balance"><%= user.walletBalance.toFixed(2) %></span> <span class="text-base sm:text-lg font-bold">USDT</span>
        </div>
        <p class="text-[11px] text-emerald-100 mt-2">Prêt pour commander ou retirer sur Binance.</p>
      </div>

      <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-emerald-500/50 flex flex-wrap gap-2">
        <button id="deposit-btn" class="flex-1 min-w-[120px] px-3 py-2 bg-white text-emerald-800 text-xs font-bold rounded-lg hover:bg-emerald-50 transition flex items-center justify-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-plus text-[10px]"></i> +50 USDT Test
        </button>
        <button id="open-withdraw-btn" class="flex-1 min-w-[120px] px-3 py-2 bg-emerald-800/90 hover:bg-emerald-900 text-white text-xs font-bold rounded-lg transition flex items-center justify-center gap-1.5 border border-emerald-400/40 shadow-sm">
          <i class="fa-solid fa-arrow-up-from-bracket text-[10px]"></i> Retirer USDT
        </button>
      </div>
    </div>

    <!-- Solde Sous Séquestre -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-slate-500 text-xs font-semibold mb-2">
          <span>Argent Sous Séquestre (Escrow)</span>
          <i class="fa-solid fa-lock text-amber-500 text-base"></i>
        </div>
        <div class="text-2xl sm:text-3xl font-black text-slate-900">
          <span id="dash-escrow-balance"><%= user.escrowBalance.toFixed(2) %></span> <span class="text-base sm:text-lg font-bold text-slate-400">USDT</span>
        </div>
        <p class="text-[11px] text-slate-500 mt-2">
          Fonds bloqués dans des commandes en attente de livraison ou de validation.
        </p>
      </div>

      <div class="mt-4 sm:mt-6 pt-3 sm:pt-4 border-t border-slate-100 text-[11px] sm:text-xs text-slate-400 flex items-center gap-1.5">
        <i class="fa-solid fa-shield-halved text-emerald-600"></i> Protection garantie
      </div>
    </div>

    <!-- Intégration Binance Pay Dynamique -->
    <div class="sm:col-span-2 lg:col-span-1 bg-slate-900 text-white p-5 sm:p-6 rounded-2xl shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between text-amber-400 text-xs font-bold mb-2">
          <span class="flex items-center gap-1.5">
            <i class="fa-brands fa-bitcoin text-sm"></i> Binance Pay
          </span>
          <span class="bg-amber-400/20 text-amber-300 text-[10px] px-2 py-0.5 rounded-full">Actif</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed mb-3">
          Configurez votre Binance Pay ID pour recevoir vos gains directement sur votre portefeuille.
        </p>
        <form id="binance-form" class="space-y-2">
          <input type="text" id="binanceId-input" name="binanceId" value="<%= user.binanceId || '' %>" placeholder="Votre Binance Pay ID (ex: 123456789)" class="w-full text-xs px-3 py-2 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-amber-400">
          <button type="submit" id="binance-save-btn" class="w-full py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-lg transition">
            Enregistrer mon Binance ID
          </button>
        </form>
      </div>
    </div>

  </div>

  <!-- Commandes Achat / Vente Responsives -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
    
    <!-- Mes Commandes (En tant qu'Acheteur) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
          <i class="fa-solid fa-file-pdf text-rose-500"></i> Mes Guides PDF Achetés
        </h2>
        <span class="text-xs text-slate-500"><%= buyerOrders.length %> guide(s)</span>
      </div>

      <div class="divide-y divide-slate-100">
        <% if (buyerOrders && buyerOrders.length > 0) { %>
          <% buyerOrders.forEach(ord => { %>
            <a href="/orders/<%= ord.id %>" class="p-4 sm:p-5 flex items-center justify-between gap-3 hover:bg-slate-50 transition block">
              <div class="space-y-1 min-w-0">
                <span class="text-[10px] sm:text-[11px] font-bold text-slate-400 block truncate">#<%= ord.id %> • Auteur: <%= ord.sellerName %></span>
                <h4 class="text-xs sm:text-sm font-bold text-slate-800 truncate"><%= ord.serviceTitle %></h4>
                <div class="text-[11px] sm:text-xs text-slate-500 flex items-center gap-2">
                  <span><%= ord.amount.toFixed(2) %> USDT</span>
                  <span class="text-emerald-600 font-semibold flex items-center gap-1"><i class="fa-solid fa-download text-[10px]"></i> PDF Disponible</span>
                </div>
              </div>
              <div class="text-right flex-shrink-0">
                <span class="inline-block text-[10px] sm:text-xs font-bold px-2.5 py-0.5 sm:py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (ord.status === 'DELIVERED' ? 'bg-amber-100 text-amber-800' : (ord.status === 'DISPUTED' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800')) %>">
                  <%= ord.status %>
                </span>
                <span class="block text-[10px] sm:text-[11px] text-slate-400 mt-1">Accéder <i class="fa-solid fa-chevron-right text-[8px]"></i></span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="text-center py-10 text-slate-400 text-xs">
            Vous n'avez pas encore acheté de guide PDF.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Mes Ventes (En tant que Travailleur) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
          <i class="fa-solid fa-book-bookmark text-blue-600"></i> Mes Méthodes PDF en Vente
        </h2>
        <span class="text-xs text-slate-500"><%= sellerOrders.length %> vente(s)</span>
      </div>

      <div class="divide-y divide-slate-100">
        <% if (sellerOrders && sellerOrders.length > 0) { %>
          <% sellerOrders.forEach(ord => { %>
            <a href="/orders/<%= ord.id %>" class="p-4 sm:p-5 flex items-center justify-between gap-3 hover:bg-slate-50 transition block">
              <div class="space-y-1 min-w-0">
                <span class="text-[10px] sm:text-[11px] font-bold text-slate-400 block truncate">#<%= ord.id %> • Acheteur: <%= ord.buyerName %></span>
                <h4 class="text-xs sm:text-sm font-bold text-slate-800 truncate"><%= ord.serviceTitle %></h4>
                <div class="text-[11px] sm:text-xs text-emerald-600 font-semibold">+<%= ord.amount.toFixed(2) %> USDT</div>
              </div>
              <div class="text-right flex-shrink-0">
                <span class="inline-block text-[10px] sm:text-xs font-bold px-2.5 py-0.5 sm:py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (ord.status === 'DELIVERED' ? 'bg-amber-100 text-amber-800' : (ord.status === 'DISPUTED' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800')) %>">
                  <%= ord.status %>
                </span>
                <span class="block text-[10px] sm:text-[11px] text-slate-400 mt-1">Détails <i class="fa-solid fa-chevron-right text-[8px]"></i></span>
              </div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="text-center py-10 text-slate-400 text-xs">
            Aucune vente enregistrée pour vos méthodes PDF pour le moment.
          </div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Historique des Retraits Binance Pay -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-5 sm:px-6 py-4 border-b border-slate-100 flex items-center justify-between">
      <h2 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
        <i class="fa-solid fa-clock-rotate-left text-amber-500"></i> Historique des Retraits Binance Pay
      </h2>
      <span class="text-xs text-slate-500"><%= typeof withdrawals !== 'undefined' ? withdrawals.length : 0 %> demande(s)</span>
    </div>

    <div class="divide-y divide-slate-100" id="withdrawals-list">
      <% if (typeof withdrawals !== 'undefined' && withdrawals.length > 0) { %>
        <% withdrawals.forEach(w => { %>
          <div class="p-4 sm:p-5 flex items-center justify-between gap-3 hover:bg-slate-50 transition">
            <div class="space-y-1">
              <span class="text-[10px] text-slate-400 font-bold block">#<%= w.id %> • Binance Pay ID: <%= w.binanceId %></span>
              <div class="text-xs font-bold text-slate-800"><%= new Date(w.createdAt).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
            </div>
            <div class="text-right">
              <div class="text-xs sm:text-sm font-black text-rose-600">-<%= w.amount.toFixed(2) %> USDT</div>
              <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded-full mt-1 <%= w.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : (w.status === 'REJECTED' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800') %>">
                <%= w.status === 'COMPLETED' ? 'Payé' : (w.status === 'REJECTED' ? 'Refusé' : 'En attente') %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-8 text-slate-400 text-xs">
          Aucune demande de retrait effectuée pour le moment.
        </div>
      <% } %>
    </div>
  </div>

</div>

<!-- Modal Demande de Retrait -->
<div id="withdraw-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 toast-anim space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="font-bold text-slate-900 text-base flex items-center gap-2">
        <i class="fa-solid fa-arrow-up-from-bracket text-emerald-600"></i> Demander un Retrait USDT
      </h3>
      <button id="close-withdraw-modal" class="text-slate-400 hover:text-slate-600 w-8 h-8 rounded-lg flex items-center justify-center transition">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs space-y-1">
      <div class="flex justify-between">
        <span class="text-slate-500">Solde disponible :</span>
        <span class="font-bold text-emerald-600"><%= user.walletBalance.toFixed(2) %> USDT</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Binance Pay ID :</span>
        <span class="font-bold text-slate-800"><%= user.binanceId || 'Non configuré' %></span>
      </div>
    </div>

    <% if (!user.binanceId) { %>
      <div class="bg-amber-50 border border-amber-200 p-3 rounded-xl text-xs text-amber-800 flex items-start gap-2">
        <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5"></i>
        <span>Veuillez d'abord configurer votre <strong>Binance Pay ID</strong> sur le tableau de bord pour autoriser le virement.</span>
      </div>
    <% } %>

    <form id="withdraw-form" class="space-y-4">
      <div>
        <div class="flex justify-between items-center mb-1">
          <label class="text-xs font-bold text-slate-700">Montant à retirer (USDT) :</label>
          <button type="button" id="withdraw-max-btn" class="text-[11px] font-bold text-emerald-600 hover:text-emerald-700">
            Retirer tout
          </button>
        </div>
        <div class="relative">
          <input type="number" id="withdraw-amount-input" step="0.01" min="1" max="<%= user.walletBalance %>" required placeholder="Ex: 50.00" class="w-full p-2.5 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          <span class="absolute right-3 top-2.5 text-xs font-bold text-slate-400">USDT</span>
        </div>
      </div>

      <div class="text-[11px] text-slate-500">
        ⚡ Les fonds sont virés directement via le réseau Binance Pay après validation automatique.
      </div>

      <div class="flex gap-2">
        <button type="button" id="cancel-withdraw-btn" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition">
          Annuler
        </button>
        <button type="submit" id="submit-withdraw-btn" <%= !user.binanceId ? 'disabled' : '' %> class="flex-1 py-2.5 bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-bold text-xs rounded-xl shadow-md transition flex items-center justify-center gap-1.5">
          <span>Confirmer le Retrait</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Script AJAX -->
<script>
  const depositBtn = document.getElementById('deposit-btn');
  if (depositBtn) {
    depositBtn.addEventListener('click', async () => {
      depositBtn.disabled = true;
      depositBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Rechargement...';
      try {
        const res = await fetch('/api/wallet/deposit-test', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          document.getElementById('dash-wallet-balance').textContent = data.newWalletBalance.toFixed(2);
          const headerWallet = document.getElementById('header-wallet-balance');
          if (headerWallet) headerWallet.textContent = data.newWalletBalance.toFixed(0);
          window.showToast('+50 USDT crédités avec succès !', 'success');
        } else {
          window.showToast(data.error || 'Erreur lors du dépôt', 'error');
        }
      } catch (err) {
        window.showToast('Erreur réseau', 'error');
      } finally {
        depositBtn.disabled = false;
        depositBtn.innerHTML = '<i class="fa-solid fa-plus text-[10px]"></i> +50 USDT Test';
      }
    });
  }

  const binanceForm = document.getElementById('binance-form');
  const binanceInput = document.getElementById('binanceId-input');
  const binanceSaveBtn = document.getElementById('binance-save-btn');

  if (binanceForm) {
    binanceForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      binanceSaveBtn.disabled = true;
      binanceSaveBtn.textContent = 'Enregistrement...';
      try {
        const res = await fetch('/api/wallet/update-binance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ binanceId: binanceInput.value.trim() })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast('Binance Pay ID enregistré avec succès !', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          window.showToast('Erreur lors de la mise à jour', 'error');
        }
      } catch (err) {
        window.showToast('Erreur réseau', 'error');
      } finally {
        binanceSaveBtn.disabled = false;
        binanceSaveBtn.textContent = 'Enregistrer mon Binance ID';
      }
    });
  }

  // Gestion du Modal de Retrait
  const openWithdrawBtn = document.getElementById('open-withdraw-btn');
  const withdrawModal = document.getElementById('withdraw-modal');
  const closeWithdrawModal = document.getElementById('close-withdraw-modal');
  const cancelWithdrawBtn = document.getElementById('cancel-withdraw-btn');
  const withdrawForm = document.getElementById('withdraw-form');
  const withdrawAmountInput = document.getElementById('withdraw-amount-input');
  const withdrawMaxBtn = document.getElementById('withdraw-max-btn');
  const submitWithdrawBtn = document.getElementById('submit-withdraw-btn');

  function openModal() {
    if (withdrawModal) {
      withdrawModal.classList.remove('hidden');
      withdrawModal.classList.add('flex');
    }
  }

  function closeModal() {
    if (withdrawModal) {
      withdrawModal.classList.add('hidden');
      withdrawModal.classList.remove('flex');
    }
  }

  if (openWithdrawBtn) openWithdrawBtn.addEventListener('click', openModal);
  if (closeWithdrawModal) closeWithdrawModal.addEventListener('click', closeModal);
  if (cancelWithdrawBtn) cancelWithdrawBtn.addEventListener('click', closeModal);

  if (withdrawMaxBtn && withdrawAmountInput) {
    withdrawMaxBtn.addEventListener('click', () => {
      const currentBal = parseFloat(document.getElementById('dash-wallet-balance').textContent) || 0;
      withdrawAmountInput.value = currentBal.toFixed(2);
    });
  }

  if (withdrawForm) {
    withdrawForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const amount = parseFloat(withdrawAmountInput.value);
      if (isNaN(amount) || amount <= 0) {
        window.showToast('Montant invalide', 'error');
        return;
      }

      submitWithdrawBtn.disabled = true;
      submitWithdrawBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Traitement...';

      try {
        const res = await fetch('/api/wallet/withdraw', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount })
        });
        const data = await res.json();
        if (data.success) {
          window.showToast(data.message || 'Retrait demandé avec succès !', 'success');
          closeModal();
          setTimeout(() => window.location.reload(), 1200);
        } else {
          window.showToast(data.error || 'Erreur lors du retrait', 'error');
        }
      } catch (err) {
        window.showToast('Erreur réseau', 'error');
      } finally {
        submitWithdrawBtn.disabled = false;
        submitWithdrawBtn.innerHTML = 'Confirmer le Retrait';
      }
    });
  }
</script>

<%- include('partials/footer') %>

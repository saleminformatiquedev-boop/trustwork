<%- include('partials/header', { title: 'LicenZio Shop — Digital Products & Keys' }) %>

<section class="bg-white border-b border-slate-200/80 py-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-3">
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">LicenZio Shop — Digital Accounts &amp; Keys</h1>
    <p class="text-sm text-slate-600">Live catalogue, instant delivery after your Binance payment.</p>
    <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
      <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer" class="px-3 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs"><i class="fa-brands fa-telegram"></i> @Melasbit</a>
      <a href="https://t.me/LicenzioChannel" target="_blank" rel="noopener noreferrer" class="px-3 py-2 rounded-xl bg-sky-50 text-sky-800 border border-sky-200 font-bold text-xs"><i class="fa-brands fa-telegram"></i> @LicenzioChannel</a>
      <a href="https://t.me/LicenzioGroup" target="_blank" rel="noopener noreferrer" class="px-3 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs"><i class="fa-solid fa-users"></i> Telegram Group</a>
    </div>
  </div>
</section>

<section class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-4">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
    <h2 class="text-xl font-extrabold text-slate-900">Products (<%= products.length %>)</h2>
    <input type="text" id="search" placeholder="Search..." class="text-xs px-3 py-2 bg-white border border-slate-200 rounded-lg focus:border-slate-900 focus:outline-none w-full sm:w-60">
  </div>
  <% if (products.length === 0) { %>
    <p class="text-sm text-slate-500">Catalogue temporarily unavailable, please retry in a minute.</p>
  <% } %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3" id="grid">
    <% products.forEach(p => { %>
      <div class="card bg-white rounded-xl border-2 border-slate-200 p-3 flex flex-col gap-2 <%= p.available ? 'cursor-pointer hover:border-slate-400' : 'opacity-60' %>"
           data-id="<%- p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-stock="<%= p.stock === null ? '' : p.stock %>"
           data-bulk="<%= JSON.stringify(p.bulkPricing) %>" data-available="<%= p.available %>">
        <div class="flex items-start gap-2">
          <% if (p.imageUrl) { %><img src="<%= p.imageUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer" class="w-10 h-10 rounded-lg object-cover bg-slate-100 shrink-0"><% } %>
          <div class="min-w-0 flex-1">
            <h3 class="font-extrabold text-slate-900 text-[13px] leading-tight"><%= p.name %></h3>
            <p class="text-[11px] text-slate-500 line-clamp-2 mt-0.5"><%= p.description %></p>
          </div>
          <span class="text-xs font-extrabold bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-md shrink-0">$<%= p.price.toFixed(2) %></span>
        </div>
        <div class="flex items-center justify-between text-[11px] mt-auto">
          <span class="<%= p.available ? 'text-emerald-700' : 'text-rose-600' %> font-bold">
            <%= p.available ? '🟢 In stock' + (p.stock !== null ? ' (' + p.stock + ')' : '') : '🔴 Out of stock' %>
          </span>
          <span class="text-slate-400"><%= p.sold %> sold</span>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<section id="checkout" class="max-w-5xl mx-auto px-4 sm:px-6 py-6">
  <div class="bg-white rounded-3xl border border-slate-200/90 p-6 sm:p-8 shadow-sm space-y-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
      <div>
        <h2 class="text-xl font-extrabold text-slate-900">Checkout</h2>
        <p id="selected-label" class="text-xs text-slate-500 mt-0.5">Select a product above.</p>
      </div>
      <div class="bg-slate-900 text-white px-5 py-3 rounded-2xl text-right">
        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold block">Total</span>
        <div id="total" class="text-2xl font-extrabold text-[#F0B90B]">$0.00 USDT</div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl text-xs font-bold">
          <button type="button" id="tab-pay" class="py-2.5 rounded-lg bg-slate-900 text-white">Binance Pay ID</button>
          <button type="button" id="tab-bsc" class="py-2.5 rounded-lg text-slate-600">USDT BEP20</button>
        </div>
        <div id="panel-pay" class="p-4 rounded-2xl bg-amber-50/70 border border-amber-200 space-y-2 text-xs text-slate-600">
          <p>Binance App &rarr; <strong>Pay</strong> &rarr; <strong>Send</strong>, paste this Pay ID and send the exact total in USDT.</p>
          <div class="flex items-center justify-between gap-2 bg-white px-3 py-2.5 rounded-xl border border-amber-200">
            <code id="pay-id" class="font-mono font-extrabold text-base select-all"><%= platformBinancePayId %></code>
            <button type="button" data-copy="pay-id" class="px-3 py-1.5 rounded-lg bg-[#F0B90B] font-bold text-xs">Copy</button>
          </div>
          <p>Then paste the <strong>Order ID</strong> (10-25 digits) from the payment details.</p>
        </div>
        <div id="panel-bsc" class="hidden p-4 rounded-2xl bg-slate-50 border border-slate-200 space-y-2 text-xs text-slate-600">
          <% if (bep20QrDataUrl) { %><div class="flex justify-center"><img src="<%= bep20QrDataUrl %>" alt="BEP20 QR" class="w-32 h-32"></div><% } %>
          <div class="flex items-center justify-between gap-2 bg-white px-3 py-2.5 rounded-xl border border-slate-200">
            <code id="bsc-addr" class="font-mono font-bold text-xs truncate select-all"><%= bep20Address %></code>
            <button type="button" data-copy="bsc-addr" class="px-3 py-1.5 rounded-lg bg-slate-900 text-white font-bold text-xs">Copy</button>
          </div>
          <p>Send USDT on <strong>BNB Smart Chain (BEP20)</strong> only, then paste the TxHash (0x...).</p>
        </div>
      </div>

      <form id="order-form" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Quantity</label>
          <input type="number" id="qty" min="1" value="1" class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Your contact (Telegram, WhatsApp or email)</label>
          <input type="text" id="contact" required class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1" id="tx-label">Binance Pay Order ID</label>
          <input type="text" id="txid" required class="w-full text-sm font-mono px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl">
        </div>
        <button type="submit" id="submit" class="w-full py-3 rounded-xl bg-[#F0B90B] hover:bg-[#FCD535] text-slate-950 font-extrabold text-sm">Verify payment &amp; get my keys</button>
        <p id="msg" class="text-xs font-semibold text-rose-600"></p>
      </form>
    </div>
  </div>
</section>

<script>
(function () {
  const cards = Array.from(document.querySelectorAll('.card'));
  let current = null, method = 'BINANCE_PAY';
  const $ = id => document.getElementById(id);

  function unit(card, q) {
    let price = parseFloat(card.dataset.price) || 0;
    let tiers = [];
    try { tiers = JSON.parse(card.dataset.bulk || '[]'); } catch (_) {}
    tiers.forEach(t => { if (q >= t.minQuantity && t.unitPrice <= price) price = t.unitPrice; });
    return price;
  }
  function render() {
    cards.forEach(c => c.classList.toggle('border-slate-900', c === current));
    if (!current) { $('total').textContent = '$0.00 USDT'; return; }
    const q = Math.max(1, parseInt($('qty').value) || 1);
    const stock = current.dataset.stock;
    $('qty').max = stock || 100;
    $('selected-label').textContent = current.dataset.name;
    $('total').textContent = '$' + (Math.round(unit(current, q) * q * 100) / 100).toFixed(2) + ' USDT';
  }
  cards.forEach(c => c.addEventListener('click', () => {
    if (c.dataset.available !== 'true') return;
    current = c; render();
    $('checkout').scrollIntoView({ behavior: 'smooth' });
  }));
  $('qty').addEventListener('input', render);
  $('search').addEventListener('input', e => {
    const q = e.target.value.toLowerCase().trim();
    cards.forEach(c => c.style.display = !q || c.dataset.name.toLowerCase().includes(q) ? '' : 'none');
  });
  document.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', () => {
    navigator.clipboard && navigator.clipboard.writeText($(b.dataset.copy).textContent.trim());
    b.textContent = 'Copied';
  }));
  function setMethod(m) {
    method = m;
    const pay = m === 'BINANCE_PAY';
    $('panel-pay').classList.toggle('hidden', !pay);
    $('panel-bsc').classList.toggle('hidden', pay);
    $('tab-pay').className = 'py-2.5 rounded-lg ' + (pay ? 'bg-slate-900 text-white' : 'text-slate-600');
    $('tab-bsc').className = 'py-2.5 rounded-lg ' + (!pay ? 'bg-slate-900 text-white' : 'text-slate-600');
    $('tx-label').textContent = pay ? 'Binance Pay Order ID' : 'BEP20 TxHash (0x...)';
  }
  $('tab-pay').addEventListener('click', () => setMethod('BINANCE_PAY'));
  $('tab-bsc').addEventListener('click', () => setMethod('USDT_BEP20'));

  $('order-form').addEventListener('submit', async e => {
    e.preventDefault();
    $('msg').textContent = '';
    if (!current) { $('msg').textContent = 'Please select a product first.'; return; }
    const btn = $('submit');
    btn.disabled = true; btn.textContent = 'Verifying payment...';
    try {
      const res = await fetch('/api/store/checkout', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          productId: current.dataset.id, quantity: parseInt($('qty').value) || 1,
          paymentMethod: method, txId: $('txid').value.trim(), customerContact: $('contact').value.trim()
        })
      });
      const data = await res.json();
      if (data.success) { window.location.href = data.receiptUrl; return; }
      $('msg').textContent = data.error || 'Error';
    } catch (_) { $('msg').textContent = 'Network error, please retry.'; }
    btn.disabled = false; btn.textContent = 'Verify payment & get my keys';
  });
  render();
})();
</script>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Accueil - Marketplace Sécurisée' }) %>

<!-- Hero Banner -->
<section class="bg-gradient-to-b from-emerald-50/60 to-transparent py-14 border-b border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100/80 text-emerald-800 text-xs font-semibold mb-6">
      <i class="fa-solid fa-lock text-emerald-600"></i> Système de Séquestre Intégré : Votre argent est 100% protégé
    </div>
    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight max-w-3xl mx-auto leading-tight">
      Achetez et vendez des services <span class="text-emerald-600">à prix forfaitaire</span> en toute confiance.
    </h1>
    <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
      Comme Upwork, mais sans contrat à l'heure ni mauvaise surprise. Les fonds restent bloqués sur la plateforme tant que vous n'avez pas validé la livraison.
    </p>

    <!-- Quick role switch for instant testing -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/services/new" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm shadow-md shadow-emerald-200 transition">
        <i class="fa-solid fa-plus"></i> Proposer un service
      </a>
      <a href="#catalogue" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-sm shadow-sm transition">
        <i class="fa-solid fa-compass"></i> Explorer les offres
      </a>
    </div>

    <!-- Quick test bar banner -->
    <div class="mt-10 max-w-xl mx-auto bg-white p-3 rounded-xl border border-dashed border-emerald-300 shadow-sm flex items-center justify-between text-xs text-slate-600">
      <span class="font-semibold flex items-center gap-1.5 text-slate-800">
        <i class="fa-solid fa-vial text-emerald-600"></i> Mode test rapide :
      </span>
      <div class="flex items-center gap-2">
        <a href="/auth/demo-login/buyer" class="bg-blue-50 text-blue-700 px-2.5 py-1 rounded-md font-medium hover:bg-blue-100 transition">Acheteur (Thomas)</a>
        <a href="/auth/demo-login/seller" class="bg-purple-50 text-purple-700 px-2.5 py-1 rounded-md font-medium hover:bg-purple-100 transition">Vendeur (Sarah)</a>
        <a href="/auth/demo-login/admin" class="bg-amber-50 text-amber-700 px-2.5 py-1 rounded-md font-medium hover:bg-amber-100 transition">Médiateur</a>
      </div>
    </div>
  </div>
</section>

<!-- Catalogue -->
<section id="catalogue" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h2 class="text-2xl font-bold text-slate-900">Services disponibles</h2>
      <p class="text-sm text-slate-500">Tarif fixe sans dépassement possible. Argent sécurisé jusqu'à livraison.</p>
    </div>
  </div>

  <% if (services && services.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% services.forEach(service => { %>
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
          
          <div class="p-6">
            <!-- Vendeur & Catégorie -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5">
                <img src="<%= service.sellerAvatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + service.sellerName %>" alt="<%= service.sellerName %>" class="w-8 h-8 rounded-full border border-slate-200">
                <span class="text-xs font-semibold text-slate-700"><%= service.sellerName %></span>
              </div>
              <span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">
                <%= service.category %>
              </span>
            </div>

            <!-- Titre & Description -->
            <h3 class="font-bold text-slate-900 text-base mb-2 line-clamp-2 hover:text-emerald-600 transition">
              <a href="/services/<%= service.id %>"><%= service.title %></a>
            </h3>
            <p class="text-slate-500 text-xs line-clamp-3 leading-relaxed mb-4">
              <%= service.description %>
            </p>

            <!-- Délai -->
            <div class="flex items-center gap-1.5 text-xs text-slate-500">
              <i class="fa-regular fa-clock text-slate-400"></i>
              Livraison sous <strong><%= service.deliveryDays %> jours</strong>
            </div>
          </div>

          <!-- Footer carte avec Prix et Bouton Séquestre -->
          <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Prix Forfaitaire</span>
              <div class="text-xl font-extrabold text-slate-900"><%= service.price.toFixed(2) %> €</div>
            </div>
            
            <a href="/services/<%= service.id %>" class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-sm transition">
              <i class="fa-solid fa-shield-halved"></i> Commander
            </a>
          </div>

        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
      <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-3"></i>
      <h3 class="text-base font-semibold text-slate-700">Aucun service pour le moment</h3>
      <p class="text-xs text-slate-400 mt-1 mb-4">Soyez le premier travailleur à proposer une prestation forfaitaire.</p>
      <a href="/services/new" class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 text-white font-semibold text-xs rounded-lg">
        Créer un service
      </a>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>

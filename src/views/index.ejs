<%- include('partials/header', { title: '@Melasbit — Digital Methods & Tools' }) %>

<!-- Simple Hero -->
<section class="bg-white border-b border-slate-200/80 py-10 sm:py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-4">

    <div class="inline-flex flex-wrap items-center justify-center gap-2">
      <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-3 py-1 rounded-full transition">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Direct Supplier • @Melasbit
      </a>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-3 py-1 rounded-full">
        <i class="fa-solid fa-display text-[10px]"></i>
        Live Screen-Share Proof
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">
        <i class="fa-solid fa-star text-[10px]"></i>
        Secure Telegram Stars Checkout
      </span>
    </div>

    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      Digital Accounts &amp; Working Methods
    </h1>

    <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600 leading-relaxed">
      Hello everyone! I'm <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer" class="font-extrabold text-sky-600 hover:underline">@Melasbit</a> (<a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer" class="font-semibold text-sky-600 hover:underline">https://t.me/Melasbit</a>) — direct supplier for digital accounts and tools.
      <strong>I will share my screen and show you how it works!</strong>
      Select one or more methods below to pay securely with Telegram Stars, or reach out for bulk deals &amp; method exchanges.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
      <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs sm:text-sm transition shadow-sm">
        <i class="fa-brands fa-telegram text-base"></i>
        <span>Telegram: @Melasbit (t.me/Melasbit)</span>
      </a>
      <a href="https://wa.me/21627076373?text=Hello%20%40Melasbit!%20I%20am%20interested%20in%20your%20methods." target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs sm:text-sm transition shadow-sm">
        <i class="fa-brands fa-whatsapp text-base"></i>
        <span>WhatsApp: +21627076373</span>
      </a>
      <a href="/chat?support=1"
         class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm transition">
        <i class="fa-regular fa-comments"></i>
        <span>DM on Site</span>
      </a>
      <a href="https://t.me/LicenzioChannel" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 border border-sky-200 font-bold text-xs sm:text-sm transition">
        <i class="fa-brands fa-telegram text-base text-sky-600"></i>
        <span>Channel: @LicenzioChannel</span>
      </a>
    </div>

  </div>
</section>

<!-- STEP 1: Select 1 or More Methods -->
<section id="methods" class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
    <div>
      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700">Step 1</span>
      <h2 class="text-xl font-extrabold text-slate-900">🚀 Available Methods (<%= services ? services.length : 0 %>) — Select 1 or More</h2>
    </div>
    <div class="flex items-center gap-2">
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[11px]"></i>
        <input type="text" id="method-search-input" placeholder="Search method..." class="text-xs pl-8 pr-3 py-1.5 bg-white border border-slate-200 rounded-lg focus:border-slate-900 focus:outline-none w-44 sm:w-52">
      </div>
      <a href="#checkout" id="jump-checkout-btn" class="text-xs font-extrabold text-white bg-sky-600 hover:bg-sky-700 px-3 py-1.5 rounded-lg transition whitespace-nowrap">
        Pay ↓
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5" id="methods-list">
    <% if (services && services.length > 0) { %>
      <% services.forEach((service, idx) => { %>
        <% const isAdminTested = ['srv_notion_edu_plus_1y', 'srv_adobe_express_6m_script', 'srv_capcut_ready'].includes(service.id); %>
        <div
          class="method-select-card cursor-pointer bg-white rounded-xl border-2 <%= idx === 0 ? 'border-slate-900 ring-2 ring-slate-900/10' : 'border-slate-200 hover:border-slate-400' %> px-3 py-2 transition flex flex-col justify-between gap-1.5 select-none"
          data-id="<%= service.id %>"
          data-title="<%= service.title %>"
          data-price="<%= service.price %>"
          data-selected="<%= idx === 0 ? 'true' : 'false' %>">

          <% if (isAdminTested) { %>
            <div class="px-2.5 py-0.5 rounded-md bg-emerald-600 text-white text-[11px] font-extrabold tracking-wide flex items-center justify-center gap-1.5">
              <i class="fa-solid fa-flag text-[#F0B90B] text-[10px]"></i>
              <span>Tested by the admin @Melasbit</span>
            </div>
          <% } %>

          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <span class="method-check inline-flex items-center gap-1 text-[11px] font-bold shrink-0 <%= idx === 0 ? 'text-emerald-700' : 'text-slate-400' %>">
                <i class="<%= idx === 0 ? 'fa-solid fa-circle-check text-emerald-600' : 'fa-regular fa-circle text-slate-300' %> text-sm"></i>
                <span class="method-check-label sr-only"><%= idx === 0 ? 'Selected' : 'Select' %></span>
              </span>
              <h3 class="font-extrabold text-slate-900 text-[13px] leading-tight truncate">
                <%= service.title %>
              </h3>
            </div>
            <span class="text-xs font-extrabold text-slate-900 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-md shrink-0">
              $<%= Number.isInteger(service.price) ? service.price : service.price.toFixed(2).replace(/0$/, '') %>
            </span>
          </div>

          <div class="flex items-center justify-between gap-2 text-[11px]">
            <span class="px-2 py-0.5 rounded-md bg-slate-900 text-emerald-400 font-bold truncate">
              <span class="text-slate-400 font-medium">Cost:</span> <%= service.unitCost || 'Ready to use' %>
            </span>
            <span class="text-[10px] font-semibold text-slate-500 shrink-0">
              <%= service.durationLabel || 'Ready to use' %> • <span class="text-emerald-700">Telegram Stars</span>
            </span>
          </div>

          <div class="text-[10px] text-slate-500 truncate">
            <i class="fa-solid fa-display text-indigo-600 mr-1"></i>
            Live screen-share demo included — I show you how it works!
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- STEP 2: Telegram Stars Checkout -->
<section id="checkout" class="max-w-4xl mx-auto px-4 sm:px-6 py-6">
  <div class="bg-white rounded-3xl border border-slate-200/90 p-6 sm:p-8 shadow-sm space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-sky-700">Step 2</span>
        <h2 class="text-xl font-extrabold text-slate-900">Pay securely with Telegram Stars</h2>
        <p class="text-xs text-slate-500 mt-0.5">Select your methods, enter a contact, then approve the Stars invoice in Telegram. Payment confirmation is automatic — no TxID to copy.</p>
      </div>
      <div class="bg-slate-900 text-white px-5 py-3 rounded-2xl text-right shrink-0">
        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold block">Total to Pay</span>
        <div id="checkout-total-display" class="text-2xl font-extrabold text-sky-400">$10.00 USD</div>
        <div id="checkout-stars-display" class="text-[11px] font-bold text-amber-300">≈ 770 Stars</div>
      </div>
    </div>

    <!-- Selected Items Summary -->
    <div id="selected-items-summary" class="flex flex-wrap items-center gap-2 text-xs"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Left: How Telegram Stars works -->
      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-sky-50/70 border border-sky-200 space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="font-extrabold text-sky-900">
              <i class="fa-solid fa-star text-amber-500 mr-1"></i> Telegram Stars (XTR)
            </span>
            <span class="text-[11px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">Instant • Official</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Telegram Stars is Telegram's official currency for digital goods. You buy Stars directly inside Telegram with your preferred payment method, then pay this order in one tap.
          </p>
          <ol class="text-xs text-slate-600 space-y-1.5 list-decimal list-inside leading-relaxed">
            <li>Select one or more methods above.</li>
            <li>Enter your WhatsApp, Telegram, or Email contact.</li>
            <li>Tap the Stars button and approve the invoice in Telegram.</li>
            <li>Your order is marked paid automatically and @Melasbit is notified.</li>
          </ol>

          <% if (typeof telegramBotUsername !== 'undefined' && telegramBotUsername) { %>
            <a href="https://t.me/<%= telegramBotUsername %>" target="_blank" rel="noopener noreferrer"
               class="w-full py-2.5 px-4 rounded-xl bg-sky-600 hover:bg-sky-700 text-white text-xs font-bold transition flex items-center justify-center gap-2">
              <i class="fa-brands fa-telegram"></i>
              <span>Open @<%= telegramBotUsername %> on Telegram</span>
            </a>
          <% } else { %>
            <p class="text-[11px] text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-2.5 py-2">
              Telegram bot not configured yet. Contact <a href="https://t.me/Melasbit" target="_blank" rel="noopener noreferrer" class="font-bold underline">@Melasbit</a> to complete the order.
            </p>
          <% } %>

          <p class="text-[11px] text-slate-500">
            Conversion: <strong><%= typeof starsPerUsd !== 'undefined' ? starsPerUsd : 77 %> Stars = $1 USD</strong>.
            The exact Stars amount is shown on the button and in the Telegram invoice.
          </p>
        </div>
      </div>

      <!-- Right: Confirm Order Form -->
      <div class="space-y-4">
        <form id="store-order-form" class="space-y-3.5">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Your Contact (WhatsApp, Telegram, or Email)</label>
            <input type="text" id="order-contact" required value="<%= user ? user.email : '' %>" placeholder="e.g. +216... or @username or email@..." class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Note (Optional — e.g. preferred time for screen-share)</label>
            <input type="text" id="order-note" placeholder="Ready now for screen-share demo..." class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
          </div>

          <button type="submit" id="order-submit-btn" class="w-full py-3 px-4 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-extrabold text-sm transition shadow-sm flex items-center justify-center gap-2">
            <i class="fa-solid fa-star text-amber-300"></i>
            <span>Pay with Telegram Stars</span>
          </button>
          <p class="text-[11px] text-center text-slate-400">Secure XTR invoice • Refundable by the admin within Telegram's refund window</p>
        </form>

        <!-- Payment / Confirmation Box -->
        <div id="order-success-box" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-3">
          <div class="flex items-center gap-2 text-emerald-800 font-extrabold text-sm">
            <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
            <span id="order-success-title">Invoice created!</span>
          </div>
          <p id="order-success-text" class="text-xs text-emerald-900 leading-relaxed"></p>
          <div class="flex flex-wrap gap-2">
            <a id="order-success-invoice" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs transition">
              <i class="fa-brands fa-telegram text-sm"></i> Open Telegram Invoice
            </a>
            <button type="button" id="order-check-status-btn" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition">
              <i class="fa-solid fa-rotate text-sm"></i> Check Payment Status
            </button>
          </div>
          <div id="order-payment-status" class="text-[11px] font-semibold text-slate-600"></div>
          <div class="flex flex-wrap gap-2">
            <a id="order-success-wa" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs transition">
              <i class="fa-brands fa-whatsapp text-sm"></i> Send Order on WhatsApp
            </a>
            <a href="/chat?support=1" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white border border-slate-200 hover:border-slate-400 text-slate-700 font-bold text-xs transition">
              <i class="fa-regular fa-comments"></i> Open DM Chat
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>



<script>
  const STARS_PER_USD = <%- JSON.stringify(typeof starsPerUsd !== 'undefined' ? starsPerUsd : 77) %>;
  const cards = Array.from(document.querySelectorAll('.method-select-card'));
  const totalDisplay = document.getElementById('checkout-total-display');
  const starsDisplay = document.getElementById('checkout-stars-display');
  const summaryEl = document.getElementById('selected-items-summary');
  const jumpCheckoutBtn = document.getElementById('jump-checkout-btn');
  const methodSearchInput = document.getElementById('method-search-input');
  const orderSubmitBtn = document.getElementById('order-submit-btn');
  let statusPollTimer = null;
  let currentOrderId = null;

  function starsFor(usd) {
    const value = Number(usd);
    if (!Number.isFinite(value) || value <= 0) return 0;
    return Math.max(1, Math.ceil(value * STARS_PER_USD));
  }

  if (methodSearchInput) {
    methodSearchInput.addEventListener('input', () => {
      const q = methodSearchInput.value.toLowerCase().trim();
      cards.forEach(card => {
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        card.style.display = (!q || title.includes(q)) ? 'flex' : 'none';
      });
    });
  }

  function getSelectedItems() {
    return cards
      .filter(c => c.getAttribute('data-selected') === 'true')
      .map(c => ({
        id: c.getAttribute('data-id'),
        title: c.getAttribute('data-title'),
        price: parseFloat(c.getAttribute('data-price')) || 0
      }));
  }

  function formatUsd(n) {
    return Number.isInteger(n) ? String(n) : n.toFixed(2).replace(/0$/, '');
  }

  function renderCart() {
    const selected = getSelectedItems();
    const total = selected.reduce((s, item) => s + item.price, 0);
    const stars = starsFor(total);

    if (totalDisplay) totalDisplay.textContent = `$${total.toFixed(2)} USD`;
    if (starsDisplay) starsDisplay.textContent = `≈ ${stars} Stars`;
    if (jumpCheckoutBtn) jumpCheckoutBtn.textContent = `Pay (${selected.length} • ⭐ ${stars}) ↓`;
    if (orderSubmitBtn) {
      orderSubmitBtn.innerHTML = `<i class="fa-solid fa-star text-amber-300"></i> <span>Pay ${stars} Stars</span>`;
    }

    if (summaryEl) {
      if (selected.length === 0) {
        summaryEl.innerHTML = `<span class="text-rose-600 font-semibold">Please select at least 1 method above.</span>`;
      } else {
        summaryEl.innerHTML = `<span class="text-slate-400 font-semibold">Selected:</span> ` +
          selected.map(i => `<span class="inline-flex items-center gap-1 bg-slate-100 text-slate-800 font-bold px-2.5 py-1 rounded-lg">${i.title} <span class="text-emerald-700">$${formatUsd(i.price)}</span></span>`).join('');
      }
    }

    cards.forEach(card => {
      const isSel = card.getAttribute('data-selected') === 'true';
      const icon = card.querySelector('.method-check i');
      const label = card.querySelector('.method-check-label');
      const checkWrap = card.querySelector('.method-check');

      card.classList.toggle('border-slate-900', isSel);
      card.classList.toggle('ring-2', isSel);
      card.classList.toggle('ring-slate-900/10', isSel);
      card.classList.toggle('border-slate-200', !isSel);

      if (icon) {
        icon.className = isSel
          ? 'fa-solid fa-circle-check text-emerald-600 text-sm'
          : 'fa-regular fa-circle text-slate-300 text-sm';
      }
      if (label) label.textContent = isSel ? 'Selected' : 'Select';
      if (checkWrap) {
        checkWrap.classList.toggle('text-emerald-700', isSel);
        checkWrap.classList.toggle('text-slate-400', !isSel);
      }
    });
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const current = card.getAttribute('data-selected') === 'true';
      card.setAttribute('data-selected', current ? 'false' : 'true');
      renderCart();
    });
  });

  renderCart();

  function setPaymentStatus(message, tone) {
    const el = document.getElementById('order-payment-status');
    if (!el) return;
    el.textContent = message;
    el.className = `text-[11px] font-semibold ${tone === 'success' ? 'text-emerald-700' : (tone === 'error' ? 'text-rose-700' : 'text-amber-700')}`;
  }

  function startOrderPolling(orderId) {
    if (!orderId) return;
    currentOrderId = orderId;
    if (statusPollTimer) clearInterval(statusPollTimer);
    const startedAt = Date.now();

    const check = async () => {
      if (Date.now() - startedAt > 10 * 60 * 1000) {
        clearInterval(statusPollTimer);
        statusPollTimer = null;
        setPaymentStatus('Still waiting for Telegram. You can check again later with the button above.', 'error');
        return;
      }
      try {
        const res = await fetch(`/api/store/orders/${encodeURIComponent(orderId)}/status`);
        const data = await res.json();
        if (!data.success || !data.order) return;
        const ord = data.order;

        if (ord.status === 'PAID') {
          clearInterval(statusPollTimer);
          statusPollTimer = null;
          const title = document.getElementById('order-success-title');
          const text = document.getElementById('order-success-text');
          if (title) title.textContent = 'Payment confirmed!';
          if (text) text.textContent = `Order #${ord.id} is paid (${ord.starsAmount || ''} Stars). @Melasbit has been notified and will contact you to schedule the screen-share.`;
          setPaymentStatus(`✅ Payment confirmed — ${ord.starsAmount || ''} Stars received.`, 'success');
          if (window.showToast) window.showToast('Payment confirmed! Your order is now paid.', 'success');
        } else if (ord.status === 'REJECTED' || ord.status === 'REFUNDED') {
          clearInterval(statusPollTimer);
          statusPollTimer = null;
          setPaymentStatus(`Order status: ${ord.status}. Contact @Melasbit if you need help.`, 'error');
        } else {
          setPaymentStatus('⏳ Waiting for Telegram payment confirmation...', 'pending');
        }
      } catch (_) {
        // Keep polling silently on transient network errors.
      }
    };

    check();
    statusPollTimer = setInterval(check, 3000);
  }

  const checkStatusBtn = document.getElementById('order-check-status-btn');
  if (checkStatusBtn) {
    checkStatusBtn.addEventListener('click', () => {
      if (!currentOrderId) return;
      startOrderPolling(currentOrderId);
      if (window.showToast) window.showToast('Checking Telegram payment status...', 'success');
    });
  }

  // Submit a Telegram Stars order
  const orderForm = document.getElementById('store-order-form');
  if (orderForm) {
    orderForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const selected = getSelectedItems();
      if (selected.length === 0) {
        if (window.showToast) window.showToast('Please select at least one method first.', 'error');
        return;
      }

      const customerContact = document.getElementById('order-contact').value.trim();
      const note = document.getElementById('order-note').value.trim();
      if (!customerContact) {
        if (window.showToast) window.showToast('Please enter your contact first.', 'error');
        return;
      }

      const btn = document.getElementById('order-submit-btn');
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creating Stars invoice...';

      try {
        const res = await fetch('/api/store/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            serviceIds: selected.map(s => s.id),
            customerContact,
            note
          })
        });
        const data = await res.json();
        if (!data.success || !data.order) {
          if (window.showToast) window.showToast(data.error || 'Error submitting order', 'error');
          return;
        }

        const ord = data.order;
        const stars = data.stars || starsFor(ord.totalAmount);

        const title = document.getElementById('order-success-title');
        const text = document.getElementById('order-success-text');
        if (title) title.textContent = 'Invoice created — complete payment in Telegram';
        if (text) {
          text.textContent = `Order #${ord.id}: ${ord.items.map(i => i.title).join(', ')} — $${ord.totalAmount.toFixed(2)} USD (${stars} Stars). Open the invoice and approve it in Telegram. This page updates automatically.`;
        }

        const invoiceLink = document.getElementById('order-success-invoice');
        if (invoiceLink) invoiceLink.href = data.invoiceLink;

        const itemsList = ord.items.map(i => `${i.title} ($${i.price})`).join(', ');
        const waMsg = `Hello @Melasbit! Order #${ord.id}\nMethods: ${itemsList}\nTotal: $${ord.totalAmount.toFixed(2)} USD (${stars} Stars)\nContact: ${ord.customerContact}\nI'm paying with Telegram Stars — please confirm and start screen-share!`;
        const waLink = document.getElementById('order-success-wa');
        if (waLink) waLink.href = `https://wa.me/21627076373?text=${encodeURIComponent(waMsg)}`;

        document.getElementById('order-success-box').classList.remove('hidden');
        setPaymentStatus('⏳ Waiting for Telegram payment confirmation...', 'pending');
        startOrderPolling(ord.id);

        // Best-effort automatic open. The "Open Telegram Invoice" button remains as a fallback.
        try { window.open(data.invoiceLink, '_blank', 'noopener'); } catch (_) {}

        if (window.showToast) window.showToast('Invoice opened in Telegram. Approve it to confirm your order.', 'success');
      } catch (err) {
        if (window.showToast) window.showToast('Network error. Please try again.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  }

</script>


<%- include('partials/header', { title: 'Explore Guides & Methods' }) %>

<!-- Minimalist Hero -->
<section class="border-b border-slate-200/80 bg-white py-12 sm:py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 text-xs font-medium text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        Protected by automated USDT escrow
      </div>
      
      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Developer PDF guides, source code & step-by-step methods.
      </h1>
      
      <p class="mt-3 text-sm sm:text-base text-slate-500 leading-relaxed">
        Download complete technical packages (PDF guide, ZIP source code, scripts, and video walkthrough). Your funds stay locked in escrow until you approve.
      </p>

      <!-- 2-Day Validation Rule Banner -->
      <div class="mt-4 inline-flex items-start sm:items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-amber-50/90 border border-amber-200/80 text-xs text-amber-900">
        <i class="fa-regular fa-clock text-amber-600 mt-0.5 sm:mt-0"></i>
        <span><strong>2-Day Validation Policy:</strong> You have only <strong>2 days (48h)</strong> to validate if the method is good or not. After 2 days, the review will be handled by the <strong>Admin</strong>.</span>
      </div>
    </div>

    <!-- Clean Search & Filters -->
    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <div class="relative flex-grow">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
        <input type="text" id="service-search-input" placeholder="Search a method (e.g. Docker, AWS, JWT, Microservices)..." class="w-full text-sm pl-9 pr-4 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none transition">
      </div>

      <select id="category-filter-select" class="text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none text-slate-700">
        <option value="ALL">All Categories</option>
        <option value="Cloud & Deployment">Cloud & Deployment</option>
        <option value="Backend & API">Backend & API</option>
        <option value="DevOps & CI/CD">DevOps & CI/CD</option>
        <option value="Security & Blockchain">Security & Blockchain</option>
        <option value="Software Architecture">Software Architecture</option>
        <option value="Development Methodology">Methodology</option>
      </select>

      <select id="sort-filter-select" class="text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none text-slate-700">
        <option value="recent">Newest</option>
        <option value="price_asc">Price: Low to High</option>
        <option value="price_desc">Price: High to Low</option>
      </select>
    </div>

    <!-- Quick Demo Switcher -->
    <div class="mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-2 text-xs text-slate-500">
      <span>1-click demo access:</span>
      <a href="/auth/demo-login/buyer" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition">Buyer</a>
      <a href="/auth/demo-login/seller" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition">Seller</a>
      <a href="/auth/demo-login/admin" class="px-2.5 py-1 rounded-md bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium transition">Admin</a>
    </div>

  </div>
</section>

<!-- Methods Grid -->
<section id="catalogue" class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
  
  <div id="services-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    <% if (services && services.length > 0) { %>
      <% services.forEach(service => { %>
        <a href="/services/<%= service.id %>" 
           class="service-card bg-white rounded-2xl border border-slate-200/90 p-5 hover:border-slate-400 hover:shadow-sm transition flex flex-col justify-between group"
           data-title="<%= service.title.toLowerCase() %>"
           data-category="<%= service.category %>"
           data-price="<%= service.price %>">
          
          <div>
            <!-- Category & Format Tag -->
            <div class="flex items-center justify-between gap-2 text-[11px] text-slate-400 font-medium mb-3">
              <span class="truncate"><%= service.category %></span>
              <span class="text-slate-600 bg-slate-100 px-2 py-0.5 rounded-md font-semibold flex-shrink-0">
                PDF • ZIP • Video
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-bold text-slate-900 text-base mb-2 line-clamp-2 group-hover:text-emerald-700 transition">
              <%= service.title %>
            </h3>

            <!-- Short Description -->
            <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed mb-5">
              <%= service.description %>
            </p>
          </div>

          <!-- Card Footer: Author & Price -->
          <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2 min-w-0">
              <img src="<%= service.sellerAvatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + service.sellerName %>" alt="<%= service.sellerName %>" class="w-6 h-6 rounded-full border border-slate-200 object-cover flex-shrink-0">
              <span class="text-xs text-slate-600 truncate"><%= service.sellerName %></span>
            </div>

            <div class="text-sm font-bold text-slate-900 flex-shrink-0">
              <%= service.price.toFixed(0) %> <span class="text-xs font-semibold text-slate-500">USDT</span>
            </div>
          </div>

        </a>
      <% }) %>
    <% } %>
  </div>

  <!-- No Results -->
  <div id="no-results-message" class="hidden text-center py-14 bg-white rounded-2xl border border-slate-200">
    <p class="text-sm font-semibold text-slate-700">No matching methods found.</p>
    <p class="text-xs text-slate-400 mt-1">Try another keyword or select a different category.</p>
  </div>
</section>

<script>
  const searchInput = document.getElementById('service-search-input');
  const categorySelect = document.getElementById('category-filter-select');
  const sortSelect = document.getElementById('sort-filter-select');
  const grid = document.getElementById('services-grid');
  const noResults = document.getElementById('no-results-message');

  function filterAndSortServices() {
    const query = searchInput.value.toLowerCase().trim();
    const category = categorySelect.value;
    const sortBy = sortSelect.value;
    const cards = Array.from(document.querySelectorAll('.service-card'));
    let visibleCount = 0;

    cards.forEach(card => {
      const title = card.getAttribute('data-title');
      const cat = card.getAttribute('data-category');
      const matchesSearch = !query || title.includes(query);
      const matchesCategory = category === 'ALL' || cat === category;

      if (matchesSearch && matchesCategory) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const visibleCards = cards.filter(c => c.style.display !== 'none');
    if (sortBy === 'price_asc') {
      visibleCards.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
      visibleCards.forEach(c => grid.appendChild(c));
    } else if (sortBy === 'price_desc') {
      visibleCards.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
      visibleCards.forEach(c => grid.appendChild(c));
    }

    noResults.classList.toggle('hidden', visibleCount > 0);
  }

  searchInput.addEventListener('input', filterAndSortServices);
  categorySelect.addEventListener('change', filterAndSortServices);
  sortSelect.addEventListener('change', filterAndSortServices);
</script>

<%- include('partials/footer') %>

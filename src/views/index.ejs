<%- include('partials/header', { title: '@Melasbit — Digital Methods & Tools' }) %>

<!-- Simple Hero -->
<section class="bg-white border-b border-slate-200/80 py-10 sm:py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-4">

    <div class="inline-flex flex-wrap items-center justify-center gap-2">
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Direct Supplier • @Melasbit
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 px-3 py-1 rounded-full">
        <i class="fa-solid fa-display text-[10px]"></i>
        Live Screen-Share Proof
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-800 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">
        <i class="fa-solid fa-coins text-[10px]"></i>
        Binance Pay ID &amp; USDT BEP20
      </span>
    </div>

    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      Digital Accounts &amp; Working Methods
    </h1>

    <p class="max-w-2xl mx-auto text-sm sm:text-base text-slate-600 leading-relaxed">
      Hello everyone! I'm <strong class="text-slate-900">@Melasbit</strong> — direct supplier for digital accounts and tools.
      <strong>I will share my screen and show you how it works!</strong>
      Select one or more methods below to buy via Binance, or reach out for bulk deals &amp; method exchanges.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
      <a href="https://wa.me/21627076373?text=Hello%20%40Melasbit!%20I%20am%20interested%20in%20your%20methods." target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs sm:text-sm transition shadow-sm">
        <i class="fa-brands fa-whatsapp text-base"></i>
        <span>WhatsApp: +21627076373</span>
      </a>
      <a href="/chat?support=1"
         class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm transition">
        <i class="fa-regular fa-comments"></i>
        <span>DM on Site</span>
      </a>
      <a href="https://t.me/Licenziobot" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs sm:text-sm transition">
        <i class="fa-brands fa-telegram text-base"></i>
        <span>Products: @Licenziobot</span>
      </a>
    </div>

  </div>
</section>

<!-- STEP 1: Select 1 or More Methods -->
<section id="methods" class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
    <div>
      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700">Step 1</span>
      <h2 class="text-xl font-extrabold text-slate-900">🚀 Available Methods (<%= services ? services.length : 0 %>) — Select 1 or More</h2>
    </div>
    <div class="flex items-center gap-2">
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[11px]"></i>
        <input type="text" id="method-search-input" placeholder="Search method..." class="text-xs pl-8 pr-3 py-1.5 bg-white border border-slate-200 rounded-lg focus:border-slate-900 focus:outline-none w-44 sm:w-52">
      </div>
      <a href="#checkout" id="jump-checkout-btn" class="text-xs font-extrabold text-slate-950 bg-[#F0B90B] hover:bg-[#FCD535] px-3 py-1.5 rounded-lg transition whitespace-nowrap">
        Pay ($10) ↓
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="methods-list">
    <% if (services && services.length > 0) { %>
      <% services.forEach((service, idx) => { %>
        <div
          class="method-select-card cursor-pointer bg-white rounded-2xl border-2 <%= idx === 0 ? 'border-slate-900 ring-2 ring-slate-900/10' : 'border-slate-200 hover:border-slate-400' %> p-5 transition flex flex-col justify-between select-none"
          data-id="<%= service.id %>"
          data-title="<%= service.title %>"
          data-price="<%= service.price %>"
          data-selected="<%= idx === 0 ? 'true' : 'false' %>">

          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="method-check inline-flex items-center gap-1.5 text-xs font-bold <%= idx === 0 ? 'text-emerald-700' : 'text-slate-400' %>">
                <i class="<%= idx === 0 ? 'fa-solid fa-circle-check text-emerald-600' : 'fa-regular fa-circle text-slate-300' %> text-base"></i>
                <span class="method-check-label"><%= idx === 0 ? 'Selected' : 'Select' %></span>
              </span>
              <span class="text-xl font-extrabold text-slate-900 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-lg">
                $<%= Number.isInteger(service.price) ? service.price : service.price.toFixed(2) %>
              </span>
            </div>

            <h3 class="font-extrabold text-slate-900 text-base leading-snug mb-2">
              <%= service.title %>
            </h3>

            <div class="px-3 py-2 rounded-xl bg-slate-900 text-white text-xs font-semibold flex items-center justify-between gap-2 mb-3">
              <span class="text-slate-400">Cost:</span>
              <span class="text-emerald-400 font-bold text-right"><%= service.unitCost || 'Ready to use' %></span>
            </div>

            <p class="text-xs text-slate-500 leading-relaxed">
              <i class="fa-solid fa-display text-indigo-600 mr-1"></i>
              Live screen-share demo included — I show you how it works!
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-semibold text-slate-500">
            <span><%= service.durationLabel || 'Ready to use' %></span>
            <span class="text-emerald-700">Binance / BEP20</span>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>

<!-- STEP 2: Simple Binance Payment Checkout (Pay ID & USDT BEP20) -->
<section id="checkout" class="max-w-4xl mx-auto px-4 sm:px-6 py-6">
  <div class="bg-white rounded-3xl border border-slate-200/90 p-6 sm:p-8 shadow-sm space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700">Step 2</span>
        <h2 class="text-xl font-extrabold text-slate-900">Pay via Binance (Pay ID or USDT BEP20)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Send the exact total below, then submit your Order ID / TxID to get instant confirmation &amp; screen-share.</p>
      </div>
      <div class="bg-slate-900 text-white px-5 py-3 rounded-2xl text-right shrink-0">
        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold block">Total to Pay</span>
        <div id="checkout-total-display" class="text-2xl font-extrabold text-[#F0B90B]">$10.00 USDT</div>
      </div>
    </div>

    <!-- Selected Items Summary -->
    <div id="selected-items-summary" class="flex flex-wrap items-center gap-2 text-xs"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Left: Payment Method Selector (Binance Pay ID vs USDT BEP20) -->
      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-2 p-1 bg-slate-100 rounded-xl text-xs font-bold">
          <button type="button" id="tab-binance-pay" class="pay-tab py-2.5 px-3 rounded-lg bg-slate-900 text-white transition flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-bolt text-[#F0B90B]"></i>
            <span>Binance Pay ID</span>
          </button>
          <button type="button" id="tab-usdt-bep20" class="pay-tab py-2.5 px-3 rounded-lg text-slate-600 hover:text-slate-900 transition flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-coins text-amber-500"></i>
            <span>USDT BEP20</span>
          </button>
        </div>

        <!-- Panel 1: Binance Pay ID -->
        <div id="panel-binance-pay" class="p-5 rounded-2xl bg-amber-50/70 border border-amber-200 space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="font-extrabold text-amber-900">Binance Pay ID</span>
            <span class="text-[11px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">0% Fee • Instant</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Open Binance App &rarr; <strong>Pay</strong> &rarr; <strong>Send</strong> &rarr; paste the Pay ID below and send the exact USDT total.
          </p>
          <div class="flex items-center justify-between gap-2 bg-white px-3.5 py-3 rounded-xl border border-amber-200">
            <code id="checkout-binance-id" class="font-mono font-extrabold text-base text-slate-900 select-all"><%= typeof platformBinancePayId !== 'undefined' ? platformBinancePayId : '1229901779' %></code>
            <button type="button" onclick="window.copyVal('checkout-binance-id', 'Binance Pay ID')" class="px-3 py-1.5 rounded-lg bg-[#F0B90B] hover:bg-[#FCD535] text-slate-950 font-bold text-xs transition shrink-0">
              Copy ID
            </button>
          </div>
          <a href="bnc://app.binance.com/home/main" onclick="window.copyVal('checkout-binance-id', 'Binance Pay ID')" class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-mobile-screen-button"></i>
            <span>Copy ID &amp; Open Binance App</span>
          </a>
        </div>

        <!-- Panel 2: USDT BEP20 -->
        <div id="panel-usdt-bep20" class="hidden p-5 rounded-2xl bg-[#FAFAFA] border border-slate-200 space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="font-extrabold text-slate-900">USDT BEP20 Address</span>
            <span class="text-[11px] font-bold bg-amber-100 text-amber-900 px-2 py-0.5 rounded-full">BNB Smart Chain (BSC)</span>
          </div>
          <% if (typeof bep20QrDataUrl !== 'undefined' && bep20QrDataUrl) { %>
            <div class="flex justify-center">
              <div class="bg-white p-2 rounded-xl border border-slate-200">
                <img src="<%= bep20QrDataUrl %>" alt="USDT BEP20 QR Code" class="w-32 h-32 object-contain">
              </div>
            </div>
          <% } %>
          <div class="flex items-center justify-between gap-2 bg-white px-3 py-2.5 rounded-xl border border-slate-200">
            <code id="checkout-bep20-addr" class="font-mono font-bold text-xs text-slate-900 truncate select-all"><%= typeof bep20Address !== 'undefined' ? bep20Address : '0x284b2c731c9a9449f88f42bc707c05511bb9b222' %></code>
            <button type="button" onclick="window.copyVal('checkout-bep20-addr', 'USDT BEP20 Address')" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition shrink-0">
              Copy
            </button>
          </div>
          <p class="text-[11px] text-slate-500">
            Make sure to select <strong>BNB Smart Chain (BEP20)</strong> when sending USDT.
          </p>
        </div>
      </div>

      <!-- Right: Confirm Order Form -->
      <div class="space-y-4">
        <form id="store-order-form" class="space-y-3.5">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Your Contact (WhatsApp, Telegram, or Email)</label>
            <input type="text" id="order-contact" required value="<%= user ? user.email : '' %>" placeholder="e.g. +216... or @username or email@..." class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Binance Order ID or BEP20 TxID</label>
            <input type="text" id="order-txid" required placeholder="Paste your Binance Order ID or 0x... TxHash" class="w-full text-sm font-mono px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Note (Optional — e.g. preferred time for screen-share)</label>
            <input type="text" id="order-note" placeholder="Ready now for screen-share demo..." class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
          </div>

          <button type="submit" id="order-submit-btn" class="w-full py-3 px-4 rounded-xl bg-[#F0B90B] hover:bg-[#FCD535] text-slate-950 font-extrabold text-sm transition shadow-sm flex items-center justify-center gap-2">
            <i class="fa-solid fa-check-circle"></i>
            <span>Confirm Binance Payment &amp; Submit Order</span>
          </button>
        </form>

        <!-- Success Confirmation Box -->
        <div id="order-success-box" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-3">
          <div class="flex items-center gap-2 text-emerald-800 font-extrabold text-sm">
            <i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>
            <span>Order Submitted Successfully!</span>
          </div>
          <p id="order-success-text" class="text-xs text-emerald-900 leading-relaxed"></p>
          <div class="flex flex-wrap gap-2">
            <a id="order-success-wa" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs transition">
              <i class="fa-brands fa-whatsapp text-sm"></i> Send Order on WhatsApp
            </a>
            <a href="/chat?support=1" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition">
              <i class="fa-regular fa-comments"></i> Open DM Chat
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>



<script>
  // Copy helper
  window.copyVal = function(elementId, label) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const val = el.textContent.trim();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(val).then(() => {
        if (window.showToast) window.showToast(`${label} copied!`, 'success');
      }).catch(() => {});
    }
  };

  // Multi-select Method Cards & Live Total
  const cards = Array.from(document.querySelectorAll('.method-select-card'));
  const totalDisplay = document.getElementById('checkout-total-display');
  const summaryEl = document.getElementById('selected-items-summary');
  const jumpCheckoutBtn = document.getElementById('jump-checkout-btn');
  const methodSearchInput = document.getElementById('method-search-input');
  let activePaymentMethod = 'BINANCE_PAY';

  if (methodSearchInput) {
    methodSearchInput.addEventListener('input', () => {
      const q = methodSearchInput.value.toLowerCase().trim();
      cards.forEach(card => {
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        card.style.display = (!q || title.includes(q)) ? 'flex' : 'none';
      });
    });
  }

  function getSelectedItems() {
    return cards
      .filter(c => c.getAttribute('data-selected') === 'true')
      .map(c => ({
        id: c.getAttribute('data-id'),
        title: c.getAttribute('data-title'),
        price: parseFloat(c.getAttribute('data-price')) || 0
      }));
  }

  function renderCart() {
    const selected = getSelectedItems();
    const total = selected.reduce((s, item) => s + item.price, 0);
    if (totalDisplay) totalDisplay.textContent = `$${total.toFixed(2)} USDT`;
    if (jumpCheckoutBtn) jumpCheckoutBtn.textContent = `Pay (${selected.length} • $${total.toFixed(0)}) ↓`;

    if (summaryEl) {
      if (selected.length === 0) {
        summaryEl.innerHTML = `<span class="text-rose-600 font-semibold">Please select at least 1 method above.</span>`;
      } else {
        summaryEl.innerHTML = `<span class="text-slate-400 font-semibold">Selected:</span> ` +
          selected.map(i => `<span class="inline-flex items-center gap-1 bg-slate-100 text-slate-800 font-bold px-2.5 py-1 rounded-lg">${i.title} <span class="text-emerald-700">$${i.price.toFixed(0)}</span></span>`).join('');
      }
    }

    cards.forEach(card => {
      const isSel = card.getAttribute('data-selected') === 'true';
      const icon = card.querySelector('.method-check i');
      const label = card.querySelector('.method-check-label');
      const checkWrap = card.querySelector('.method-check');

      card.classList.toggle('border-slate-900', isSel);
      card.classList.toggle('ring-2', isSel);
      card.classList.toggle('ring-slate-900/10', isSel);
      card.classList.toggle('border-slate-200', !isSel);

      if (icon) {
        icon.className = isSel
          ? 'fa-solid fa-circle-check text-emerald-600 text-base'
          : 'fa-regular fa-circle text-slate-300 text-base';
      }
      if (label) label.textContent = isSel ? 'Selected' : 'Select';
      if (checkWrap) {
        checkWrap.classList.toggle('text-emerald-700', isSel);
        checkWrap.classList.toggle('text-slate-400', !isSel);
      }
    });
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const current = card.getAttribute('data-selected') === 'true';
      card.setAttribute('data-selected', current ? 'false' : 'true');
      renderCart();
    });
  });

  renderCart();

  // Payment Method Tabs (Binance Pay ID vs USDT BEP20)
  const tabBinancePay = document.getElementById('tab-binance-pay');
  const tabUsdtBep20 = document.getElementById('tab-usdt-bep20');
  const panelBinancePay = document.getElementById('panel-binance-pay');
  const panelUsdtBep20 = document.getElementById('panel-usdt-bep20');

  function setPaymentTab(method) {
    activePaymentMethod = method;
    const isPay = method === 'BINANCE_PAY';
    tabBinancePay.className = `pay-tab py-2.5 px-3 rounded-lg transition flex items-center justify-center gap-1.5 ${isPay ? 'bg-slate-900 text-white' : 'text-slate-600 hover:text-slate-900'}`;
    tabUsdtBep20.className = `pay-tab py-2.5 px-3 rounded-lg transition flex items-center justify-center gap-1.5 ${!isPay ? 'bg-slate-900 text-white' : 'text-slate-600 hover:text-slate-900'}`;
    panelBinancePay.classList.toggle('hidden', !isPay);
    panelUsdtBep20.classList.toggle('hidden', isPay);
  }

  if (tabBinancePay) tabBinancePay.addEventListener('click', () => setPaymentTab('BINANCE_PAY'));
  if (tabUsdtBep20) tabUsdtBep20.addEventListener('click', () => setPaymentTab('USDT_BEP20'));

  // Submit Binance Order
  const orderForm = document.getElementById('store-order-form');
  if (orderForm) {
    orderForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const selected = getSelectedItems();
      if (selected.length === 0) {
        if (window.showToast) window.showToast('Please select at least one method first.', 'error');
        return;
      }

      const customerContact = document.getElementById('order-contact').value.trim();
      const txId = document.getElementById('order-txid').value.trim();
      const note = document.getElementById('order-note').value.trim();
      const btn = document.getElementById('order-submit-btn');

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';

      try {
        const res = await fetch('/api/store/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            serviceIds: selected.map(s => s.id),
            paymentMethod: activePaymentMethod,
            txId,
            customerContact,
            note
          })
        });
        const data = await res.json();
        if (data.success && data.order) {
          const ord = data.order;
          const itemsList = ord.items.map(i => `${i.title} ($${i.price})`).join(', ');
          document.getElementById('order-success-text').textContent =
            `Order #${ord.id} received for ${itemsList} — Total: $${ord.totalAmount.toFixed(2)} USDT via ${ord.paymentMethod} (TxID: ${ord.txId}). Status: ${ord.status}.`;
          const waMsg = `Hello @Melasbit! Order #${ord.id}\nMethods: ${itemsList}\nTotal: $${ord.totalAmount.toFixed(2)} USDT (${ord.paymentMethod})\nTxID / Order ID: ${ord.txId}\nContact: ${ord.customerContact}\nReady for screen-share!`;
          document.getElementById('order-success-wa').href = `https://wa.me/21627076373?text=${encodeURIComponent(waMsg)}`;
          document.getElementById('order-success-box').classList.remove('hidden');
          document.getElementById('order-txid').value = '';
          if (window.showToast) window.showToast('Order submitted! @Melasbit has been notified.', 'success');
        } else {
          if (window.showToast) window.showToast(data.error || 'Error submitting order', 'error');
        }
      } catch (err) {
        if (window.showToast) window.showToast('Network error. Please try again.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-check-circle"></i> <span>Confirm Binance Payment &amp; Submit Order</span>';
      }
    });
  }

  // Submit Exchange Request
  const exchForm = document.getElementById('exchange-form');
  if (exchForm) {
    exchForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const senderName = document.getElementById('exch-name').value.trim();
      const contact = document.getElementById('exch-contact').value.trim();
      const offeredMethod = document.getElementById('exch-offered').value.trim();
      const details = document.getElementById('exch-details').value.trim();
      const wantedMethods = Array.from(exchForm.querySelectorAll('input[name="wanted"]:checked')).map(cb => cb.value);
      const btn = document.getElementById('exch-submit-btn');

      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending...';

      try {
        const res = await fetch('/api/store/exchange', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ senderName, contact, offeredMethod, wantedMethods, details })
        });
        const data = await res.json();
        if (data.success) {
          const waMsg = `Hello @Melasbit! Method Exchange Request:\nFrom: ${senderName} (${contact})\nI Offer: ${offeredMethod}\nI Want: ${wantedMethods.join(', ') || 'Any method'}${details ? '\nDetails: ' + details : ''}`;
          document.getElementById('exch-success-wa').href = `https://wa.me/21627076373?text=${encodeURIComponent(waMsg)}`;
          document.getElementById('exch-success-box').classList.remove('hidden');
          exchForm.reset();
          if (window.showToast) window.showToast('Exchange request submitted!', 'success');
        } else {
          if (window.showToast) window.showToast(data.error || 'Error submitting exchange request', 'error');
        }
      } catch (err) {
        if (window.showToast) window.showToast('Network error. Please try again.', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> <span>Submit Exchange Request</span>';
      }
    });
  }
</script>


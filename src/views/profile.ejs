<%- include('partials/header', { title: profile.name }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">

  <!-- Minimalist Author Header -->
  <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/90 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="flex items-center gap-4 min-w-0">
      <img src="<%= profile.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + profile.name %>" class="w-16 h-16 rounded-full border border-slate-200 object-cover flex-shrink-0">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h1 class="text-xl font-extrabold text-slate-900 truncate"><%= profile.name %></h1>
          <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">Verified</span>
        </div>
        <% if (profile.bio) { %>
          <p class="text-xs text-slate-500 mt-1 max-w-xl leading-relaxed"><%= profile.bio %></p>
        <% } %>
      </div>
    </div>

    <% if (!user || user.id !== profile.id) { %>
      <a href="/chat?recipientId=<%= profile.id %>" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-xl transition flex items-center gap-2 flex-shrink-0">
        <i class="fa-regular fa-comment"></i>
        <span>Message Author</span>
      </a>
    <% } %>
  </div>

  <!-- Published Methods -->
  <div class="space-y-4">
    <h2 class="text-sm font-bold text-slate-900">Published Methods (<%= services.length %>)</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% if (services && services.length > 0) { %>
        <% services.forEach(service => { %>
          <a href="/services/<%= service.id %>" class="bg-white rounded-2xl border border-slate-200/90 p-5 hover:border-slate-400 transition flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2">
                <span class="truncate"><%= service.category %></span>
                <span class="font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded">PDF • ZIP</span>
              </div>
              <h3 class="font-bold text-slate-900 text-sm mb-2 line-clamp-2 group-hover:text-emerald-700 transition"><%= service.title %></h3>
              <p class="text-slate-500 text-xs line-clamp-2 mb-4 leading-relaxed"><%= service.description %></p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-sm font-bold text-slate-900"><%= service.price.toFixed(0) %> <span class="text-xs text-slate-500">USDT</span></span>
              <span class="text-xs font-semibold text-slate-700 group-hover:translate-x-0.5 transition">View →</span>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <p class="text-xs text-slate-400 py-6">No methods published yet.</p>
      <% } %>
    </div>
  </div>

  <!-- Client Reviews -->
  <div class="space-y-4">
    <h2 class="text-sm font-bold text-slate-900">Reviews (<%= reviews.length %>)</h2>

    <% if (reviews && reviews.length > 0) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% reviews.forEach(r => { %>
          <div class="bg-white p-5 rounded-2xl border border-slate-200/90 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-900"><%= r.buyerName %></span>
              <div class="flex items-center text-amber-400 text-xs">
                <% for (let i = 0; i < r.rating; i++) { %><i class="fa-solid fa-star"></i><% } %>
              </div>
            </div>
            <p class="text-xs text-slate-600">"<%= r.comment %>"</p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-8 bg-white rounded-2xl border border-slate-200/90 text-xs text-slate-400">
        No reviews yet.
      </div>
    <% } %>
  </div>

</div>

<%- include('partials/footer') %>

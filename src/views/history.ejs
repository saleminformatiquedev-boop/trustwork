<%- include('partials/header', { title: 'Order History' }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-6">

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">Order History</h1>
      <p class="text-xs text-slate-500 mt-0.5">Track all your purchases and sales.</p>
    </div>

    <div class="flex gap-1 bg-slate-200/70 p-1 rounded-xl text-xs font-semibold self-start">
      <button class="hist-tab-btn active px-3 py-1.5 rounded-lg bg-white text-slate-900 shadow-xs transition" data-target="tab-all">All</button>
      <button class="hist-tab-btn px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition" data-target="tab-buyer">Purchases (<%= buyerHistory.length %>)</button>
      <button class="hist-tab-btn px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition" data-target="tab-seller">Sales (<%= sellerHistory.length %>)</button>
    </div>
  </div>

  <!-- Purchases -->
  <div id="tab-buyer" class="hist-section bg-white rounded-2xl border border-slate-200/90 overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-100 text-xs font-bold text-slate-400 uppercase tracking-wider">
      Purchases (<%= buyerHistory.length %>)
    </div>
    <div class="divide-y divide-slate-100">
      <% if (buyerHistory && buyerHistory.length > 0) { %>
        <% buyerHistory.forEach(ord => { %>
          <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between gap-4 hover:bg-slate-50 transition block">
            <div class="min-w-0">
              <div class="text-xs text-slate-400">Author: <%= ord.sellerName %></div>
              <h4 class="text-sm font-bold text-slate-900 truncate mt-0.5"><%= ord.serviceTitle %></h4>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <span class="text-xs font-bold text-slate-900"><%= ord.amount.toFixed(2) %> USDT</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                <%= ord.status === 'COMPLETED' ? 'Completed' : 'Active' %>
              </span>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="text-center py-10 text-slate-400 text-xs">No purchases yet.</div>
      <% } %>
    </div>
  </div>

  <!-- Sales -->
  <div id="tab-seller" class="hist-section bg-white rounded-2xl border border-slate-200/90 overflow-hidden">
    <div class="px-5 py-3.5 border-b border-slate-100 text-xs font-bold text-slate-400 uppercase tracking-wider">
      Sales (<%= sellerHistory.length %>)
    </div>
    <div class="divide-y divide-slate-100">
      <% if (sellerHistory && sellerHistory.length > 0) { %>
        <% sellerHistory.forEach(ord => { %>
          <a href="/orders/<%= ord.id %>" class="p-5 flex items-center justify-between gap-4 hover:bg-slate-50 transition block">
            <div class="min-w-0">
              <div class="text-xs text-slate-400">Buyer: <%= ord.buyerName %></div>
              <h4 class="text-sm font-bold text-slate-900 truncate mt-0.5"><%= ord.serviceTitle %></h4>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <span class="text-xs font-bold text-emerald-600">+<%= ord.amount.toFixed(2) %> USDT</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= ord.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                <%= ord.status === 'COMPLETED' ? 'Paid' : 'Active' %>
              </span>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="text-center py-10 text-slate-400 text-xs">No sales yet.</div>
      <% } %>
    </div>
  </div>

</div>

<script>
  const tabBtns = document.querySelectorAll('.hist-tab-btn');
  const sections = document.querySelectorAll('.hist-section');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('bg-white', 'text-slate-900', 'shadow-xs');
        b.classList.add('text-slate-600');
      });
      btn.classList.add('bg-white', 'text-slate-900', 'shadow-xs');
      btn.classList.remove('text-slate-600');
      const target = btn.dataset.target;
      sections.forEach(s => {
        s.style.display = (target === 'tab-all' || s.id === target) ? 'block' : 'none';
      });
    });
  });
</script>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Sign In' }) %>

<div class="max-w-sm mx-auto px-4 py-16">
  
  <div class="bg-white p-7 rounded-2xl border border-slate-200/90 text-center">
    
    <div class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center text-sm mx-auto mb-4">
      <i class="fa-solid fa-layer-group"></i>
    </div>

    <h1 class="text-lg font-extrabold text-slate-900 mb-1">Sign in to TrustWork</h1>
    <p class="text-xs text-slate-500 mb-6">
      Buy and sell developer PDF & ZIP methods with guaranteed escrow.
    </p>

    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="mb-5 p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800 text-left">
        <%= msg %>
      </div>
    <% } %>

    <button type="button" id="google-signin-btn" class="disabled:opacity-60 disabled:cursor-wait w-full flex items-center justify-center gap-2.5 py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs sm:text-sm rounded-xl transition">
      <svg class="w-4 h-4 bg-white rounded-full p-0.5" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      <span id="google-signin-label">Continue with Google</span>
    </button>

    <div id="login-error" class="hidden mt-3 p-3 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700 text-left"></div>

    <% if (typeof demoModeEnabled !== 'undefined' && demoModeEnabled) { %>
      <div class="relative flex items-center justify-center my-5">
        <div class="border-t border-slate-100 w-full"></div>
        <span class="bg-white px-3 text-[10px] uppercase tracking-wider text-slate-400 font-semibold absolute">
          Isolated Demo Sandbox
        </span>
      </div>

      <div class="space-y-2 text-left text-xs">
        <a href="/auth/demo-login/buyer" class="flex items-center justify-between p-3 rounded-xl bg-[#FAFAFA] hover:bg-slate-100 border border-slate-200/80 transition">
          <div>
            <div class="font-bold text-slate-900">Thomas — Buyer (Demo)</div>
            <div class="text-[11px] text-slate-400">Can only transact & chat with demo accounts</div>
          </div>
          <i class="fa-solid fa-arrow-right text-[10px] text-slate-400"></i>
        </a>

        <a href="/auth/demo-login/seller" class="flex items-center justify-between p-3 rounded-xl bg-[#FAFAFA] hover:bg-slate-100 border border-slate-200/80 transition">
          <div>
            <div class="font-bold text-slate-900">Sarah — Seller (Demo)</div>
            <div class="text-[11px] text-slate-400">Demo Method Author</div>
          </div>
          <i class="fa-solid fa-arrow-right text-[10px] text-slate-400"></i>
        </a>

        <a href="/auth/demo-login/admin" class="flex items-center justify-between p-3 rounded-xl bg-[#FAFAFA] hover:bg-slate-100 border border-slate-200/80 transition">
          <div>
            <div class="font-bold text-slate-900">Support — Admin (Demo)</div>
            <div class="text-[11px] text-slate-400">Manages demo disputes only</div>
          </div>
          <i class="fa-solid fa-arrow-right text-[10px] text-slate-400"></i>
        </a>
      </div>
    <% } %>

    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-center gap-1.5 text-[11px] text-slate-400">
      <i class="fa-solid fa-lock text-emerald-600"></i>
      <span>Protected by Google OAuth 2.0 & Escrow Security</span>
    </div>

  </div>

</div>


<script type="module">
  import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js';
  import {
    getAuth, GoogleAuthProvider, signInWithPopup, signInWithRedirect, getRedirectResult
  } from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js';

  const firebaseConfig = <%- JSON.stringify(typeof firebaseConfig !== 'undefined' ? firebaseConfig : {}).replace(/</g, '\\u003c') %>;
  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();
  provider.setCustomParameters({ prompt: 'select_account' });

  const btn = document.getElementById('google-signin-btn');
  const label = document.getElementById('google-signin-label');
  const errBox = document.getElementById('login-error');
  const csrf = document.querySelector('meta[name="csrf-token"]')?.content || '';

  function showError(msg) {
    errBox.textContent = msg;
    errBox.classList.remove('hidden');
  }
  function setBusy(busy) {
    btn.disabled = busy;
    label.textContent = busy ? 'Signing in…' : 'Continue with Google';
  }

  // Exchange the verified Google/Firebase identity for a TrustWork server session
  async function completeLogin(user) {
    const idToken = await user.getIdToken(true);
    const resp = await fetch('/auth/firebase-google', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf, 'Accept': 'application/json' },
      body: JSON.stringify({ idToken })
    });
    const data = await resp.json().catch(() => ({}));
    if (!resp.ok || !data.success) {
      throw new Error(data.error || 'Sign-in failed. Please try again.');
    }
    sessionStorage.removeItem('tw_redirect_tried');
    window.location.href = data.redirectUrl || '/dashboard';
  }

  function friendlyError(e) {
    switch (e && e.code) {
      case 'auth/popup-closed-by-user':
      case 'auth/cancelled-popup-request': return null; // user just closed the window
      case 'auth/unauthorized-domain': return 'This domain is not authorized for Google sign-in yet.';
      case 'auth/operation-not-allowed': return 'Google sign-in is not enabled for this project yet.';
      case 'auth/network-request-failed': return 'Network error. Check your connection and try again.';
      default: return (e && e.message) ? e.message.replace(/^Firebase:\s*/, '') : 'Sign-in failed. Please try again.';
    }
  }

  // Find out which Google service the device/network cannot reach (ad-blocker, Private DNS, VPN, captive Wi-Fi...)
  async function findBlockedHosts() {
    const targets = {
      'apis.google.com': 'https://apis.google.com/js/api.js',
      'salemsaccounts.firebaseapp.com': 'https://salemsaccounts.firebaseapp.com/__/auth/iframe',
      'identitytoolkit.googleapis.com': 'https://identitytoolkit.googleapis.com/',
      'accounts.google.com': 'https://accounts.google.com/gsi/client'
    };
    const blocked = [];
    await Promise.all(Object.entries(targets).map(async ([host, url]) => {
      try {
        const ctl = new AbortController();
        const t = setTimeout(() => ctl.abort(), 8000);
        await fetch(url, { mode: 'no-cors', cache: 'no-store', signal: ctl.signal });
        clearTimeout(t);
      } catch (_) { blocked.push(host); }
    }));
    return blocked;
  }

  btn.addEventListener('click', async () => {
    errBox.classList.add('hidden');
    setBusy(true);
    try {
      const result = await signInWithPopup(auth, provider);
      await completeLogin(result.user);
    } catch (e) {
      if (e && (e.code === 'auth/popup-blocked' || e.code === 'auth/operation-not-supported-in-this-environment')) {
        try { await signInWithRedirect(auth, provider); return; } catch (e2) { e = e2; }
      }
      if (e && e.code === 'auth/network-request-failed') {
        const blocked = await findBlockedHosts();
        if (blocked.length > 0) {
          showError('Network error: your device or network is blocking ' + blocked.join(', ') +
            '. Turn off any ad-blocker, Private DNS or VPN (or switch between Wi-Fi and mobile data), then try again.');
          setBusy(false);
          return;
        }
        // Everything is reachable: retry once using the full-page redirect flow instead of a popup
        if (!sessionStorage.getItem('tw_redirect_tried')) {
          sessionStorage.setItem('tw_redirect_tried', '1');
          try { await signInWithRedirect(auth, provider); return; } catch (e2) { e = e2; }
        }
      }
      const msg = friendlyError(e);
      if (msg) showError(msg);
      setBusy(false);
    }
  });

  // Finish a redirect-based sign-in (used when the browser blocks popups)
  getRedirectResult(auth).then(async (result) => {
    if (result && result.user) {
      setBusy(true);
      try { await completeLogin(result.user); }
      catch (e) { showError(friendlyError(e) || 'Sign-in failed.'); setBusy(false); }
    }
  }).catch((e) => { const m = friendlyError(e); if (m) showError(m); });
</script>

<%- include('partials/footer') %>

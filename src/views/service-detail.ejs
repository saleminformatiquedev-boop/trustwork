<%- include('partials/header', { title: service.title }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
  
  <a href="/" class="inline-flex items-center gap-2 text-xs font-medium text-slate-500 hover:text-slate-900 mb-6 transition">
    <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to catalog
  </a>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
    
    <!-- Main Column: Method Overview -->
    <div class="lg:col-span-2 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/90 space-y-6">
      
      <div>
        <span class="text-xs font-medium text-slate-400"><%= service.category %> • <%= service.pageCount || 40 %> pages • <%= service.difficulty || 'Intermediate' %></span>
        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-1.5 leading-snug">
          <%= service.title %>
        </h1>
      </div>

      <!-- Author & Direct Contact -->
      <div class="flex items-center justify-between py-4 border-y border-slate-100 gap-4">
        <a href="/profile/<%= service.sellerId %>" class="flex items-center gap-3 min-w-0 group">
          <img src="<%= service.sellerAvatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + service.sellerName %>" class="w-10 h-10 rounded-full border border-slate-200 object-cover flex-shrink-0">
          <div class="min-w-0">
            <div class="font-semibold text-slate-900 text-sm group-hover:underline truncate"><%= service.sellerName %></div>
            <div class="text-xs text-slate-400 truncate"><%= service.sellerBio || 'Verified Author' %></div>
          </div>
        </a>
        <a href="/chat?recipientId=<%= service.sellerId %>&serviceId=<%= service.id %>" class="text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 flex-shrink-0">
          <i class="fa-regular fa-comment"></i> Message Author
        </a>
      </div>

      <!-- Syllabus / Description -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">What You Will Learn & Build</h2>
        <div class="text-slate-700 text-sm leading-relaxed whitespace-pre-line">
          <%= service.description %>
        </div>
      </div>

      <!-- Included Files -->
      <div class="pt-4 border-t border-slate-100">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Included in This Package</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200/80">
            <i class="fa-solid fa-file-pdf text-rose-500 mb-1 block"></i>
            <strong class="text-slate-800 block">PDF Guide</strong>
            <span class="text-slate-400 text-[11px]"><%= service.pageCount || 40 %> pages</span>
          </div>
          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200/80">
            <i class="fa-solid fa-file-zipper text-amber-500 mb-1 block"></i>
            <strong class="text-slate-800 block">ZIP Archive</strong>
            <span class="text-slate-400 text-[11px]">Code & templates</span>
          </div>
          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200/80">
            <i class="fa-solid fa-terminal text-blue-500 mb-1 block"></i>
            <strong class="text-slate-800 block">TXT Scripts</strong>
            <span class="text-slate-400 text-[11px]">Ready commands</span>
          </div>
          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200/80">
            <i class="fa-solid fa-play text-purple-500 mb-1 block"></i>
            <strong class="text-slate-800 block">Video</strong>
            <span class="text-slate-400 text-[11px]">Walkthrough</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Side Column: Instant Escrow Checkout -->
    <div class="lg:col-span-1 bg-white p-6 rounded-2xl border border-slate-200/90 sticky top-24 space-y-5">
      
      <div>
        <span class="text-xs text-slate-400 font-medium">Instant full package access</span>
        <div class="text-3xl font-extrabold text-slate-900 mt-0.5">
          <%= service.price.toFixed(2) %> <span class="text-sm font-semibold text-slate-500">USDT</span>
        </div>
      </div>

      <% if (user) { %>
        <% if (user.id === service.sellerId) { %>
          <div class="p-3 bg-slate-100 rounded-xl text-xs text-slate-600 text-center font-medium">
            You are the author of this method.
          </div>
        <% } else { %>
          <form action="/orders/create" method="POST" class="space-y-3">
            <input type="hidden" name="serviceId" value="<%= service.id %>">
            <input type="hidden" name="requirements" value="Instant purchase of package: <%= service.title %>">

            <button type="submit" <%= user.walletBalance < service.price ? 'disabled' : '' %> class="w-full py-3 px-4 bg-slate-900 hover:bg-slate-800 disabled:bg-slate-200 disabled:text-slate-400 text-white font-semibold text-sm rounded-xl transition flex items-center justify-center gap-2">
              <span>Buy & Download Now</span>
            </button>

            <div class="flex items-center justify-between text-xs text-slate-500 pt-1">
              <span>Your balance:</span>
              <span class="font-semibold <%= user.walletBalance >= service.price ? 'text-emerald-600' : 'text-rose-600' %>">
                <%= user.walletBalance.toFixed(2) %> USDT
              </span>
            </div>

            <% if (user.walletBalance < service.price) { %>
              <a href="/dashboard" class="block text-center text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 py-2 rounded-lg transition">
                Top up balance via Binance Pay →
              </a>
            <% } %>
          </form>
        <% } %>
      <% } else { %>
        <a href="/login" class="w-full inline-flex items-center justify-center py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm rounded-xl transition">
          Sign in to purchase
        </a>
      <% } %>

      <div class="pt-4 border-t border-slate-100 space-y-3 text-xs text-slate-500 leading-relaxed">
        <div class="flex items-start gap-2">
          <i class="fa-solid fa-shield-halved text-emerald-600 mt-0.5"></i>
          <span><strong>Escrow protection:</strong> your USDT stays safely locked until you download and approve the files.</span>
        </div>
        <div class="p-3 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-900 flex items-start gap-2">
          <i class="fa-regular fa-clock text-amber-600 mt-0.5 shrink-0"></i>
          <span><strong>Only 2 days to validate:</strong> You have <strong>2 days (48 hours)</strong> to validate if the method is good or not. After 2 days, the review will be for the <strong>Admin</strong>.</span>
        </div>
      </div>

    </div>

  </div>

</div>

<%- include('partials/footer') %>

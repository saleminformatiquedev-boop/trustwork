<%- include('partials/header', { title: service.title }) %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
  
  <!-- Fil d'ariane & retour -->
  <div class="flex items-center justify-between gap-3 mb-6">
    <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-emerald-600 transition bg-white px-3 py-1.5 rounded-lg border border-slate-200 shadow-sm">
      <i class="fa-solid fa-arrow-left text-[10px]"></i> Retour aux guides
    </a>
    <span class="text-[11px] font-semibold text-slate-400">Réf: #<%= service.id %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
    
    <!-- Colonne Principale (2/3) : Détails de la Méthode PDF -->
    <div class="lg:col-span-2 space-y-6">
      
      <div class="bg-white p-5 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        
        <!-- Catégorie & Badge Format PDF -->
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full border border-emerald-100">
            <i class="fa-solid fa-tag text-[10px]"></i> <%= service.category %>
          </span>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-full border border-rose-200">
              <i class="fa-solid fa-file-pdf text-rose-600"></i> Format PDF
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-slate-50 px-2.5 py-1 rounded-full border border-slate-200">
              <i class="fa-solid fa-shield-halved text-emerald-600"></i> Séquestre Garanti
            </span>
          </div>
        </div>

        <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 leading-tight mb-6">
          <%= service.title %>
        </h1>

        <!-- Spécifications techniques du document -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-xl bg-slate-50 border border-slate-200 mb-6 text-xs">
          <div>
            <span class="text-[10px] uppercase font-bold text-slate-400 block">Nombre de pages</span>
            <strong class="text-slate-800 text-sm"><%= service.pageCount || 42 %> pages</strong>
          </div>
          <div>
            <span class="text-[10px] uppercase font-bold text-slate-400 block">Niveau requis</span>
            <strong class="text-slate-800 text-sm"><%= service.difficulty || 'Intermédiaire' %></strong>
          </div>
          <div>
            <span class="text-[10px] uppercase font-bold text-slate-400 block">Taille du fichier</span>
            <strong class="text-slate-800 text-sm"><%= service.fileSize || '2.4 Mo' %></strong>
          </div>
          <div>
            <span class="text-[10px] uppercase font-bold text-slate-400 block">Livraison</span>
            <strong class="text-emerald-700 text-sm font-bold flex items-center gap-1">
              <i class="fa-solid fa-bolt text-amber-500"></i> Immédiate
            </strong>
          </div>
        </div>

        <!-- Auteur info Pro Card -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-white border border-slate-200 mb-6 shadow-sm">
          <div class="flex items-center gap-3 min-w-0">
            <img src="<%= service.sellerAvatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + service.sellerName %>" class="w-12 h-12 rounded-full border-2 border-emerald-500 shadow-sm flex-shrink-0 object-cover">
            <div class="min-w-0">
              <h4 class="font-bold text-slate-900 text-sm truncate flex items-center gap-1.5">
                <%= service.sellerName %>
                <i class="fa-solid fa-circle-check text-emerald-500 text-xs" title="Auteur vérifié"></i>
              </h4>
              <p class="text-xs text-slate-500 truncate"><%= service.sellerBio || "Auteur expert en méthodologies logicielles" %></p>
            </div>
          </div>
          <span class="hidden sm:inline-block text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full">
            Auteur Vérifié
          </span>
        </div>

        <h3 class="font-bold text-slate-900 text-sm uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-2">
          <i class="fa-solid fa-list-check text-emerald-600"></i> Sommaire & Déroulement de la méthode
        </h3>
        <div class="text-slate-600 text-sm sm:text-base leading-relaxed whitespace-pre-line mb-8 bg-slate-50/50 p-5 rounded-xl border border-slate-100">
          <%= service.description %>
        </div>

        <!-- Fichiers et Ressources inclus dans la méthode -->
        <div class="mb-8">
          <h3 class="font-bold text-slate-900 text-sm uppercase tracking-wider text-slate-400 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-box-open text-emerald-600"></i> Ressources Incluses dans ce Pack de Méthode :
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-3">
              <span class="w-9 h-9 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center text-base flex-shrink-0">
                <i class="fa-solid fa-file-pdf"></i>
              </span>
              <div class="min-w-0">
                <strong class="text-slate-800 block truncate">Guide Écrit Pas à Pas</strong>
                <span class="text-[11px] text-slate-500">Document PDF (<%= service.pageCount || 40 %> pages)</span>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-3">
              <span class="w-9 h-9 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-base flex-shrink-0">
                <i class="fa-solid fa-file-zipper"></i>
              </span>
              <div class="min-w-0">
                <strong class="text-slate-800 block truncate">Code Source & Templates</strong>
                <span class="text-[11px] text-slate-500">Archive ZIP téléchargeable</span>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-3">
              <span class="w-9 h-9 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-base flex-shrink-0">
                <i class="fa-solid fa-file-lines"></i>
              </span>
              <div class="min-w-0">
                <strong class="text-slate-800 block truncate">Scripts Shell & Configuration</strong>
                <span class="text-[11px] text-slate-500">Fichiers texte (.txt, .sh, .env)</span>
              </div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-3">
              <span class="w-9 h-9 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center text-base flex-shrink-0">
                <i class="fa-solid fa-video"></i>
              </span>
              <div class="min-w-0">
                <strong class="text-slate-800 block truncate">Tutoriel Vidéo de Démonstration</strong>
                <span class="text-[11px] text-slate-500">Vidéo explicative pas à pas</span>
              </div>
            </div>

          </div>
        </div>

        <!-- Étapes de la méthode & Séquestre -->
        <div class="border-t border-slate-100 pt-6">
          <h4 class="font-bold text-slate-900 text-xs uppercase tracking-wider mb-4 text-slate-500">
            Garantie de l'acheteur en 3 étapes :
          </h4>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
              <span class="font-bold text-emerald-700 flex items-center gap-1.5 mb-1">
                <i class="fa-solid fa-lock"></i> 1. Séquestre & Téléchargement
              </span>
              <p class="text-slate-500 text-[11px] leading-relaxed">Vos USDT sont bloqués sous séquestre et le PDF se débloque immédiatement.</p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
              <span class="font-bold text-blue-700 flex items-center gap-1.5 mb-1">
                <i class="fa-solid fa-laptop-code"></i> 2. Réalisation de la tâche
              </span>
              <p class="text-slate-500 text-[11px] leading-relaxed">Vous appliquez la méthode sur votre projet en suivant les instructions pas à pas.</p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-100">
              <span class="font-bold text-purple-700 flex items-center gap-1.5 mb-1">
                <i class="fa-solid fa-circle-check"></i> 3. Validation & Support
              </span>
              <p class="text-slate-500 text-[11px] leading-relaxed">Vous validez la commande si la tâche est réussie, ou ouvrez un litige si le guide est non conforme.</p>
            </div>
          </div>
        </div>

        <!-- Box Garantie & Litige -->
        <div class="mt-6 bg-emerald-50/70 rounded-2xl p-4 sm:p-5 border border-emerald-100 flex items-start gap-3.5">
          <span class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-sm flex-shrink-0 shadow-sm">
            <i class="fa-solid fa-shield-halved"></i>
          </span>
          <div class="text-xs text-emerald-900 leading-relaxed">
            <strong class="font-bold block mb-0.5">Sécurité Anti-Déception 100% :</strong>
            Si le fichier PDF est corrompu, incomplet ou ne correspond pas au sommaire annoncé, vous pouvez ouvrir une enquête en 1 clic pour geler et récupérer vos <strong><%= service.price.toFixed(2) %> USDT</strong>.
          </div>
        </div>

      </div>

    </div>

    <!-- Colonne Latérale (1/3) : Boîte de Commande Séquestre & Téléchargement -->
    <div class="lg:col-span-1">
      <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm sticky top-20 sm:top-24 space-y-5">
        
        <!-- Prix Forfaitaire -->
        <div class="flex items-baseline justify-between pb-3 border-b border-slate-100">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Prix du Guide PDF</span>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 flex items-center gap-1.5">
            <%= service.price.toFixed(2) %> <span class="text-sm font-bold text-emerald-600">USDT</span>
          </div>
        </div>

        <!-- Détails forfait -->
        <div class="space-y-3 text-xs text-slate-600">
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fa-solid fa-file-pdf text-rose-500"></i> Format</span>
            <strong class="text-slate-900 font-semibold">Document PDF (<%= service.pageCount || 40 %> pages)</strong>
          </div>
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fa-solid fa-bolt text-amber-500"></i> Accès</span>
            <strong class="text-emerald-700 font-bold">Téléchargement immédiat</strong>
          </div>
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fa-solid fa-lock text-emerald-600"></i> Séquestre Escrow</span>
            <strong class="text-emerald-700 font-semibold">Fonds garantis</strong>
          </div>
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fa-brands fa-bitcoin text-amber-500"></i> Règlement</span>
            <strong class="text-slate-900 font-semibold">USDT / Binance Pay</strong>
          </div>
        </div>

        <% if (user) { %>
          <% if (user.id === service.sellerId) { %>
            <div class="p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800 text-center font-medium">
              <i class="fa-solid fa-circle-info mr-1"></i> Vous êtes l'auteur de ce guide PDF.
            </div>
          <% } else { %>
            <!-- Formulaire de commande instantanée avec déblocage direct -->
            <form action="/orders/create" method="POST" class="space-y-4 pt-2 border-t border-slate-100">
              <input type="hidden" name="serviceId" value="<%= service.id %>">
              <input type="hidden" name="requirements" value="Achat immédiat du Guide PDF : <%= service.title %>">

              <!-- Solde USDT interactif -->
              <div class="p-3 rounded-xl <%= user.walletBalance >= service.price ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-rose-50 text-rose-800 border border-rose-200' %> text-xs">
                <div class="flex justify-between items-center font-semibold mb-1">
                  <span>Votre solde USDT :</span>
                  <span><%= user.walletBalance.toFixed(2) %> USDT</span>
                </div>
                <% if (user.walletBalance < service.price) { %>
                  <p class="text-[11px] text-rose-700 mt-1">Solde insuffisant pour obtenir le guide.</p>
                  <a href="/dashboard" class="underline font-bold text-[11px] block mt-1 hover:text-rose-900">Recharger via Binance Pay (+50 USDT)</a>
                <% } else { %>
                  <p class="text-[10px] text-emerald-700 mt-0.5">Solde suffisant pour le téléchargement sécurisé.</p>
                <% } %>
              </div>

              <button type="submit" <%= user.walletBalance < service.price ? 'disabled' : '' %> class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-bold text-xs sm:text-sm rounded-xl shadow-md shadow-emerald-200 transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-file-arrow-down text-sm"></i> Obtenir & Télécharger le PDF (<%= service.price.toFixed(2) %> USDT)
              </button>
            </form>
          <% } %>
        <% } else { %>
          <div class="text-center pt-2 border-t border-slate-100">
            <p class="text-xs text-slate-500 mb-3">Connectez-vous pour obtenir ce guide PDF.</p>
            <a href="/login" class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm rounded-xl shadow-md transition">
              Connexion / Commencer
            </a>
          </div>
        <% } %>

      </div>
    </div>

  </div>

</div>

<%- include('partials/footer') %>

  </div>

</div>

<%- include('partials/footer') %>

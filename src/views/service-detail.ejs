<%- include('partials/header', { title: service.title }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-emerald-600 mb-6 transition">
    <i class="fa-solid fa-arrow-left"></i> Retour aux services
  </a>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Colonne Principale : Détails du service -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        <span class="inline-block text-xs font-semibold bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full mb-3">
          <%= service.category %>
        </span>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 leading-tight mb-4">
          <%= service.title %>
        </h1>

        <!-- Vendeur info -->
        <div class="flex items-center gap-3 py-4 border-y border-slate-100 mb-6">
          <img src="<%= service.sellerAvatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + service.sellerName %>" class="w-12 h-12 rounded-full border border-slate-200">
          <div>
            <h4 class="font-bold text-slate-900 text-sm"><%= service.sellerName %></h4>
            <p class="text-xs text-slate-500">Membre vérifié • Paiements via Binance Pay</p>
          </div>
        </div>

        <h3 class="font-bold text-slate-900 text-base mb-3">Description de la prestation</h3>
        <div class="text-slate-600 text-sm leading-relaxed whitespace-pre-line">
          <%= service.description %>
        </div>

        <!-- Garanties -->
        <div class="mt-8 bg-slate-50 rounded-xl p-4 border border-slate-200 flex items-start gap-3">
          <i class="fa-solid fa-shield-halved text-emerald-600 text-xl mt-0.5"></i>
          <div class="text-xs text-slate-600 leading-relaxed">
            <strong class="text-slate-900 font-semibold">Garantie Séquestre (Escrow) :</strong>
            Vos <strong><%= service.price.toFixed(2) %> USDT</strong> seront mis sous séquestre sécurisé. Le travailleur ne recevra l'argent qu'une fois que vous aurez vérifié et validé le travail livré. En cas de problème, vous pouvez ouvrir une enquête pour être remboursé.
          </div>
        </div>
      </div>
    </div>

    <!-- Colonne Latérale : Boîte de Commande Séquestre -->
    <div class="lg:col-span-1">
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm sticky top-24">
        
        <div class="flex items-baseline justify-between mb-4">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tarif Forfait</span>
          <div class="text-2xl font-black text-slate-900 flex items-center gap-1">
            <%= service.price.toFixed(2) %> <span class="text-sm font-bold text-emerald-600">USDT</span>
          </div>
        </div>

        <div class="space-y-3 py-3 border-y border-slate-100 text-xs text-slate-600 mb-6">
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fa-regular fa-clock text-slate-400"></i> Délai de livraison</span>
            <strong class="text-slate-900"><%= service.deliveryDays %> jours</strong>
          </div>
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fa-solid fa-lock text-emerald-500"></i> Protection Escrow</span>
            <strong class="text-emerald-700">100% Inclus</strong>
          </div>
          <div class="flex items-center justify-between">
            <span class="flex items-center gap-2"><i class="fa-brands fa-bitcoin text-amber-500"></i> Paiement</span>
            <strong class="text-slate-900">Binance / USDT</strong>
          </div>
        </div>

        <% if (user) { %>
          <% if (user.id === service.sellerId) { %>
            <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-800 text-center font-medium">
              C'est votre propre service.
            </div>
          <% } else { %>
            <!-- Formulaire de commande -->
            <form action="/orders/create" method="POST" class="space-y-4">
              <input type="hidden" name="serviceId" value="<%= service.id %>">
              
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">
                  Vos consignes pour le travailleur :
                </label>
                <textarea name="requirements" rows="3" required placeholder="Expliquez ce que vous souhaitez exactement..." class="w-full text-xs p-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
              </div>

              <!-- Solde check -->
              <div class="p-3 rounded-xl <%= user.walletBalance >= service.price ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-rose-50 text-rose-800 border border-rose-200' %> text-xs">
                <div class="flex justify-between items-center font-semibold mb-1">
                  <span>Votre solde USDT :</span>
                  <span><%= user.walletBalance.toFixed(2) %> USDT</span>
                </div>
                <% if (user.walletBalance < service.price) { %>
                  <p class="text-[11px] mt-1">Solde insuffisant pour bloquer les fonds.</p>
                  <a href="/dashboard" class="underline font-bold text-[11px] block mt-1">Recharger mon compte via Binance Pay</a>
                <% } %>
              </div>

              <button type="submit" <%= user.walletBalance < service.price ? 'disabled' : '' %> class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed text-white font-bold text-sm rounded-xl shadow-md shadow-emerald-200 transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-lock"></i> Bloquer les fonds & Commander
              </button>
            </form>
          <% } %>
        <% } else { %>
          <div class="text-center">
            <p class="text-xs text-slate-500 mb-3">Connectez-vous pour passer commande en toute sécurité.</p>
            <a href="/login" class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-md transition">
              Connexion / Commencer
            </a>
          </div>
        <% } %>

      </div>
    </div>

  </div>

</div>

<%- include('partials/footer') %>

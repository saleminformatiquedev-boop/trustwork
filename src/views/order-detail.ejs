<%- include('partials/header', { title: 'Commande #' + order.id }) %>

<div class="max-w-5xl mx-auto px-3 sm:px-6 lg:px-8 py-6 sm:py-10" id="order-page-root" data-order-id="<%= order.id %>">

  <!-- Order Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 sm:mb-8">
    <div>
      <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-semibold text-slate-500 mb-1">
        <a href="/dashboard" class="hover:text-emerald-600">Tableau de bord</a>
        <span>/</span>
        <span class="truncate max-w-[200px]">Commande #<%= order.id %></span>
      </div>
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 leading-snug">
        <%= order.serviceTitle %>
      </h1>
    </div>

    <!-- Dynamic Status Badge -->
    <div id="status-badge-container" class="self-start sm:self-auto">
      <% if (order.status === 'ESCROWED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-bold border border-blue-200">
          <i class="fa-solid fa-lock text-blue-500"></i> Fonds en Séquestre (<%= order.amount.toFixed(2) %> USDT)
        </span>
      <% } else if (order.status === 'DELIVERED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 text-xs font-bold border border-amber-200">
          <i class="fa-solid fa-box text-amber-500"></i> Fichiers Disponibles (En attente de validation)
        </span>
      <% } else if (order.status === 'COMPLETED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200">
          <i class="fa-solid fa-circle-check text-emerald-500"></i> Commande Validée & Payée
        </span>
      <% } else if (order.status === 'DISPUTED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-50 text-rose-700 text-xs font-bold border border-rose-200 animate-pulse">
          <i class="fa-solid fa-triangle-exclamation text-rose-500"></i> Litige & Arbitrage en cours
        </span>
      <% } else if (order.status === 'REFUNDED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 text-xs font-bold border border-slate-300">
          <i class="fa-solid fa-rotate-left"></i> Acheteur Remboursé
        </span>
      <% } %>
    </div>
  </div>

  <!-- Visual Escrow Stepper -->
  <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-200 shadow-sm mb-6 sm:mb-8 overflow-x-auto">
    <div class="grid grid-cols-4 gap-2 sm:gap-4 text-center min-w-[340px]" id="escrow-stepper">
      
      <!-- Step 1 -->
      <div class="flex flex-col items-center">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-bold text-xs sm:text-sm bg-emerald-600 text-white mb-1.5 sm:mb-2">
          <i class="fa-solid fa-lock"></i>
        </div>
        <span class="text-[11px] sm:text-xs font-bold text-slate-800">1. Séquestre</span>
        <span class="text-[9px] sm:text-[11px] text-slate-500"><%= order.amount.toFixed(2) %> USDT</span>
      </div>

      <!-- Step 2 -->
      <div class="flex flex-col items-center">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-bold text-xs sm:text-sm bg-emerald-600 text-white mb-1.5 sm:mb-2">
          <i class="fa-solid fa-file-pdf"></i>
        </div>
        <span class="text-[11px] sm:text-xs font-bold text-slate-800">2. Guide PDF</span>
        <span class="text-[9px] sm:text-[11px] text-slate-500">Débloqué</span>
      </div>

      <!-- Step 3 -->
      <div class="flex flex-col items-center">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-bold text-xs sm:text-sm <%= order.status === 'DELIVERED' ? 'bg-amber-500 text-white ring-4 ring-amber-100' : (order.status === 'COMPLETED' ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-600') %> mb-1.5 sm:mb-2">
          <i class="fa-solid fa-download"></i>
        </div>
        <span class="text-[11px] sm:text-xs font-bold text-slate-800">3. Téléchargé</span>
        <span class="text-[9px] sm:text-[11px] text-slate-500">Test & Avis</span>
      </div>

      <!-- Step 4 -->
      <div class="flex flex-col items-center">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-bold text-xs sm:text-sm <%= order.status === 'COMPLETED' ? 'bg-emerald-600 text-white' : (order.status === 'DISPUTED' ? 'bg-rose-600 text-white' : (order.status === 'REFUNDED' ? 'bg-slate-700 text-white' : 'bg-slate-200 text-slate-600')) %> mb-1.5 sm:mb-2">
          <i class="fa-solid fa-<%= order.status === 'DISPUTED' ? 'triangle-exclamation' : (order.status === 'REFUNDED' ? 'arrow-rotate-left' : 'check') %>"></i>
        </div>
        <span class="text-[11px] sm:text-xs font-bold text-slate-800">4. <%= order.status === 'DISPUTED' ? 'Litige' : (order.status === 'REFUNDED' ? 'Remboursé' : 'Terminé') %></span>
        <span class="text-[9px] sm:text-[11px] text-slate-500"><%= order.status === 'COMPLETED' ? 'Fonds Libérés' : 'Protégé' %></span>
      </div>

    </div>
  </div>

  <!-- Resource Pack Downloads (PDF, ZIP, Text, Video) -->
  <div class="mb-6 sm:mb-8 p-5 sm:p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
      <div>
        <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-600 block">Ressources Débloquées</span>
        <h3 class="text-base sm:text-lg font-black text-slate-900">Pack Méthode : Fichiers & Livrables</h3>
        <p class="text-xs text-slate-500 mt-0.5">Téléchargez vos fichiers et consultez la vidéo pour accomplir votre tâche.</p>
      </div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold border border-emerald-200 self-start sm:self-auto">
        <i class="fa-solid fa-lock text-emerald-600"></i> <%= order.amount.toFixed(2) %> USDT en Séquestre
      </span>
    </div>

    <!-- 4 Files Grid (PDF, ZIP, TXT, Video) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      
      <!-- 1. PDF Document -->
      <div class="p-3.5 rounded-xl bg-rose-50/60 border border-rose-200 flex flex-col justify-between space-y-3">
        <div class="flex items-start gap-2.5">
          <span class="w-8 h-8 rounded-lg bg-rose-600 text-white flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-file-pdf"></i>
          </span>
          <div class="min-w-0">
            <span class="text-[10px] font-bold text-rose-700 uppercase block">Guide Écrit</span>
            <strong class="text-xs text-slate-900 block truncate" title="Guide Complet PDF">Guide-Methode.pdf</strong>
            <span class="text-[10px] text-slate-500">2.4 Mo • 42 pages</span>
          </div>
        </div>
        <a href="<%= order.fileUrl || '/uploads/guide-methode-developpement-ideale.pdf' %>" download="Guide-Methode.pdf" target="_blank" class="w-full py-2 px-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-[11px] rounded-lg text-center transition flex items-center justify-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-download"></i> Télécharger PDF
        </a>
      </div>

      <!-- 2. Source Code ZIP -->
      <div class="p-3.5 rounded-xl bg-amber-50/60 border border-amber-200 flex flex-col justify-between space-y-3">
        <div class="flex items-start gap-2.5">
          <span class="w-8 h-8 rounded-lg bg-amber-600 text-white flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-file-zipper"></i>
          </span>
          <div class="min-w-0">
            <span class="text-[10px] font-bold text-amber-700 uppercase block">Code Source</span>
            <strong class="text-xs text-slate-900 block truncate" title="Code Source & Templates">Code-Source.zip</strong>
            <span class="text-[10px] text-slate-500">5.1 Mo • Projets prêts</span>
          </div>
        </div>
        <a href="/uploads/code-source-template.zip" download="Code-Source.zip" target="_blank" class="w-full py-2 px-3 bg-amber-600 hover:bg-amber-700 text-white font-bold text-[11px] rounded-lg text-center transition flex items-center justify-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-download"></i> Télécharger ZIP
        </a>
      </div>

      <!-- 3. Scripts Text -->
      <div class="p-3.5 rounded-xl bg-blue-50/60 border border-blue-200 flex flex-col justify-between space-y-3">
        <div class="flex items-start gap-2.5">
          <span class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-file-lines"></i>
          </span>
          <div class="min-w-0">
            <span class="text-[10px] font-bold text-blue-700 uppercase block">Scripts & Commandes</span>
            <strong class="text-xs text-slate-900 block truncate" title="Commandes & Configs">commandes-scripts.txt</strong>
            <span class="text-[10px] text-slate-500">15 Ko • Prêt à copier</span>
          </div>
        </div>
        <a href="/uploads/commandes-scripts.txt" download="commandes-scripts.txt" target="_blank" class="w-full py-2 px-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-[11px] rounded-lg text-center transition flex items-center justify-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-download"></i> Télécharger TXT
        </a>
      </div>

      <!-- 4. Video Tutorial -->
      <div class="p-3.5 rounded-xl bg-purple-50/60 border border-purple-200 flex flex-col justify-between space-y-3">
        <div class="flex items-start gap-2.5">
          <span class="w-8 h-8 rounded-lg bg-purple-600 text-white flex items-center justify-center text-sm flex-shrink-0">
            <i class="fa-solid fa-video"></i>
          </span>
          <div class="min-w-0">
            <span class="text-[10px] font-bold text-purple-700 uppercase block">Démonstration</span>
            <strong class="text-xs text-slate-900 block truncate" title="Tutoriel Vidéo Pas-à-Pas">Tutoriel Vidéo</strong>
            <span class="text-[10px] text-slate-500">18 min • Explications</span>
          </div>
        </div>
        <a href="<%= order.videoUrl || 'https://www.youtube.com/watch?v=gAkwW2tuIqE' %>" target="_blank" class="w-full py-2 px-3 bg-purple-600 hover:bg-purple-700 text-white font-bold text-[11px] rounded-lg text-center transition flex items-center justify-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-play"></i> Voir la Vidéo
        </a>
      </div>

    </div>
  </div>

  <!-- Dispute Alert Box -->
  <% if (dispute) { %>
    <div class="mb-6 sm:mb-8 p-4 sm:p-6 rounded-2xl bg-rose-50 border border-rose-200" id="dispute-box">
      <div class="flex items-start gap-3 sm:gap-4">
        <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center text-sm sm:text-lg flex-shrink-0">
          <i class="fa-solid fa-scale-balanced"></i>
        </span>
        <div class="flex-grow min-w-0">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-1">
            <h3 class="font-bold text-rose-900 text-xs sm:text-sm">Litige Ouvert (#<%= dispute.id %>)</h3>
            <span class="text-[10px] sm:text-xs font-semibold px-2 py-0.5 rounded-full self-start sm:self-auto <%= dispute.status === 'OPEN' ? 'bg-rose-200 text-rose-800' : 'bg-emerald-200 text-emerald-800' %>">
              <%= dispute.status === 'OPEN' ? 'En cours d\'arbitrage' : 'Résolu' %>
            </span>
          </div>
          <p class="text-xs text-rose-800 mb-1.5"><strong>Motif :</strong> <%= dispute.reason %></p>
          <p class="text-xs text-rose-700 bg-white/70 p-2.5 sm:p-3 rounded-lg border border-rose-200 whitespace-pre-line mb-2"><%= dispute.details %></p>
          
          <p class="text-[11px] text-rose-600">
            🔒 <strong>Protection active :</strong> Les <%= order.amount.toFixed(2) %> USDT restent bloqués en séquestre.
          </p>

          <!-- Admin Arbitration Actions -->
          <% if (user && user.role === 'ADMIN' && dispute.status === 'OPEN') { %>
            <div class="mt-3 pt-3 border-t border-rose-200 flex flex-col sm:flex-row sm:items-center gap-2">
              <span class="text-xs font-bold text-rose-900">Décision d'Arbitrage Admin :</span>
              <div class="flex gap-2">
                <form action="/disputes/<%= dispute.id %>/resolve" method="POST" class="inline flex-1">
                  <input type="hidden" name="resolution" value="REFUND_BUYER">
                  <input type="hidden" name="resolutionNote" value="Arbitrage : remboursement de l'acheteur suite à non-conformité.">
                  <button type="submit" class="w-full sm:w-auto px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-lg shadow-sm">
                    🛡️ Rembourser l'Acheteur
                  </button>
                </form>

                <form action="/disputes/<%= dispute.id %>/resolve" method="POST" class="inline flex-1">
                  <input type="hidden" name="resolution" value="PAY_SELLER">
                  <input type="hidden" name="resolutionNote" value="Arbitrage : méthode et livrables conformes. Libération du paiement.">
                  <button type="submit" class="w-full sm:w-auto px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow-sm">
                    💰 Payer le Vendeur
                  </button>
                </form>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Actions & Chat Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
    
    <!-- Left Column: Actions & Details -->
    <div class="lg:col-span-1 space-y-4 sm:space-y-6 order-2 lg:order-1">
      
      <!-- Contract / Details -->
      <div class="bg-white p-4 sm:p-6 rounded-2xl border border-slate-200 shadow-sm space-y-2.5 text-xs">
        <h3 class="font-bold text-slate-900 text-sm mb-2 sm:mb-3">Détails de la Transaction</h3>
        <div class="flex justify-between py-1 border-b border-slate-100">
          <span class="text-slate-500">Montant en Séquestre :</span>
          <span class="font-bold text-slate-900"><%= order.amount.toFixed(2) %> USDT</span>
        </div>
        <div class="flex justify-between py-1 border-b border-slate-100">
          <span class="text-slate-500">Acheteur :</span>
          <span class="font-semibold text-slate-900"><%= order.buyerName %></span>
        </div>
        <div class="flex justify-between py-1 border-b border-slate-100">
          <span class="text-slate-500">Auteur / Vendeur :</span>
          <span class="font-semibold text-slate-900"><%= order.sellerName %></span>
        </div>
        <div class="pt-1">
          <span class="text-slate-500 block mb-1">Instructions / Note :</span>
          <div class="bg-slate-50 p-2.5 rounded-lg text-slate-700 italic border border-slate-100 text-[11px] leading-relaxed">
            <%= order.requirements || "Pas d'instructions spécifiques" %>
          </div>
        </div>

        <div class="pt-2 border-t border-slate-100">
          <a href="/chat?recipientId=<%= user && user.id === order.buyerId ? order.sellerId : order.buyerId %>&serviceId=<%= order.serviceId %>" class="w-full py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition flex items-center justify-center gap-1.5 border border-slate-200">
            <i class="fa-regular fa-comments text-emerald-600"></i>
            <span>💬 Chat direct avec <%= user && user.id === order.buyerId ? order.sellerName : order.buyerName %></span>
          </a>
        </div>
      </div>

      <!-- Buyer Actions: Approve delivery -->
      <% if (user && user.id === order.buyerId) { %>
        <% if (order.status === 'DELIVERED') { %>
          <div class="bg-emerald-50 border border-emerald-200 p-4 sm:p-6 rounded-2xl text-xs space-y-3">
            <h4 class="font-bold text-emerald-900 text-sm flex items-center gap-1.5">
              <i class="fa-solid fa-file-circle-check text-emerald-600"></i> Méthode PDF Accessible
            </h4>
            <p class="text-emerald-800 leading-relaxed text-[11px]">
              Téléchargez et testez le pack. Si la méthode vous a permis de réaliser votre tâche, cliquez ci-dessous pour libérer les <strong><%= order.amount.toFixed(2) %> USDT</strong> à l'auteur.
            </p>
            <form action="/orders/<%= order.id %>/complete" method="POST">
              <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-check"></i> Valider et Payer l'Auteur (<%= order.amount.toFixed(2) %> USDT)
              </button>
            </form>
          </div>
        <% } %>

        <!-- Open Dispute Button -->
        <% if ((order.status === 'ESCROWED' || order.status === 'DELIVERED') && !dispute) { %>
          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200 text-xs">
            <h4 class="font-bold text-slate-900 mb-1">Un problème avec le guide ?</h4>
            <p class="text-slate-500 mb-3 text-[11px]">Si les fichiers sont corrompus ou ne correspondent pas au sommaire, ouvrez une médiation pour bloquer les fonds.</p>
            
            <details class="group">
              <summary class="cursor-pointer text-rose-600 font-semibold hover:text-rose-700 flex items-center gap-1.5 list-none">
                <i class="fa-solid fa-triangle-exclamation"></i> Ouvrir un litige / médiation
              </summary>
              <form action="/orders/<%= order.id %>/dispute" method="POST" class="mt-3 space-y-2.5 pt-3 border-t border-slate-100">
                <div>
                  <label class="block font-semibold text-slate-700 mb-1 text-[11px]">Motif du litige :</label>
                  <select name="reason" class="w-full p-2 border border-slate-200 rounded-lg text-xs" required>
                    <option value="Fichier PDF corrompu ou illisible">Fichier PDF corrompu ou illisible</option>
                    <option value="Contenu non conforme au sommaire annoncé">Contenu non conforme au sommaire annoncé</option>
                    <option value="Méthode incomplète / tâche non résolue">Méthode incomplète / tâche non résolue</option>
                    <option value="Autre défaut technique">Autre défaut technique</option>
                  </select>
                </div>
                <div>
                  <label class="block font-semibold text-slate-700 mb-1 text-[11px]">Explications :</label>
                  <textarea name="details" rows="2" class="w-full p-2 border border-slate-200 rounded-lg text-xs" required placeholder="Détaillez le problème rencontré..."></textarea>
                </div>
                <button type="submit" class="w-full py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-lg text-xs">
                  Geler les fonds et soumettre
                </button>
              </form>
            </details>
          </div>
        <% } %>
      <% } %>

      <!-- Review Section -->
      <% if (order.status === 'COMPLETED') { %>
        <% if (typeof review !== 'undefined' && review) { %>
          <div class="bg-amber-50 border border-amber-200 p-4 sm:p-5 rounded-2xl text-xs space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-amber-900 text-sm flex items-center gap-1.5">
                <i class="fa-solid fa-star text-amber-500"></i> Avis Client
              </span>
              <div class="flex text-amber-400 text-xs">
                <% for (let i = 1; i <= 5; i++) { %>
                  <i class="fa-solid fa-star <%= i <= review.rating ? 'text-amber-400' : 'text-slate-200' %>"></i>
                <% } %>
              </div>
            </div>
            <p class="text-slate-700 italic bg-white/80 p-3 rounded-xl border border-amber-100 text-[11px]">
              "<%= review.comment %>"
            </p>
          </div>
        <% } else if (user && user.id === order.buyerId) { %>
          <div class="bg-white border border-slate-200 p-4 sm:p-5 rounded-2xl text-xs space-y-3 shadow-sm">
            <h4 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
              <i class="fa-solid fa-star text-amber-500"></i> Laisser un avis à l'auteur
            </h4>
            <p class="text-slate-500 text-[11px]">Votre retour aide les autres développeurs à choisir les meilleurs guides.</p>
            <form action="/orders/<%= order.id %>/review" method="POST" class="space-y-3">
              <div>
                <label class="block font-semibold text-slate-700 mb-1 text-[11px]">Note :</label>
                <select name="rating" class="w-full p-2 border border-slate-200 rounded-lg text-xs font-bold text-amber-600 bg-white" required>
                  <option value="5">⭐⭐⭐⭐⭐ (5/5 Excellent)</option>
                  <option value="4">⭐⭐⭐⭐ (4/5 Très bon)</option>
                  <option value="3">⭐⭐⭐ (3/5 Correct)</option>
                  <option value="2">⭐⭐ (2/5 Décevant)</option>
                  <option value="1">⭐ (1/5 Insatisfaisant)</option>
                </select>
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1 text-[11px]">Commentaire :</label>
                <textarea name="comment" rows="2" required placeholder="Partagez votre avis sur la clarté et l'efficacité de ce guide..." class="w-full p-2.5 border border-slate-200 rounded-xl bg-white text-xs"></textarea>
              </div>
              <button type="submit" class="w-full py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl shadow-sm transition">
                Publier mon Avis
              </button>
            </form>
          </div>
        <% } %>
      <% } %>

      <!-- Seller Delivery Action -->
      <% if (user && user.id === order.sellerId) { %>
        <% if (order.status === 'ESCROWED') { %>
          <div class="bg-blue-50 border border-blue-200 p-4 sm:p-6 rounded-2xl text-xs space-y-3">
            <h4 class="font-bold text-blue-900 text-sm">Prêt à livrer ?</h4>
            <p class="text-blue-800 leading-relaxed text-[11px]">
              Les <%= order.amount.toFixed(2) %> USDT sont en séquestre. Envoyez des compléments ou instructions ci-dessous.
            </p>
            <form action="/orders/<%= order.id %>/deliver" method="POST" class="space-y-2.5">
              <textarea name="deliveryNote" rows="3" required placeholder="Lien GitHub, Google Drive, précisions de mise en oeuvre..." class="w-full p-2.5 border border-slate-200 rounded-xl bg-white text-xs"></textarea>
              <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-md transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-box-arrow-up"></i> Livrer le travail
              </button>
            </form>
          </div>
        <% } %>
      <% } %>

    </div>

    <!-- Right Column: Real-Time Discussion & Deliverables Feed -->
    <div class="lg:col-span-2 space-y-4 sm:space-y-6 order-1 lg:order-2">
      
      <!-- Delivery Note Section -->
      <% if (order.deliveryNote) { %>
        <div class="bg-amber-50/80 border border-amber-200 p-4 sm:p-6 rounded-2xl" id="delivery-note-container">
          <div class="flex items-center gap-2 font-bold text-amber-900 text-xs sm:text-sm mb-1.5">
            <i class="fa-solid fa-box text-amber-600"></i> Compléments livrés par <%= order.sellerName %>
          </div>
          <div class="text-xs text-amber-950 bg-white p-3.5 sm:p-4 rounded-xl border border-amber-200 whitespace-pre-line leading-relaxed break-words">
            <%= order.deliveryNote %>
          </div>
        </div>
      <% } %>

      <!-- Secure Socket.io Chat Feed -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[420px] sm:h-[500px]">
        <div class="px-4 sm:px-6 py-3.5 sm:py-4 border-b border-slate-100 flex items-center justify-between">
          <h3 class="font-bold text-slate-900 text-xs sm:text-sm flex items-center gap-2">
            <i class="fa-regular fa-comments text-emerald-600"></i> Discussion & Support de Commande
          </h3>
          <span class="inline-flex items-center gap-1.5 text-[10px] sm:text-[11px] text-emerald-600 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> En direct
          </span>
        </div>

        <!-- Messages Area -->
        <div id="messages-container" class="flex-grow p-4 sm:p-6 overflow-y-auto space-y-3 sm:space-y-4">
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(msg => { %>
              <div class="message-bubble flex flex-col <%= user && user.id === msg.senderId ? 'items-end' : 'items-start' %>">
                <span class="text-[9px] sm:text-[10px] text-slate-400 mb-0.5"><%= msg.senderName %></span>
                <div class="max-w-[85%] sm:max-w-md p-3 sm:p-3.5 rounded-2xl text-xs leading-relaxed whitespace-pre-line break-words <%= user && user.id === msg.senderId ? 'bg-emerald-600 text-white rounded-br-none shadow-sm shadow-emerald-100' : 'bg-slate-100 text-slate-800 rounded-bl-none' %>">
                  <% if (msg.content) { %>
                    <p><%= msg.content %></p>
                  <% } %>
                  <% if (msg.fileUrl) { %>
                    <% const isImg = msg.fileUrl.match(/\.(jpeg|jpg|gif|png|webp)$/i); %>
                    <% if (isImg) { %>
                      <a href="<%= msg.fileUrl %>" target="_blank" class="block mt-2 rounded-xl overflow-hidden border border-black/10 hover:opacity-95 transition">
                        <img src="<%= msg.fileUrl %>" alt="<%= msg.fileName || 'File' %>" class="max-h-48 w-full object-cover">
                      </a>
                    <% } else { %>
                      <a href="<%= msg.fileUrl %>" download="<%= msg.fileName || 'fichier' %>" target="_blank" class="mt-2 inline-flex items-center gap-2 px-3 py-1.5 rounded-xl <%= user && user.id === msg.senderId ? 'bg-emerald-700/80 hover:bg-emerald-800 text-white' : 'bg-slate-200 hover:bg-slate-300 text-slate-800' %> transition font-semibold text-[11px]">
                        <i class="fa-solid fa-file-arrow-down text-sm"></i>
                        <span class="truncate max-w-[180px]"><%= msg.fileName || 'Télécharger le fichier' %></span>
                      </a>
                    <% } %>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p id="empty-messages-placeholder" class="text-center text-xs text-slate-400 py-10">Aucun message pour l'instant. Posez une question au vendeur ci-dessous.</p>
          <% } %>
        </div>

        <!-- Upload Status Banner -->
        <div id="upload-status" class="hidden px-4 py-1.5 bg-emerald-50 border-t border-emerald-100 text-[11px] text-emerald-700 font-medium flex items-center justify-between">
          <span class="flex items-center gap-1.5"><i class="fa-solid fa-spinner fa-spin"></i> Envoi du fichier en cours...</span>
        </div>

        <!-- Chat Form -->
        <form id="chat-form" class="p-3 sm:p-4 border-t border-slate-100 flex items-center gap-2">
          <input type="file" id="chat-file-input" class="hidden">
          <button type="button" id="chat-attach-btn" title="Joindre un fichier (max 25 Mo)" class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition flex-shrink-0">
            <i class="fa-solid fa-paperclip text-sm"></i>
          </button>
          <input type="text" id="chat-input" autocomplete="off" placeholder="Écrivez un message au vendeur..." class="flex-grow text-xs px-3.5 sm:px-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
          <button type="submit" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 flex-shrink-0">
            <span>Envoyer</span> <i class="fa-solid fa-paper-plane text-[10px]"></i>
          </button>
        </form>
      </div>

    </div>

  </div>

</div>

<!-- Socket.io Script -->
<script>
  const orderId = "<%= order.id %>";
  const currentUserId = "<%= user ? user.id : '' %>";
  const currentUserName = "<%= user ? user.name : 'Me' %>";
  const socket = io();

  const messagesContainer = document.getElementById('messages-container');
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input');
  const chatFileInput = document.getElementById('chat-file-input');
  const chatAttachBtn = document.getElementById('chat-attach-btn');
  const uploadStatus = document.getElementById('upload-status');
  const emptyPlaceholder = document.getElementById('empty-messages-placeholder');

  function scrollToBottom() {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }
  scrollToBottom();

  socket.emit('join_order', { orderId });

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderMessageItem(msg) {
    if (emptyPlaceholder) emptyPlaceholder.style.display = 'none';

    const isMe = msg.senderId === currentUserId;
    const msgDiv = document.createElement('div');
    msgDiv.className = `message-bubble flex flex-col ${isMe ? 'items-end' : 'items-start'} toast-anim`;

    let fileHtml = '';
    if (msg.fileUrl) {
      const isImg = msg.fileUrl.match(/\.(jpeg|jpg|gif|png|webp)$/i);
      const safeFileUrl = encodeURI(msg.fileUrl);
      const safeFileName = escapeHtml(msg.fileName || 'File');
      if (isImg) {
        fileHtml = `
          <a href="${safeFileUrl}" target="_blank" class="block mt-2 rounded-xl overflow-hidden border border-black/10 hover:opacity-95 transition">
            <img src="${safeFileUrl}" alt="${safeFileName}" class="max-h-48 w-full object-cover">
          </a>
        `;
      } else {
        fileHtml = `
          <a href="${safeFileUrl}" download="${safeFileName}" target="_blank" class="mt-2 inline-flex items-center gap-2 px-3 py-1.5 rounded-xl ${isMe ? 'bg-emerald-700/80 hover:bg-emerald-800 text-white' : 'bg-slate-200 hover:bg-slate-300 text-slate-800'} transition font-semibold text-[11px]">
            <i class="fa-solid fa-file-arrow-down text-sm"></i>
            <span class="truncate max-w-[180px]">${safeFileName}</span>
          </a>
        `;
      }
    }

    const safeName = escapeHtml(msg.senderName || 'User');
    const safeContent = msg.content ? `<p>${escapeHtml(msg.content)}</p>` : '';

    msgDiv.innerHTML = `
      <span class="text-[9px] sm:text-[10px] text-slate-400 mb-0.5">${safeName}</span>
      <div class="max-w-[85%] sm:max-w-md p-3 sm:p-3.5 rounded-2xl text-xs leading-relaxed whitespace-pre-line break-words ${
        isMe ? 'bg-emerald-600 text-white rounded-br-none shadow-sm shadow-emerald-100' : 'bg-slate-100 text-slate-800 rounded-bl-none'
      }">
        ${safeContent}
        ${fileHtml}
      </div>
    `;
    messagesContainer.appendChild(msgDiv);
    scrollToBottom();
  }

  socket.on('new_message', (msg) => {
    renderMessageItem(msg);
    if (msg.senderId !== currentUserId) {
      window.showToast(`New message from ${msg.senderName}`, 'info');
    }
  });

  socket.on('order_updated', (data) => {
    window.showToast(`Order status updated: ${data.status}`, 'success');
    setTimeout(() => {
      window.location.reload();
    }, 1200);
  });

  // Attach file handler
  if (chatAttachBtn && chatFileInput) {
    chatAttachBtn.addEventListener('click', () => {
      chatFileInput.click();
    });

    chatFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (file.size > 25 * 1024 * 1024) {
        window.showToast('File size must not exceed 25 MB', 'error');
        chatFileInput.value = '';
        return;
      }

      uploadStatus.classList.remove('hidden');
      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (data.success) {
          socket.emit('send_message', {
            orderId,
            senderId: currentUserId,
            senderName: currentUserName,
            content: chatInput.value.trim() || `Attachment: ${data.fileName}`,
            fileUrl: data.fileUrl,
            fileName: data.fileName
          });
          chatInput.value = '';
          window.showToast('File sent successfully!', 'success');
        } else {
          window.showToast(data.error || 'Error sending file', 'error');
        }
      } catch (err) {
        window.showToast('Network error during upload', 'error');
      } finally {
        uploadStatus.classList.add('hidden');
        chatFileInput.value = '';
      }
    });
  }

  chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const content = chatInput.value.trim();
    if (!content) return;

    socket.emit('send_message', {
      orderId,
      senderId: currentUserId,
      senderName: currentUserName,
      content
    });

    chatInput.value = '';
    chatInput.focus();
  });
</script>

<%- include('partials/footer') %>

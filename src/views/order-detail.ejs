<%- include('partials/header', { title: 'Order #' + order.id }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-6" id="order-page-root" data-order-id="<%= order.id %>">

  <!-- Order Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 hover:text-slate-900 mb-1 transition">
        <i class="fa-solid fa-arrow-left text-[10px]"></i> Dashboard
      </a>
      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">
        <%= order.serviceTitle %>
      </h1>
    </div>

    <div>
      <% if (order.status === 'COMPLETED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200">
          <i class="fa-solid fa-check"></i> Completed (<%= order.amount.toFixed(2) %> USDT)
        </span>
      <% } else if (order.status === 'DISPUTED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-rose-50 text-rose-700 text-xs font-semibold border border-rose-200">
          <i class="fa-solid fa-triangle-exclamation"></i> Dispute Open
        </span>
      <% } else if (order.status === 'REFUNDED') { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold">
          Refunded
        </span>
      <% } else { %>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-50 text-amber-800 text-xs font-semibold border border-amber-200">
          <i class="fa-solid fa-lock text-[10px]"></i> <%= order.amount.toFixed(2) %> USDT locked in escrow
        </span>
      <% } %>
    </div>
  </div>

  <!-- 1. Unlocked Package Downloads -->
  <div class="bg-white p-6 rounded-2xl border border-slate-200/90 space-y-4">
    <div>
      <h2 class="text-sm font-bold text-slate-900">Package Files</h2>
      <p class="text-xs text-slate-400">Click any item below to download your method files.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <a href="<%= order.fileUrl || '/uploads/guide-methode-developpement-ideale.pdf' %>" download="Method-Guide.pdf" target="_blank" class="p-3.5 rounded-xl bg-[#FAFAFA] hover:bg-slate-100 border border-slate-200/80 transition flex items-center justify-between group">
        <div class="flex items-center gap-3 min-w-0">
          <i class="fa-solid fa-file-pdf text-rose-500 text-base"></i>
          <div class="min-w-0">
            <strong class="text-xs font-semibold text-slate-900 block truncate">PDF Guide</strong>
            <span class="text-[11px] text-slate-400">Written manual</span>
          </div>
        </div>
        <i class="fa-solid fa-download text-xs text-slate-400 group-hover:text-slate-900"></i>
      </a>

      <a href="/uploads/code-source-template.zip" download="Source-Code.zip" target="_blank" class="p-3.5 rounded-xl bg-[#FAFAFA] hover:bg-slate-100 border border-slate-200/80 transition flex items-center justify-between group">
        <div class="flex items-center gap-3 min-w-0">
          <i class="fa-solid fa-file-zipper text-amber-500 text-base"></i>
          <div class="min-w-0">
            <strong class="text-xs font-semibold text-slate-900 block truncate">ZIP Archive</strong>
            <span class="text-[11px] text-slate-400">Code & templates</span>
          </div>
        </div>
        <i class="fa-solid fa-download text-xs text-slate-400 group-hover:text-slate-900"></i>
      </a>

      <a href="/uploads/commandes-scripts.txt" download="commands-scripts.txt" target="_blank" class="p-3.5 rounded-xl bg-[#FAFAFA] hover:bg-slate-100 border border-slate-200/80 transition flex items-center justify-between group">
        <div class="flex items-center gap-3 min-w-0">
          <i class="fa-solid fa-terminal text-blue-500 text-base"></i>
          <div class="min-w-0">
            <strong class="text-xs font-semibold text-slate-900 block truncate">TXT Scripts</strong>
            <span class="text-[11px] text-slate-400">Ready commands</span>
          </div>
        </div>
        <i class="fa-solid fa-download text-xs text-slate-400 group-hover:text-slate-900"></i>
      </a>

      <a href="<%= order.videoUrl || 'https://www.youtube.com/watch?v=gAkwW2tuIqE' %>" target="_blank" class="p-3.5 rounded-xl bg-[#FAFAFA] hover:bg-slate-100 border border-slate-200/80 transition flex items-center justify-between group">
        <div class="flex items-center gap-3 min-w-0">
          <i class="fa-solid fa-play text-purple-500 text-base"></i>
          <div class="min-w-0">
            <strong class="text-xs font-semibold text-slate-900 block truncate">Video Tutorial</strong>
            <span class="text-[11px] text-slate-400">Watch video</span>
          </div>
        </div>
        <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-400 group-hover:text-slate-900"></i>
      </a>
    </div>
  </div>

  <!-- Dispute Banner -->
  <% if (dispute) { %>
    <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 space-y-2 text-xs">
      <div class="flex items-center justify-between">
        <strong class="text-rose-900 text-sm">Dispute #<%= dispute.id %> — <%= dispute.reason %></strong>
        <span class="font-semibold text-rose-700"><%= dispute.status === 'OPEN' ? 'Under Review' : 'Resolved' %></span>
      </div>
      <p class="text-rose-800"><%= dispute.details %></p>

      <% if (user && user.role === 'ADMIN' && dispute.status === 'OPEN') { %>
        <div class="pt-3 flex gap-2">
          <form action="/disputes/<%= dispute.id %>/resolve" method="POST">
            <input type="hidden" name="resolution" value="REFUND_BUYER">
            <input type="hidden" name="resolutionNote" value="Full refund approved by arbitrator.">
            <button type="submit" class="px-3.5 py-2 bg-rose-600 hover:bg-rose-700 text-white font-semibold rounded-xl">Refund Buyer</button>
          </form>
          <form action="/disputes/<%= dispute.id %>/resolve" method="POST">
            <input type="hidden" name="resolution" value="PAY_SELLER">
            <input type="hidden" name="resolutionNote" value="Payout released to seller by arbitrator.">
            <button type="submit" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl">Pay Seller</button>
          </form>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Main Grid: Actions + Order Chat -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    
    <!-- Left Column: Approval / Review / Summary -->
    <div class="lg:col-span-1 space-y-4">
      
      <% if (user && user.id === order.buyerId && (order.status === 'DELIVERED' || order.status === 'ESCROWED')) { %>
        <div class="bg-white p-5 rounded-2xl border border-slate-200/90 space-y-3">
          <h3 class="font-bold text-slate-900 text-sm">Everything working as expected?</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Once you have verified the files, release the <strong><%= order.amount.toFixed(2) %> USDT</strong> escrow payment to the author.
          </p>
          <form action="/orders/<%= order.id %>/complete" method="POST">
            <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl transition">
              Approve & Release Funds
            </button>
          </form>
        </div>
      <% } %>

      <% if (order.status === 'COMPLETED' && user && user.id === order.buyerId && !review) { %>
        <div class="bg-white p-5 rounded-2xl border border-slate-200/90 space-y-3 text-xs">
          <h3 class="font-bold text-slate-900 text-sm">Leave a Review</h3>
          <form action="/orders/<%= order.id %>/review" method="POST" class="space-y-2.5">
            <select name="rating" class="w-full p-2.5 border border-slate-200 rounded-xl bg-white font-medium" required>
              <option value="5">5/5 — Excellent</option>
              <option value="4">4/5 — Very Good</option>
              <option value="3">3/5 — Good</option>
              <option value="2">2/5 — Fair</option>
              <option value="1">1/5 — Poor</option>
            </select>
            <textarea name="comment" rows="2" required placeholder="Your feedback..." class="w-full p-2.5 border border-slate-200 rounded-xl"></textarea>
            <button type="submit" class="w-full py-2 bg-slate-900 text-white font-semibold rounded-xl">Submit Review</button>
          </form>
        </div>
      <% } %>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 space-y-2.5 text-xs">
        <div class="flex justify-between text-slate-500">
          <span>Total Price</span>
          <strong class="text-slate-900"><%= order.amount.toFixed(2) %> USDT</strong>
        </div>
        <div class="flex justify-between text-slate-500">
          <span>Platform Fee (15%)</span>
          <span class="font-semibold text-slate-700"><%= (order.platformFee || (order.amount * 0.15)).toFixed(2) %> USDT</span>
        </div>
        <div class="flex justify-between text-slate-500 pb-2 border-b border-slate-100">
          <span>Author Net Payout (85%)</span>
          <strong class="text-emerald-600"><%= (order.sellerNetAmount || (order.amount * 0.85)).toFixed(2) %> USDT</strong>
        </div>
        <div class="flex justify-between text-slate-500">
          <span>Buyer</span>
          <strong class="text-slate-900"><%= order.buyerName %></strong>
        </div>
        <div class="flex justify-between text-slate-500">
          <span>Author</span>
          <strong class="text-slate-900"><%= order.sellerName %></strong>
        </div>

        <% if (user && user.id === order.buyerId && (order.status === 'ESCROWED' || order.status === 'DELIVERED') && !dispute) { %>
          <details class="pt-3 border-t border-slate-100">
            <summary class="cursor-pointer text-rose-600 font-medium hover:underline list-none">
              Report an issue (open dispute)
            </summary>
            <form action="/orders/<%= order.id %>/dispute" method="POST" class="mt-3 space-y-2">
              <select name="reason" class="w-full p-2 border border-slate-200 rounded-lg text-xs" required>
                <option value="Corrupted or unreadable file">Corrupted or unreadable file</option>
                <option value="Content does not match description">Content does not match description</option>
                <option value="Incomplete method">Incomplete method</option>
              </select>
              <textarea name="details" rows="2" class="w-full p-2 border border-slate-200 rounded-lg text-xs" required placeholder="Describe the issue..."></textarea>
              <button type="submit" class="w-full py-2 bg-rose-600 text-white font-semibold rounded-lg text-xs">Freeze Funds & Submit</button>
            </form>
          </details>
        <% } %>
      </div>

    </div>

    <!-- Right Column: Live Order Chat -->
    <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/90 flex flex-col h-[440px]">
      <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
        <h3 class="font-bold text-slate-900 text-sm">Chat with <%= user && user.id === order.buyerId ? order.sellerName : order.buyerName %></h3>
        <span class="text-[11px] text-emerald-600 font-medium">Live</span>
      </div>

      <div id="messages-container" class="flex-grow p-5 overflow-y-auto space-y-3">
        <% if (messages && messages.length > 0) { %>
          <% messages.forEach(msg => { %>
            <div class="flex flex-col <%= user && user.id === msg.senderId ? 'items-end' : 'items-start' %>">
              <span class="text-[10px] text-slate-400 mb-0.5"><%= msg.senderName %></span>
              <div class="max-w-[80%] px-3.5 py-2.5 rounded-2xl text-xs leading-relaxed <%= user && user.id === msg.senderId ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-800' %>">
                <% if (msg.content) { %><p><%= msg.content %></p><% } %>
                <% if (msg.fileUrl) { %>
                  <a href="<%= msg.fileUrl %>" download="<%= msg.fileName || 'file' %>" target="_blank" class="mt-1.5 inline-flex items-center gap-1.5 underline font-medium">
                    <i class="fa-solid fa-paperclip"></i> <%= msg.fileName || 'Attachment' %>
                  </a>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p id="empty-messages-placeholder" class="text-center text-xs text-slate-400 py-12">Ask any question about this method below.</p>
        <% } %>
      </div>

      <div id="upload-status" class="hidden px-4 py-1.5 bg-slate-50 border-t border-slate-100 text-[11px] text-slate-500">
        Uploading file...
      </div>

      <form id="chat-form" class="p-3 border-t border-slate-100 flex items-center gap-2">
        <input type="file" id="chat-file-input" class="hidden">
        <button type="button" id="chat-attach-btn" class="w-9 h-9 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
          <i class="fa-solid fa-paperclip text-xs"></i>
        </button>
        <input type="text" id="chat-input" autocomplete="off" placeholder="Write a message..." class="flex-grow text-xs px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        <button type="submit" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl transition">
          Send
        </button>
      </form>
    </div>

  </div>

</div>

<script>
  const orderId = "<%= order.id %>";
  const currentUserId = "<%= user ? user.id : '' %>";
  const socket = io();

  const messagesContainer = document.getElementById('messages-container');
  const chatForm = document.getElementById('chat-form');
  const chatInput = document.getElementById('chat-input');
  const chatFileInput = document.getElementById('chat-file-input');
  const chatAttachBtn = document.getElementById('chat-attach-btn');
  const uploadStatus = document.getElementById('upload-status');
  const emptyPlaceholder = document.getElementById('empty-messages-placeholder');

  function scrollToBottom() {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }
  scrollToBottom();
  socket.emit('join_order', { orderId });

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  socket.on('new_message', (msg) => {
    if (emptyPlaceholder) emptyPlaceholder.style.display = 'none';
    const isMe = msg.senderId === currentUserId;
    const msgDiv = document.createElement('div');
    msgDiv.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'}`;
    const fileHtml = msg.fileUrl ? `<a href="${encodeURI(msg.fileUrl)}" download="${escapeHtml(msg.fileName || 'file')}" target="_blank" class="mt-1.5 inline-flex items-center gap-1.5 underline font-medium"><i class="fa-solid fa-paperclip"></i> ${escapeHtml(msg.fileName || 'Attachment')}</a>` : '';
    msgDiv.innerHTML = `
      <span class="text-[10px] text-slate-400 mb-0.5">${escapeHtml(msg.senderName)}</span>
      <div class="max-w-[80%] px-3.5 py-2.5 rounded-2xl text-xs leading-relaxed ${isMe ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-800'}">
        ${msg.content ? `<p>${escapeHtml(msg.content)}</p>` : ''}
        ${fileHtml}
      </div>
    `;
    messagesContainer.appendChild(msgDiv);
    scrollToBottom();
  });

  socket.on('order_updated', () => setTimeout(() => window.location.reload(), 800));

  if (chatAttachBtn && chatFileInput) {
    chatAttachBtn.addEventListener('click', () => chatFileInput.click());
    chatFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      uploadStatus.classList.remove('hidden');
      const formData = new FormData();
      formData.append('file', file);
      try {
        const res = await fetch('/api/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
          socket.emit('send_message', {
            orderId,
            content: chatInput.value.trim() || `Attachment: ${data.fileName}`,
            fileUrl: data.fileUrl,
            fileName: data.fileName
          });
          chatInput.value = '';
        }
      } finally {
        uploadStatus.classList.add('hidden');
        chatFileInput.value = '';
      }
    });
  }

  chatForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const content = chatInput.value.trim();
    if (!content) return;
    socket.emit('send_message', { orderId, content });
    chatInput.value = '';
  });
</script>

<%- include('partials/footer') %>

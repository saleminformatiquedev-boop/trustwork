<%- include('partials/header', { title: 'Publish a Method' }) %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
  
  <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/90 space-y-6">
    
    <div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">Publish a Method</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        Upload your PDF guide, ZIP code archive, and set your fixed price in USDT.
      </p>
    </div>

    <form action="/services/new" method="POST" enctype="multipart/form-data" class="space-y-5">
      
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Method Title</label>
        <input type="text" name="title" required placeholder="e.g. Deploy a Node.js API on AWS with Docker & SSL" class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none transition">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Category</label>
          <select name="category" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
            <option value="Cloud & Deployment">Cloud & Deployment</option>
            <option value="Backend & API">Backend & API</option>
            <option value="DevOps & CI/CD">DevOps & CI/CD</option>
            <option value="Security & Blockchain">Security & Blockchain</option>
            <option value="Software Architecture">Software Architecture</option>
            <option value="Development Methodology">Methodology</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Difficulty</label>
          <select name="difficulty" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
            <option value="Beginner">Beginner</option>
            <option value="Intermediate" selected>Intermediate</option>
            <option value="Advanced">Advanced</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Price (USDT)</label>
          <input type="number" id="service-price-input" step="0.5" min="1" name="price" required placeholder="25" class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl font-bold text-slate-900 focus:bg-white focus:border-slate-900 focus:outline-none">
          <p class="text-[11px] text-slate-400 mt-1" id="seller-net-preview">Platform fee: 15% • You receive: 85%</p>
        </div>
      </div>

      <input type="hidden" name="pageCount" value="40">

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Description & Syllabus</label>
        <textarea name="description" rows="4" required placeholder="Outline what developers will learn and build step by step..." class="w-full text-sm p-3.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none transition"></textarea>
      </div>

      <!-- Package Files -->
      <div class="space-y-3 pt-2 border-t border-slate-100">
        <label class="block text-xs font-semibold text-slate-700">Package Files</label>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">1. PDF Guide</span>
            <input type="file" name="pdfFile" accept=".pdf" class="w-full text-[11px] text-slate-500">
          </div>

          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">2. Source Code (ZIP)</span>
            <input type="file" name="zipFile" accept=".zip,.rar,.tar,.gz" class="w-full text-[11px] text-slate-500">
          </div>

          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">3. Scripts (.txt, .sh)</span>
            <input type="file" name="textFile" accept=".txt,.md,.sh,.json,.yml,.yaml" class="w-full text-[11px] text-slate-500">
          </div>

          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">4. Video (MP4)</span>
            <input type="file" name="videoFile" accept=".mp4,.webm,.mov" class="w-full text-[11px] text-slate-500">
          </div>
        </div>

        <div>
          <input type="url" name="videoUrl" placeholder="Or external video link (YouTube, Loom...)" class="w-full text-xs px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>
      </div>

      <div class="pt-3 flex items-center justify-end gap-3">
        <a href="/" class="px-4 py-2.5 text-xs font-semibold text-slate-500 hover:text-slate-900">Cancel</a>
        <button type="submit" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold rounded-xl transition">
          Publish Method
        </button>
      </div>

    </form>
  </div>

</div>

<script>
  const priceInput = document.getElementById('service-price-input');
  const netPreview = document.getElementById('seller-net-preview');
  if (priceInput && netPreview) {
    priceInput.addEventListener('input', () => {
      const val = parseFloat(priceInput.value);
      if (val && val > 0) {
        const fee = (val * 0.15).toFixed(2);
        const net = (val - val * 0.15).toFixed(2);
        netPreview.textContent = `15% fee (${fee} USDT) • You receive ${net} USDT (85%)`;
      } else {
        netPreview.textContent = 'Platform fee: 15% • You receive: 85%';
      }
    });
  }
</script>

<%- include('partials/footer') %>

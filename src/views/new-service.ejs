<%- include('partials/header', { title: 'Proposer un service' }) %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  
  <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-slate-900">Proposer un service à prix fixe</h1>
      <p class="text-xs text-slate-500 mt-1">
        Définissez un tarif forfaitaire transparent en USDT. Vos clients paieront sous séquestre avant le début du travail.
      </p>
    </div>

    <form action="/services/new" method="POST" class="space-y-6">
      
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Titre de votre service (Ex: "Je vais concevoir...")
        </label>
        <input type="text" name="title" required placeholder="Je vais créer votre application web avec Node.js et Tailwind" class="w-full text-sm px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Catégorie</label>
          <select name="category" class="w-full text-sm px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white">
            <option value="Développement Web & Mobile">Développement Web & Mobile</option>
            <option value="Design & Graphisme">Design & Graphisme</option>
            <option value="Rédaction & Traduction">Rédaction & Traduction</option>
            <option value="Marketing & Réseaux Sociaux">Marketing & Réseaux Sociaux</option>
            <option value="Audio & Vidéo">Audio & Vidéo</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Délai de réalisation (en jours)</label>
          <input type="number" name="deliveryDays" min="1" max="60" value="3" required class="w-full text-sm px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Prix forfaitaire fixe (USDT)
        </label>
        <div class="relative">
          <input type="number" step="0.5" min="5" name="price" required placeholder="50.00" class="w-full text-sm px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none pr-16 font-bold text-slate-900">
          <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-xs font-bold text-slate-400">
            USDT
          </div>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">Montant total que vous toucherez une fois la commande validée.</p>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Description complète de la prestation
        </label>
        <textarea name="description" rows="5" required placeholder="Décrivez en détail ce qui est inclus dans le forfait, les livrables précis, les technologies utilisées..." class="w-full text-sm p-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
        <a href="/" class="px-5 py-2.5 text-xs font-bold text-slate-600 hover:text-slate-800">Annuler</a>
        <button type="submit" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-md shadow-emerald-200 transition">
          Publier le service
        </button>
      </div>

    </form>
  </div>

</div>

<%- include('partials/footer') %>

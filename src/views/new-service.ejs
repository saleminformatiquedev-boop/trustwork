<%- include('partials/header', { title: 'Publish a Method or Digital Tool' }) %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

  <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/90 space-y-6">

    <div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">Publish a Method or Digital Account</h1>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        List your working method, automation script, or ready-to-use tool with transparent pricing, unit cost, screen-share proof &amp; exchange options.
      </p>
    </div>

    <form action="/services/new" method="POST" enctype="multipart/form-data" class="space-y-5">

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Method / Product Title</label>
        <input type="text" name="title" required placeholder="e.g. Notion Edu Plus (1 Year) — Full Working Method" class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none transition">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Category</label>
          <select name="category" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
            <option value="Digital Accounts & Methods">Digital Accounts &amp; Methods</option>
            <option value="Methods & Scripts">Methods &amp; Scripts</option>
            <option value="Ready-to-Use Accounts">Ready-to-Use Accounts</option>
            <option value="Bulk Deals & Reseller">Bulk Deals &amp; Reseller</option>
            <option value="Bots & Automation">Bots &amp; Automation</option>
            <option value="Method Exchange">Method Exchange</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Offer Type</label>
          <select name="offerType" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
            <option value="METHOD" selected>Working Method / Script</option>
            <option value="READY_ACCOUNT">Ready-to-Use Account</option>
            <option value="BULK_DEAL">Bulk Deal / Reseller</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Price ($ / USDT)</label>
          <input type="number" id="service-price-input" step="0.5" min="1" name="price" required placeholder="10" class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl font-bold text-slate-900 focus:bg-white focus:border-slate-900 focus:outline-none">
          <p class="text-[11px] text-slate-400 mt-1" id="seller-net-preview">Escrow fee: 15% • You receive: 85%</p>
        </div>
      </div>

      <!-- Operating Cost & Validity -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Operating / Unit Cost</label>
          <input type="text" name="unitCost" placeholder="e.g. only $0.02 / mail, $0.07 / link, or Ready to use" class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Duration / Validity</label>
          <input type="text" name="durationLabel" placeholder="e.g. 1 Year, 6 Months, Ready to use" class="w-full text-sm px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>
      </div>

      <!-- Supplier Contact Details -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Supplier Handle</label>
          <input type="text" name="supplierHandle" value="@Melasbit" placeholder="@YourHandle" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">WhatsApp Number</label>
          <input type="text" name="whatsappNumber" value="+21627076373" placeholder="+21627076373" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Products Bot (Telegram)</label>
          <input type="text" name="telegramBot" value="@Licenziobot" placeholder="@Licenziobot" class="w-full text-xs sm:text-sm px-3 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>
      </div>

      <!-- Operating Logic Toggles -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
        <label class="flex items-center gap-2 p-3 rounded-xl bg-indigo-50/70 border border-indigo-200/80 cursor-pointer">
          <input type="checkbox" name="screenShareDemo" checked class="rounded text-indigo-600">
          <span class="font-semibold text-indigo-900">Live Screen-Share Demo</span>
        </label>

        <label class="flex items-center gap-2 p-3 rounded-xl bg-amber-50/70 border border-amber-200/80 cursor-pointer">
          <input type="checkbox" name="openToExchange" checked class="rounded text-amber-600">
          <span class="font-semibold text-amber-900">Open to Method Exchange</span>
        </label>

        <label class="flex items-center gap-2 p-3 rounded-xl bg-emerald-50/70 border border-emerald-200/80 cursor-pointer">
          <input type="checkbox" name="bulkAvailable" checked class="rounded text-emerald-600">
          <span class="font-semibold text-emerald-900">Bulk Deals Available</span>
        </label>
      </div>

      <input type="hidden" name="pageCount" value="10">
      <input type="hidden" name="difficulty" value="Beginner">

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1.5">Description &amp; Method Breakdown</label>
        <textarea name="description" rows="4" required placeholder="Explain what is included, cost per account/mail/link, script features, and how you demonstrate it via screen-share..." class="w-full text-sm p-3.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none transition"></textarea>
      </div>

      <!-- Optional Files -->
      <div class="space-y-3 pt-2 border-t border-slate-100">
        <label class="block text-xs font-semibold text-slate-700">Attached Files / Scripts (Optional — delivered via Escrow)</label>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">1. Method Guide (PDF)</span>
            <input type="file" name="pdfFile" accept=".pdf" class="w-full text-[11px] text-slate-500">
          </div>

          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">2. Script / Tool Archive (ZIP)</span>
            <input type="file" name="zipFile" accept=".zip,.rar,.tar,.gz" class="w-full text-[11px] text-slate-500">
          </div>

          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">3. Commands / Notes (.txt, .sh)</span>
            <input type="file" name="textFile" accept=".txt,.md,.sh,.json,.yml,.yaml" class="w-full text-[11px] text-slate-500">
          </div>

          <div class="p-3 rounded-xl bg-[#FAFAFA] border border-slate-200 space-y-1">
            <span class="font-semibold text-slate-800 block">4. Demo Video (MP4)</span>
            <input type="file" name="videoFile" accept=".mp4,.webm,.mov" class="w-full text-[11px] text-slate-500">
          </div>
        </div>

        <div>
          <input type="url" name="videoUrl" placeholder="Or external demo video link (YouTube, Loom...)" class="w-full text-xs px-3.5 py-2.5 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>
      </div>

      <div class="pt-3 flex items-center justify-end gap-3">
        <a href="/" class="px-4 py-2.5 text-xs font-semibold text-slate-500 hover:text-slate-900">Cancel</a>
        <button type="submit" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold rounded-xl transition">
          Publish Offer
        </button>
      </div>

    </form>
  </div>

</div>

<script>
  const priceInput = document.getElementById('service-price-input');
  const netPreview = document.getElementById('seller-net-preview');
  if (priceInput && netPreview) {
    priceInput.addEventListener('input', () => {
      const val = parseFloat(priceInput.value);
      if (val && val > 0) {
        const fee = (val * 0.15).toFixed(2);
        const net = (val - val * 0.15).toFixed(2);
        netPreview.textContent = `15% escrow fee (${fee} USDT) • You receive ${net} USDT (85%)`;
      } else {
        netPreview.textContent = 'Escrow fee: 15% • You receive: 85%';
      }
    });
  }
</script>

<%- include('partials/footer') %>

<%- include('partials/header', { title: 'Publier une Méthode PDF' }) %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
  
  <div class="bg-white p-5 sm:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
    
    <div class="border-b border-slate-100 pb-5">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-semibold mb-2 border border-rose-100">
        <i class="fa-solid fa-file-pdf text-[11px] text-rose-600"></i> Méthodes & Procédures PDF
      </div>
      <h1 class="text-xl sm:text-2xl font-black text-slate-900">Publier une Méthode pas à pas pour accomplir une tâche</h1>
      <p class="text-xs text-slate-500 mt-1 leading-relaxed">
        Définissez le prix en USDT et téléversez votre document PDF. Vos acheteurs pourront télécharger le guide immédiatement dès leur commande avec protection sous séquestre.
      </p>
    </div>

    <form action="/services/new" method="POST" enctype="multipart/form-data" class="space-y-5 sm:space-y-6">
      
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Titre du Guide / Tâche expliquée
        </label>
        <input type="text" name="title" required placeholder="Ex: Guide PDF : Comment déployer une application sur AWS avec Docker & SSL" class="w-full text-xs sm:text-sm px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-slate-50/50 focus:bg-white transition">
        <p class="text-[11px] text-slate-400 mt-1">Formulez clairement la tâche résolue par votre méthode.</p>
      </div>

      <!-- Section des Fichiers & Livrables de la Méthode (PDF, ZIP, Texte, Vidéo) -->
      <div class="space-y-3 pt-2">
        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
          📦 Fichiers et Ressources Inclus dans la Méthode
        </label>
        <p class="text-[11px] text-slate-500">Ajoutez les documents, archives de code, scripts et vidéos qui composeront votre méthode complète.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          
          <!-- 1. Document PDF -->
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
            <span class="font-bold text-rose-700 flex items-center gap-1.5">
              <i class="fa-solid fa-file-pdf"></i> 1. Document PDF (Guide Pas à Pas)
            </span>
            <input type="file" name="pdfFile" accept=".pdf" class="w-full text-[11px] text-slate-600 file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-rose-600 file:text-white hover:file:bg-rose-700 cursor-pointer">
          </div>

          <!-- 2. Archive ZIP -->
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
            <span class="font-bold text-amber-700 flex items-center gap-1.5">
              <i class="fa-solid fa-file-zipper"></i> 2. Code Source & Templates (ZIP)
            </span>
            <input type="file" name="zipFile" accept=".zip,.rar,.tar,.gz" class="w-full text-[11px] text-slate-600 file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-amber-600 file:text-white hover:file:bg-amber-700 cursor-pointer">
          </div>

          <!-- 3. Fichier Texte / Scripts -->
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
            <span class="font-bold text-blue-700 flex items-center gap-1.5">
              <i class="fa-solid fa-file-lines"></i> 3. Scripts & Commandes (Texte / .sh / .env)
            </span>
            <input type="file" name="textFile" accept=".txt,.md,.sh,.env,.json,.yml,.yaml" class="w-full text-[11px] text-slate-600 file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
          </div>

          <!-- 4. Vidéo Démonstrative -->
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1.5">
            <span class="font-bold text-purple-700 flex items-center gap-1.5">
              <i class="fa-solid fa-video"></i> 4. Fichier Vidéo (MP4 / WebM)
            </span>
            <input type="file" name="videoFile" accept=".mp4,.webm,.mov" class="w-full text-[11px] text-slate-600 file:mr-2 file:py-1 file:px-2.5 file:rounded-lg file:border-0 file:text-[11px] file:font-semibold file:bg-purple-600 file:text-white hover:file:bg-purple-700 cursor-pointer">
          </div>

        </div>

        <!-- Ou Lien Vidéo Externe -->
        <div class="mt-2">
          <label class="block text-[11px] font-bold text-slate-600 mb-1 flex items-center gap-1">
            <i class="fa-brands fa-youtube text-rose-600"></i> Ou Lien du Tutoriel Vidéo (YouTube, Loom, Vimeo) :
          </label>
          <input type="url" name="videoUrl" placeholder="https://www.youtube.com/watch?v=... ou https://www.loom.com/share/..." class="w-full text-xs px-3.5 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Catégorie</label>
          <select name="category" class="w-full text-xs sm:text-sm px-3.5 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white">
            <option value="Déploiement & Cloud">Déploiement & Cloud</option>
            <option value="Backend & API">Backend & API</option>
            <option value="DevOps & CI/CD">DevOps & CI/CD</option>
            <option value="Sécurité & Blockchain">Sécurité & Blockchain</option>
            <option value="Architecture Logicielle">Architecture Logicielle</option>
            <option value="Méthodologie de Développement">Méthodologie de Développement</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Difficulté</label>
          <select name="difficulty" class="w-full text-xs sm:text-sm px-3.5 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-white">
            <option value="Débutant">Débutant</option>
            <option value="Intermédiaire" selected>Intermédiaire</option>
            <option value="Avancé">Avancé</option>
            <option value="Expert">Expert</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nombre de pages</label>
          <input type="number" name="pageCount" min="1" max="1000" value="40" required class="w-full text-xs sm:text-sm px-3.5 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none font-semibold text-slate-800">
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Prix Forfaitaire du Guide (USDT)
        </label>
        <div class="relative">
          <input type="number" step="0.5" min="1" name="price" required placeholder="25.00" class="w-full text-sm sm:text-base px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none pr-16 font-black text-slate-900 bg-slate-50/50 focus:bg-white transition">
          <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-xs font-bold text-emerald-600">
            USDT
          </div>
        </div>
        <p class="text-[11px] text-slate-500 mt-1 flex items-center gap-1">
          <i class="fa-solid fa-shield-halved text-emerald-600 text-[10px]"></i> Ce montant sera sécurisé sous séquestre lors de la commande et reversé dès validation par l'acheteur.
        </p>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Sommaire & Étapes expliquées dans la méthode
        </label>
        <textarea name="description" rows="5" required placeholder="Détaillez le plan étape par étape de la méthode :&#10;1. Cadrage et prérequis nécessaires&#10;2. Commandes et scripts à exécuter pas à pas&#10;3. Configuration et pièges fréquents à éviter&#10;4. Vérification et validation du résultat..." class="w-full text-xs sm:text-sm p-4 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none bg-slate-50/50 focus:bg-white transition"></textarea>
      </div>

      <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
        <a href="/" class="px-4 py-2.5 text-xs font-bold text-slate-600 hover:text-slate-800 transition">Annuler</a>
        <button type="submit" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold rounded-xl shadow-md shadow-emerald-200 transition flex items-center gap-2">
          <i class="fa-solid fa-file-arrow-up text-xs"></i> Publier la Méthode PDF
        </button>
      </div>

    </form>
  </div>

</div>

<%- include('partials/footer') %>

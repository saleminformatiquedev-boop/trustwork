<%- include('partials/header', { title: 'Admin Security & Arbitration' }) %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
  
  <div>
    <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">Admin Financial & Arbitration Center</h1>
    <p class="text-xs sm:text-sm text-slate-500 mt-1">
      15% platform commission on all completed transactions, Binance Pay verification, and escrow arbitration.
    </p>
  </div>

  <!-- Admin 15% Commission Overview -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-slate-900 text-white p-5 rounded-2xl">
      <span class="text-xs text-slate-400">Admin Commission Rate</span>
      <div class="text-2xl font-extrabold mt-1 text-emerald-400">15%</div>
      <span class="text-[11px] text-slate-400">Automatic split (85% Seller / 15% Admin)</span>
    </div>
    <div class="bg-white p-5 rounded-2xl border border-slate-200/90">
      <span class="text-xs text-slate-400">Total Admin Commission Earned (15%)</span>
      <div class="text-2xl font-extrabold text-emerald-600 mt-1">
        +<%= (typeof totalCommissionEarned !== 'undefined' ? totalCommissionEarned : 0).toFixed(2) %> <span class="text-xs font-semibold text-slate-400">USDT</span>
      </div>
      <span class="text-[11px] text-slate-400">Credited directly to Admin wallet</span>
    </div>
    <div class="bg-white p-5 rounded-2xl border border-slate-200/90">
      <span class="text-xs text-slate-400">Completed Sales Volume</span>
      <div class="text-2xl font-extrabold text-slate-900 mt-1">
        <%= (typeof totalCompletedVolume !== 'undefined' ? totalCompletedVolume : 0).toFixed(2) %> <span class="text-xs font-semibold text-slate-400">USDT</span>
      </div>
      <span class="text-[11px] text-slate-400"><%= typeof commissionOrders !== 'undefined' ? commissionOrders.length : 0 %> completed order(s)</span>
    </div>
  </div>

  <!-- 1. Pending Binance Pay Deposits -->
  <div class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-sm font-bold text-slate-900">Binance Pay Deposits (Verification Queue)</h2>
      <span class="text-xs text-slate-400">Verify TxID in Binance before approving</span>
    </div>
    <% if (typeof deposits !== 'undefined' && deposits.length > 0) { %>
      <div class="divide-y divide-slate-100">
        <% deposits.forEach(dep => { %>
          <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <strong class="text-slate-900 text-sm">+<%= dep.amount.toFixed(2) %> USDT</strong>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= dep.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : (dep.status === 'REJECTED' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700') %>">
                  <%= dep.status %>
                </span>
              </div>
              <div class="text-slate-500">
                User: <strong><%= dep.userName %></strong> (<%= dep.userEmail %>) • TxID: <code class="font-mono font-bold text-slate-800"><%= dep.txId %></code>
              </div>
            </div>
            <% if (dep.status === 'PENDING') { %>
              <div class="flex flex-wrap items-center gap-2">
                <form action="/admin/deposits/<%= dep.id %>/decision" method="POST">
                  <input type="hidden" name="action" value="VERIFY_API">
                  <button type="submit" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-xl transition">
                    Verify via Binance API
                  </button>
                </form>
                <form action="/admin/deposits/<%= dep.id %>/decision" method="POST">
                  <input type="hidden" name="action" value="APPROVE">
                  <button type="submit" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl transition">
                    Approve Manually
                  </button>
                </form>
                <form action="/admin/deposits/<%= dep.id %>/decision" method="POST">
                  <input type="hidden" name="action" value="REJECT">
                  <button type="submit" class="px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold rounded-xl transition">
                    Reject
                  </button>
                </form>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center text-xs text-slate-400">No deposit requests recorded.</div>
    <% } %>
  </div>

  <!-- 2. Pending USDT Withdrawals -->
  <div class="bg-white rounded-2xl border border-slate-200/90 overflow-hidden">
    <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-sm font-bold text-slate-900">USDT Withdrawal Requests</h2>
      <span class="text-xs text-slate-400">Send payout via Binance Pay then mark completed</span>
    </div>
    <% if (typeof withdrawals !== 'undefined' && withdrawals.length > 0) { %>
      <div class="divide-y divide-slate-100">
        <% withdrawals.forEach(w => { %>
          <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <strong class="text-slate-900 text-sm"><%= w.amount.toFixed(2) %> USDT</strong>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold <%= w.status === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' : (w.status === 'REJECTED' ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700') %>">
                  <%= w.status %>
                </span>
              </div>
              <div class="text-slate-500">
                User: <strong><%= w.userName %></strong> (<%= w.userEmail %>) • Binance Pay ID: <code class="font-mono font-bold text-slate-800"><%= w.binanceId %></code>
              </div>
            </div>
            <% if (w.status === 'PENDING') { %>
              <div class="flex flex-wrap items-center gap-2">
                <form action="/admin/withdrawals/<%= w.id %>/decision" method="POST">
                  <input type="hidden" name="action" value="SEND_API">
                  <button type="submit" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl transition">
                    Send via Binance API
                  </button>
                </form>
                <form action="/admin/withdrawals/<%= w.id %>/decision" method="POST">
                  <input type="hidden" name="action" value="APPROVE">
                  <button type="submit" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold rounded-xl transition">
                    Mark Sent
                  </button>
                </form>
                <form action="/admin/withdrawals/<%= w.id %>/decision" method="POST">
                  <input type="hidden" name="action" value="REJECT">
                  <button type="submit" class="px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold rounded-xl transition">
                    Reject & Refund
                  </button>
                </form>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="p-8 text-center text-xs text-slate-400">No withdrawal requests recorded.</div>
    <% } %>
  </div>

  <!-- 3. Order Disputes -->
  <div class="space-y-4">
    <h2 class="text-sm font-bold text-slate-900">Escrow Disputes</h2>
    <% if (disputes && disputes.length > 0) { %>
      <% disputes.forEach(disp => { %>
        <div class="bg-white p-6 rounded-2xl border border-slate-200/90 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          
          <div class="space-y-2 flex-grow min-w-0">
            <div class="flex items-center gap-2 text-xs">
              <span class="font-bold text-slate-400">#<%= disp.id %></span>
              <span class="font-semibold px-2.5 py-0.5 rounded-full <%= disp.status === 'OPEN' ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700' %>">
                <%= disp.status === 'OPEN' ? 'Open' : 'Resolved' %>
              </span>
              <span class="font-bold text-slate-900"><%= disp.amount.toFixed(2) %> USDT</span>
            </div>

            <h3 class="font-bold text-slate-900 text-base">
              <a href="/orders/<%= disp.orderId %>" class="hover:underline"><%= disp.serviceTitle %></a>
            </h3>

            <p class="text-xs text-slate-600"><strong>Reason:</strong> <%= disp.reason %> — <%= disp.details %></p>
          </div>

          <div class="flex flex-wrap items-center gap-2 flex-shrink-0">
            <% if (disp.status === 'OPEN') { %>
              <form action="/disputes/<%= disp.id %>/resolve" method="POST">
                <input type="hidden" name="resolution" value="REFUND_BUYER">
                <input type="hidden" name="resolutionNote" value="Full refund issued to buyer.">
                <button type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-xl transition">
                  Refund Buyer
                </button>
              </form>

              <form action="/disputes/<%= disp.id %>/resolve" method="POST">
                <input type="hidden" name="resolution" value="PAY_SELLER">
                <input type="hidden" name="resolutionNote" value="Payment released to seller.">
                <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl transition">
                  Pay Seller
                </button>
              </form>
            <% } %>
            <a href="/orders/<%= disp.orderId %>" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">
              View Order
            </a>
          </div>

        </div>
      <% }) %>
    <% } else { %>
      <div class="text-center py-10 bg-white rounded-2xl border border-slate-200/90 text-xs text-slate-400">
        No active disputes.
      </div>
    <% } %>
  </div>

</div>

<%- include('partials/footer') %>

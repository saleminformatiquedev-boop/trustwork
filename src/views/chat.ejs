<%- include('partials/header', { title: 'Messagerie & Chat Direct' }) %>

<div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 py-3 sm:py-6 flex-grow flex flex-col h-[calc(100vh-4.5rem)] md:h-[calc(100vh-5rem)]">

  <!-- Main Chat Grid (2 colonnes) -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm flex-grow flex overflow-hidden">
    
    <!-- ============================================== -->
    <!-- COLONNE GAUCHE: LISTE DES CONVERSATIONS        -->
    <!-- ============================================== -->
    <div id="chat-sidebar" class="<%= activeConversation ? 'hidden md:flex' : 'flex' %> flex-col w-full md:w-80 lg:w-96 border-r border-slate-200 flex-shrink-0 bg-slate-50/50">
      
      <!-- Conversations Header -->
      <div class="p-3.5 sm:p-4 border-b border-slate-200 bg-white space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-sm shadow-sm">
              <i class="fa-regular fa-comments"></i>
            </span>
            <div>
              <h2 class="font-black text-slate-900 text-sm sm:text-base leading-tight">Messagerie</h2>
              <p class="text-[10px] text-slate-400">Vendeurs • Acheteurs • Support</p>
            </div>
          </div>

          <!-- New Conversation Button -->
          <button id="open-new-chat-modal" type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition shadow-sm">
            <i class="fa-solid fa-plus text-[10px]"></i>
            <span class="hidden sm:inline">Nouveau</span>
          </button>
        </div>

        <!-- Bouton Rapide: Support Admin -->
        <a href="/chat?support=1" class="w-full py-2 px-3 bg-gradient-to-r from-amber-50 to-orange-50 hover:from-amber-100 hover:to-orange-100 text-amber-900 font-bold text-xs rounded-xl border border-amber-200 transition flex items-center justify-between shadow-xs">
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-headset text-amber-600"></i>
            <span>Contacter le Support Admin</span>
          </span>
          <i class="fa-solid fa-chevron-right text-[10px] text-amber-500"></i>
        </a>

        <!-- Recherche -->
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-slate-400"></i>
          <input type="text" id="conversation-search" placeholder="Rechercher une conversation..." class="w-full text-xs pl-8 pr-3 py-2 bg-slate-100 hover:bg-slate-100/80 focus:bg-white border border-transparent focus:border-emerald-500 rounded-xl focus:outline-none transition">
        </div>

        <!-- Filtres Rapides -->
        <div class="flex items-center gap-1 overflow-x-auto scrollbar-none text-[11px] font-semibold pt-0.5">
          <button type="button" class="conv-filter-btn px-2.5 py-1 rounded-lg bg-emerald-600 text-white transition flex-shrink-0" data-filter="all">Tous</button>
          <button type="button" class="conv-filter-btn px-2.5 py-1 rounded-lg bg-slate-200 text-slate-700 hover:bg-slate-300 transition flex-shrink-0" data-filter="DIRECT">Vendeurs</button>
          <button type="button" class="conv-filter-btn px-2.5 py-1 rounded-lg bg-slate-200 text-slate-700 hover:bg-slate-300 transition flex-shrink-0" data-filter="SUPPORT">Support</button>
          <% if (user.role === 'ADMIN' && typeof platformConversations !== 'undefined') { %>
            <button type="button" class="conv-filter-btn px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 hover:bg-amber-200 transition flex-shrink-0" data-filter="platform">Admin Global (<%= platformConversations.length %>)</button>
          <% } %>
        </div>
      </div>

      <!-- Conversations Cards List -->
      <div id="conversations-list" class="flex-grow overflow-y-auto divide-y divide-slate-100">
        <% if (conversations && conversations.length > 0) { %>
          <% conversations.forEach(conv => { %>
            <% const isActive = activeConversation && activeConversation.id === conv.id; %>
            <a href="/chat?conversationId=<%= conv.id %>" 
               class="conv-item block p-3 sm:p-3.5 hover:bg-slate-100/80 transition <%= isActive ? 'bg-emerald-50/70 border-l-4 border-emerald-600' : '' %>"
               data-conv-id="<%= conv.id %>"
               data-type="<%= conv.type %>"
               data-partner-name="<%= (conv.partnerName || '').toLowerCase() %>"
               data-last-message="<%= (conv.lastMessageText || '').toLowerCase() %>">
              
              <div class="flex items-start gap-3 min-w-0">
                <!-- Avatar avec indicateur en direct -->
                <div class="relative flex-shrink-0">
                  <img src="<%= conv.partnerAvatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + (conv.partnerName || 'User') %>" 
                       alt="<%= conv.partnerName %>" 
                       class="w-10 h-10 rounded-full border border-slate-200 object-cover">
                  <% if (conv.partnerRole === 'ADMIN') { %>
                    <span class="absolute -bottom-0.5 -right-0.5 w-4 h-4 rounded-full bg-amber-500 text-white flex items-center justify-center text-[8px] ring-2 ring-white" title="Support Admin">
                      <i class="fa-solid fa-shield-halved"></i>
                    </span>
                  <% } else { %>
                    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 ring-2 ring-white" title="En ligne"></span>
                  <% } %>
                </div>

                <!-- Informations -->
                <div class="flex-grow min-w-0">
                  <div class="flex items-center justify-between gap-1 mb-0.5">
                    <span class="font-bold text-xs text-slate-900 truncate flex items-center gap-1.5">
                      <%= conv.partnerName %>
                      <% if (conv.partnerRole === 'ADMIN') { %>
                        <span class="text-[9px] font-bold px-1.5 py-0.2 bg-amber-100 text-amber-800 rounded">Admin</span>
                      <% } else if (conv.type === 'SUPPORT') { %>
                        <span class="text-[9px] font-bold px-1.5 py-0.2 bg-purple-100 text-purple-800 rounded">Support</span>
                      <% } %>
                    </span>
                    <span class="text-[10px] text-slate-400 whitespace-nowrap flex-shrink-0">
                      <% const d = new Date(conv.lastMessageAt || conv.createdAt); %>
                      <%= d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }) %>
                    </span>
                  </div>

                  <!-- Aperçu du message et badge non-lu -->
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-xs text-slate-500 truncate text-[11px] <%= conv.unreadCount > 0 ? 'font-bold text-slate-900' : '' %>">
                      <%= conv.lastMessageText || 'Conversation démarrée' %>
                    </p>
                    <% if (conv.unreadCount > 0) { %>
                      <span class="unread-pill px-1.5 py-0.5 bg-emerald-600 text-white text-[10px] font-black rounded-full min-w-[18px] text-center flex-shrink-0 shadow-sm animate-pulse">
                        <%= conv.unreadCount %>
                      </span>
                    <% } %>
                  </div>

                  <% if (conv.serviceTitle) { %>
                    <div class="mt-1 flex items-center gap-1 text-[10px] text-emerald-700 bg-emerald-50/80 px-2 py-0.5 rounded-md truncate max-w-full">
                      <i class="fa-solid fa-file-pdf text-[9px] text-rose-500 flex-shrink-0"></i>
                      <span class="truncate"><%= conv.serviceTitle %></span>
                    </div>
                  <% } %>
                </div>
              </div>

            </a>
          <% }) %>
        <% } else { %>
          <div class="p-8 text-center text-slate-400 space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto text-xl">
              <i class="fa-regular fa-comment-dots"></i>
            </div>
            <p class="text-xs font-medium">Aucune conversation en cours.</p>
            <button type="button" onclick="document.getElementById('open-new-chat-modal').click()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 text-white font-bold text-xs rounded-xl shadow-sm">
              <i class="fa-solid fa-plus text-[10px]"></i> Nouvelle Discussion
            </button>
          </div>
        <% } %>

        <!-- Admin View for Platform-Wide Conversations -->
        <% if (user.role === 'ADMIN' && typeof platformConversations !== 'undefined') { %>
          <div id="platform-convs-container" class="hidden divide-y divide-slate-100">
            <% platformConversations.forEach(pconv => { %>
              <a href="/chat?conversationId=<%= pconv.id %>" class="block p-3 hover:bg-amber-50/50 transition border-l-2 border-amber-400">
                <div class="flex items-center justify-between text-[11px] mb-1">
                  <span class="font-bold text-amber-900 truncate">#<%= pconv.id %> (<%= pconv.type %>)</span>
                  <span class="text-[9px] text-slate-400"><%= new Date(pconv.lastMessageAt).toLocaleDateString('fr-FR') %></span>
                </div>
                <div class="text-[10px] font-semibold text-slate-700 mb-0.5 truncate">
                  <%= pconv.participantsSummary || 'Participants' %>
                </div>
                <div class="text-[10px] text-slate-500 truncate italic">
                  "<%= pconv.lastMessageText || 'Pas de message' %>"
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>

      </div>

      <!-- Quick Action: Contact Admin Support -->
      <div class="p-3 bg-white border-t border-slate-200">
        <a href="/chat?support=1" class="w-full py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2">
          <i class="fa-solid fa-headset text-emerald-600"></i>
          <span>Support & Arbitrage TrustWork</span>
        </a>
      </div>

    </div>

    <!-- ============================================== -->
    <!-- RIGHT COLUMN: ACTIVE CONVERSATION FEED         -->
    <!-- ============================================== -->
    <div id="chat-main" class="<%= activeConversation ? 'flex' : 'hidden md:flex' %> flex-col flex-grow bg-white h-full overflow-hidden">
      
      <% if (activeConversation && activePartner) { %>
        
        <!-- Active Discussion Header -->
        <div class="px-4 py-3 sm:py-3.5 border-b border-slate-200 flex items-center justify-between gap-3 bg-white flex-shrink-0">
          
          <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
            <!-- Mobile Back Button -->
            <a href="/chat" class="md:hidden w-8 h-8 flex items-center justify-center rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 transition" aria-label="Back to conversations">
              <i class="fa-solid fa-arrow-left text-xs"></i>
            </a>

            <!-- Partner Avatar -->
            <div class="relative flex-shrink-0">
              <img src="<%= activePartner.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + activePartner.name %>" 
                   alt="<%= activePartner.name %>" 
                   class="w-10 h-10 rounded-full border border-slate-200 object-cover">
              <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 ring-2 ring-white"></span>
            </div>

            <!-- Identity & Role -->
            <div class="min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h3 class="font-bold text-slate-900 text-xs sm:text-sm truncate">
                  <%= activePartner.name %>
                </h3>
                
                <% if (activePartner.role === 'ADMIN') { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold">
                    <i class="fa-solid fa-shield-halved text-[9px]"></i> Support & Modération
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold">
                    <i class="fa-solid fa-circle-check text-[9px]"></i> Membre Vérifié
                  </span>
                <% } %>
              </div>

              <!-- Status or Subject -->
              <p class="text-[11px] text-slate-400 truncate mt-0.5 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span id="active-partner-status">En ligne sur TrustWork</span>
                <% if (activeConversation.serviceTitle) { %>
                  <span class="text-slate-300">•</span>
                  <a href="/services/<%= activeConversation.serviceId %>" class="text-emerald-600 hover:underline truncate max-w-[200px]" target="_blank">
                    <%= activeConversation.serviceTitle %>
                  </a>
                <% } %>
              </p>
            </div>
          </div>

          <!-- Header Actions -->
          <div class="flex items-center gap-1.5 flex-shrink-0">
            <% if (activePartner.id) { %>
              <a href="/profile/<%= activePartner.id %>" target="_blank" title="Voir le profil" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center text-xs transition">
                <i class="fa-solid fa-user"></i>
              </a>
            <% } %>
            <% if (activeConversation.serviceId) { %>
              <a href="/services/<%= activeConversation.serviceId %>" target="_blank" title="Voir la méthode liée" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-emerald-600 flex items-center justify-center text-xs transition">
                <i class="fa-solid fa-box-open"></i>
              </a>
            <% } %>
          </div>

        </div>

        <!-- Messages Stream -->
        <div id="chat-messages-container" class="flex-grow p-4 sm:p-6 overflow-y-auto space-y-3 sm:space-y-4 bg-slate-50/30">
          
          <!-- Escrow Security Banner -->
          <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-800 text-[11px] flex items-center gap-2.5 mb-2 shadow-xs">
            <span class="w-6 h-6 rounded-lg bg-emerald-600 text-white flex items-center justify-center text-xs flex-shrink-0">
              <i class="fa-solid fa-lock"></i>
            </span>
            <div class="flex-grow min-w-0">
              <strong>Séquestre TrustWork Garanti :</strong> Les paiements et transactions sont protégés par le système d'escrow USDT.
            </div>
          </div>

          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(msg => { %>
              <% const isMe = user && user.id === msg.senderId; %>
              
              <div class="message-row flex flex-col <%= isMe ? 'items-end' : 'items-start' %> toast-anim">
                
                <div class="flex items-center gap-1.5 mb-0.5 text-[10px] text-slate-400">
                  <span><%= msg.senderName %></span>
                  <% if (msg.senderRole === 'ADMIN') { %>
                    <span class="text-[9px] px-1 bg-amber-100 text-amber-800 font-bold rounded">Support</span>
                  <% } %>
                </div>

                <div class="max-w-[85%] sm:max-w-md p-3 sm:p-3.5 rounded-2xl text-xs leading-relaxed break-words shadow-sm <%= isMe ? 'bg-emerald-600 text-white rounded-br-none shadow-emerald-100' : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none' %>">
                  
                  <% if (msg.content) { %>
                    <p class="whitespace-pre-line leading-relaxed"><%= msg.content %></p>
                  <% } %>

                  <!-- Attachments (Images, Documents, ZIP code) -->
                  <% if (msg.fileUrl) { %>
                    <% const isImage = msg.fileUrl.match(/\.(jpeg|jpg|gif|png|webp)$/i); %>
                    <% if (isImage) { %>
                      <div class="mt-2.5 rounded-xl overflow-hidden border border-black/10">
                        <a href="<%= msg.fileUrl %>" target="_blank" class="block hover:opacity-95 transition">
                          <img src="<%= msg.fileUrl %>" alt="<%= msg.fileName || 'Image' %>" class="max-h-56 w-full object-cover rounded-xl">
                        </a>
                      </div>
                    <% } else { %>
                      <div class="mt-2.5">
                        <a href="<%= msg.fileUrl %>" download="<%= msg.fileName || 'fichier' %>" target="_blank" class="inline-flex items-center gap-2.5 p-2.5 rounded-xl transition font-semibold text-[11px] <%= isMe ? 'bg-emerald-700 hover:bg-emerald-800 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200' %>">
                          <span class="w-8 h-8 rounded-lg flex items-center justify-center <%= isMe ? 'bg-emerald-800 text-white' : 'bg-white text-slate-700 shadow-xs' %>">
                            <i class="fa-solid fa-file-arrow-down text-sm"></i>
                          </span>
                          <div class="min-w-0 text-left">
                            <span class="block truncate max-w-[180px] font-bold"><%= msg.fileName || 'Télécharger le fichier' %></span>
                            <span class="text-[9px] opacity-80"><%= msg.fileSize || 'Pièce jointe' %></span>
                          </div>
                        </a>
                      </div>
                    <% } %>
                  <% } %>

                  <div class="flex items-center justify-end gap-1 mt-1 text-[9px] <%= isMe ? 'text-emerald-100' : 'text-slate-400' %>">
                    <span><%= new Date(msg.createdAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></span>
                    <% if (isMe) { %>
                      <i class="fa-solid fa-check-double text-[9px]"></i>
                    <% } %>
                  </div>

                </div>

              </div>
            <% }) %>
          <% } else { %>
            <div id="empty-chat-state" class="text-center py-16 text-slate-400 space-y-2">
              <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto text-xl">
                <i class="fa-regular fa-comment-dots"></i>
              </div>
              <p class="text-xs font-semibold text-slate-700">Début de la conversation</p>
              <p class="text-[11px] max-w-sm mx-auto">Posez vos questions sur la méthode ou le code, échangez des fichiers ou demandez l'aide du support.</p>
            </div>
          <% } %>

        </div>

        <!-- Live Typing Indicator -->
        <div id="typing-indicator" class="hidden px-4 py-1.5 text-[11px] text-slate-400 font-medium bg-white flex items-center gap-2 border-t border-slate-100">
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-bounce"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-bounce [animation-delay:0.2s]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-bounce [animation-delay:0.4s]"></span>
          </span>
          <span id="typing-user-text">Un membre est en train d'écrire...</span>
        </div>

        <!-- Selected File Preview Bar -->
        <div id="file-preview-bar" class="hidden px-4 py-2 bg-emerald-50 border-t border-emerald-100 flex items-center justify-between text-xs text-emerald-800">
          <div class="flex items-center gap-2 min-w-0">
            <i class="fa-solid fa-paperclip text-emerald-600 flex-shrink-0"></i>
            <span id="preview-file-name" class="font-bold truncate max-w-[250px]">nom_du_fichier.pdf</span>
            <span id="preview-file-size" class="text-[10px] text-emerald-600"></span>
          </div>
          <button type="button" id="cancel-file-btn" class="text-rose-600 hover:text-rose-700 p-1" title="Annuler le fichier">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <!-- Uploading Status -->
        <div id="chat-upload-status" class="hidden px-4 py-1.5 bg-blue-50 border-t border-blue-100 text-[11px] text-blue-700 font-medium flex items-center gap-2">
          <i class="fa-solid fa-spinner fa-spin"></i>
          <span>Envoi du fichier en cours...</span>
        </div>

        <!-- Message Input Form -->
        <form id="direct-chat-form" class="p-3 sm:p-4 border-t border-slate-200 bg-white flex items-center gap-2 flex-shrink-0">
          
          <input type="file" id="direct-file-input" class="hidden" accept=".pdf,.zip,.rar,.tar,.gz,.png,.jpg,.jpeg,.webp,.txt,.doc,.docx">
          
          <!-- Attachment Button -->
          <button type="button" id="direct-attach-btn" title="Joindre un fichier (PDF, ZIP, Image... max 25 Mo)" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition flex-shrink-0">
            <i class="fa-solid fa-paperclip text-sm"></i>
          </button>

          <!-- Text Field -->
          <input type="text" 
                 id="direct-message-input" 
                 autocomplete="off" 
                 placeholder="Écrivez votre message..." 
                 class="flex-grow text-xs sm:text-sm px-4 py-2.5 bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 focus:border-emerald-500 rounded-xl focus:outline-none transition">

          <!-- Send Button -->
          <button type="submit" id="direct-send-btn" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm rounded-xl shadow-sm transition flex items-center gap-1.5 flex-shrink-0">
            <span>Envoyer</span>
            <i class="fa-solid fa-paper-plane text-[11px]"></i>
          </button>

        </form>

      <% } else { %>
        
        <!-- Empty State: No conversation selected -->
        <div class="flex-grow flex flex-col items-center justify-center p-6 text-center space-y-4">
          <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl shadow-sm">
            <i class="fa-regular fa-comments"></i>
          </div>
          <div>
            <h3 class="font-black text-slate-900 text-base sm:text-lg">Sélectionnez une conversation</h3>
            <p class="text-xs text-slate-500 max-w-sm mt-1">
              Communiquez en direct avec les auteurs de méthodes, vos acheteurs, ou l'équipe du Support Admin.
            </p>
          </div>

          <div class="flex flex-wrap justify-center gap-2 pt-2">
            <button type="button" onclick="document.getElementById('open-new-chat-modal').click()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-sm transition flex items-center gap-1.5">
              <i class="fa-solid fa-plus text-[10px]"></i> Nouvelle Discussion
            </button>
            <a href="/chat?support=1" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs rounded-xl transition flex items-center gap-1.5 shadow-sm">
              <i class="fa-solid fa-headset text-slate-950"></i> Support Admin TrustWork
            </a>
          </div>
        </div>

      <% } %>

    </div>

  </div>

</div>

<!-- ============================================== -->
<!-- MODAL: NOUVELLE CONVERSATION / ANNUAIRE CONTACT -->
<!-- ============================================== -->
<div id="new-chat-modal" class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full max-h-[85vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden toast-anim">
    
    <!-- Modal Header -->
    <div class="p-4 sm:p-5 border-b border-slate-200 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-address-book"></i>
        </span>
        <div>
          <h3 class="font-black text-slate-900 text-base">Nouvelle Conversation</h3>
          <p class="text-[11px] text-slate-400">Choisissez un auteur ou contactez l'admin</p>
        </div>
      </div>
      <button type="button" id="close-new-chat-modal" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Direct Support Shortcut -->
    <div class="p-4 bg-gradient-to-r from-amber-50 to-orange-50 border-b border-amber-200 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center text-base shadow-sm">
          <i class="fa-solid fa-headset"></i>
        </span>
        <div>
          <h4 class="font-bold text-xs text-amber-950">Support & Arbitrage TrustWork</h4>
          <p class="text-[11px] text-amber-800">Assistance pour transactions, commandes et sécurité escrow.</p>
        </div>
      </div>
      <a href="/chat?support=1" class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow-sm transition flex-shrink-0">
        Discuter
      </a>
    </div>

    <!-- Contacts Search -->
    <div class="p-3 border-b border-slate-100 bg-slate-50">
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-slate-400"></i>
        <input type="text" id="contact-search-input" placeholder="Filtrer par nom ou rôle..." class="w-full text-xs pl-8 pr-3 py-2 bg-white border border-slate-200 focus:border-emerald-500 rounded-xl focus:outline-none">
      </div>
    </div>

    <!-- Available Contacts List -->
    <div id="contacts-list" class="flex-grow overflow-y-auto divide-y divide-slate-100 p-2">
      <% if (contacts && contacts.length > 0) { %>
        <% contacts.forEach(c => { %>
          <div class="contact-item p-3 rounded-xl hover:bg-slate-50 transition flex items-center justify-between gap-3" data-name="<%= c.name.toLowerCase() %>" data-role="<%= c.role.toLowerCase() %>">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= c.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + c.name %>" class="w-10 h-10 rounded-full border border-slate-200 object-cover flex-shrink-0">
              <div class="min-w-0">
                <div class="flex items-center gap-1.5">
                  <h4 class="font-bold text-xs text-slate-900 truncate"><%= c.name %></h4>
                  <% if (c.role === 'ADMIN') { %>
                    <span class="text-[9px] font-bold px-1.5 py-0.2 bg-amber-100 text-amber-800 rounded">Admin Support</span>
                  <% } else if (c.servicesCount > 0) { %>
                    <span class="text-[9px] font-bold px-1.5 py-0.2 bg-emerald-100 text-emerald-800 rounded">Auteur (<%= c.servicesCount %> méthodes)</span>
                  <% } else { %>
                    <span class="text-[9px] font-bold px-1.5 py-0.2 bg-blue-100 text-blue-800 rounded">Acheteur</span>
                  <% } %>
                </div>
                <p class="text-[11px] text-slate-400 truncate"><%= c.bio || c.email %></p>
              </div>
            </div>

            <a href="/chat?recipientId=<%= c.id %>" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-sm transition flex-shrink-0">
              Discuter
            </a>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-xs text-slate-400 text-center py-8">Aucun contact trouvé.</p>
      <% } %>
    </div>

  </div>
</div>

<!-- Socket.io Script -->
<script>
  const currentUserId = "<%= user ? user.id : '' %>";
  const currentUserName = "<%= user ? user.name : 'Me' %>";
  const currentUserAvatar = "<%= user ? (user.avatar || '') : '' %>";
  const currentUserRole = "<%= user ? user.role : 'USER' %>";
  const activeConvId = "<%= activeConversation ? activeConversation.id : '' %>";

  const socket = io();

  // Register socket
  if (currentUserId) {
    socket.emit('join_user', { userId: currentUserId });
  }

  // DOM Elements
  const messagesContainer = document.getElementById('chat-messages-container');
  const chatForm = document.getElementById('direct-chat-form');
  const messageInput = document.getElementById('direct-message-input');
  const fileInput = document.getElementById('direct-file-input');
  const attachBtn = document.getElementById('direct-attach-btn');
  const filePreviewBar = document.getElementById('file-preview-bar');
  const previewFileName = document.getElementById('preview-file-name');
  const previewFileSize = document.getElementById('preview-file-size');
  const cancelFileBtn = document.getElementById('cancel-file-btn');
  const uploadStatus = document.getElementById('chat-upload-status');
  const typingIndicator = document.getElementById('typing-indicator');
  const typingUserText = document.getElementById('typing-user-text');
  const emptyState = document.getElementById('empty-chat-state');

  let selectedFile = null;
  let typingTimeout = null;

  function scrollToBottom() {
    if (messagesContainer) {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
  }
  scrollToBottom();

  if (activeConvId) {
    socket.emit('join_conversation', { conversationId: activeConvId, userId: currentUserId });
    socket.emit('chat_mark_read', { conversationId: activeConvId, userId: currentUserId });
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderIncomingMessage(msg) {
    if (!messagesContainer) return;
    if (emptyState) emptyState.style.display = 'none';

    const isMe = msg.senderId === currentUserId;
    const row = document.createElement('div');
    row.className = `message-row flex flex-col ${isMe ? 'items-end' : 'items-start'} toast-anim`;

    let fileHtml = '';
    if (msg.fileUrl) {
      const isImage = msg.fileUrl.match(/\.(jpeg|jpg|gif|png|webp)$/i);
      const safeFileUrl = encodeURI(msg.fileUrl);
      const safeFileName = escapeHtml(msg.fileName || 'File');
      const safeFileSize = escapeHtml(msg.fileSize || '');

      if (isImage) {
        fileHtml = `
          <div class="mt-2.5 rounded-xl overflow-hidden border border-black/10">
            <a href="${safeFileUrl}" target="_blank" class="block hover:opacity-95 transition">
              <img src="${safeFileUrl}" alt="${safeFileName}" class="max-h-56 w-full object-cover rounded-xl">
            </a>
          </div>
        `;
      } else {
        fileHtml = `
          <div class="mt-2.5">
            <a href="${safeFileUrl}" download="${safeFileName}" target="_blank" class="inline-flex items-center gap-2.5 p-2.5 rounded-xl transition font-semibold text-[11px] ${
              isMe ? 'bg-emerald-700 hover:bg-emerald-800 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200'
            }">
              <span class="w-8 h-8 rounded-lg flex items-center justify-center ${isMe ? 'bg-emerald-800 text-white' : 'bg-white text-slate-700 shadow-xs'}">
                <i class="fa-solid fa-file-arrow-down text-sm"></i>
              </span>
              <div class="min-w-0 text-left">
                <span class="block truncate max-w-[180px] font-bold">${safeFileName}</span>
                <span class="text-[9px] opacity-80">${safeFileSize || 'Attachment'}</span>
              </div>
            </a>
          </div>
        `;
      }
    }

    const timeStr = new Date(msg.createdAt || Date.now()).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    const safeContent = msg.content ? `<p class="whitespace-pre-line leading-relaxed">${escapeHtml(msg.content)}</p>` : '';
    const safeSenderName = escapeHtml(msg.senderName || 'Member');
    const roleBadge = msg.senderRole === 'ADMIN' ? '<span class="text-[9px] px-1 bg-amber-100 text-amber-800 font-bold rounded">Support</span>' : '';

    row.innerHTML = `
      <div class="flex items-center gap-1.5 mb-0.5 text-[10px] text-slate-400">
        <span>${safeSenderName}</span>
        ${roleBadge}
      </div>
      <div class="max-w-[85%] sm:max-w-md p-3 sm:p-3.5 rounded-2xl text-xs leading-relaxed break-words shadow-sm ${
        isMe ? 'bg-emerald-600 text-white rounded-br-none shadow-emerald-100' : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none'
      }">
        ${safeContent}
        ${fileHtml}
        <div class="flex items-center justify-end gap-1 mt-1 text-[9px] ${isMe ? 'text-emerald-100' : 'text-slate-400'}">
          <span>${timeStr}</span>
          ${isMe ? '<i class="fa-solid fa-check-double text-[9px]"></i>' : ''}
        </div>
      </div>
    `;

    messagesContainer.appendChild(row);
    scrollToBottom();
  }

  socket.on('new_chat_message', (msg) => {
    if (msg.conversationId === activeConvId) {
      renderIncomingMessage(msg);
      if (msg.senderId !== currentUserId) {
        socket.emit('chat_mark_read', { conversationId: activeConvId, userId: currentUserId });
      }
    }
  });

  socket.on('user_typing', ({ conversationId, userId, userName, isTyping }) => {
    if (conversationId === activeConvId && userId !== currentUserId) {
      if (isTyping) {
        if (typingUserText) typingUserText.textContent = `${userName || 'Member'} is typing...`;
        if (typingIndicator) typingIndicator.classList.remove('hidden');
        scrollToBottom();
      } else {
        if (typingIndicator) typingIndicator.classList.add('hidden');
      }
    }
  });

  if (attachBtn && fileInput) {
    attachBtn.addEventListener('click', () => {
      fileInput.click();
    });

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      if (file.size > 25 * 1024 * 1024) {
        window.showToast('File size must not exceed 25 MB', 'error');
        fileInput.value = '';
        return;
      }

      selectedFile = file;
      if (previewFileName) previewFileName.textContent = file.name;
      if (previewFileSize) {
        const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
        previewFileSize.textContent = sizeMb > 0 ? `(${sizeMb} MB)` : `(${(file.size / 1024).toFixed(0)} KB)`;
      }
      if (filePreviewBar) filePreviewBar.classList.remove('hidden');
    });
  }

  if (cancelFileBtn) {
    cancelFileBtn.addEventListener('click', () => {
      selectedFile = null;
      if (fileInput) fileInput.value = '';
      if (filePreviewBar) filePreviewBar.classList.add('hidden');
    });
  }

  if (messageInput) {
    messageInput.addEventListener('input', () => {
      if (!activeConvId) return;
      socket.emit('chat_typing', {
        conversationId: activeConvId,
        userId: currentUserId,
        userName: currentUserName,
        isTyping: true
      });

      clearTimeout(typingTimeout);
      typingTimeout = setTimeout(() => {
        socket.emit('chat_typing', {
          conversationId: activeConvId,
          userId: currentUserId,
          userName: currentUserName,
          isTyping: false
        });
      }, 1500);
    });
  }

  if (chatForm) {
    chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = messageInput ? messageInput.value.trim() : '';
      if (!content && !selectedFile) return;

      if (selectedFile) {
        if (uploadStatus) uploadStatus.classList.remove('hidden');
        const formData = new FormData();
        formData.append('conversationId', activeConvId);
        formData.append('content', content);
        formData.append('file', selectedFile);

        try {
          const res = await fetch('/api/chat/messages', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.success) {
            if (messageInput) messageInput.value = '';
            selectedFile = null;
            if (fileInput) fileInput.value = '';
            if (filePreviewBar) filePreviewBar.classList.add('hidden');
          } else {
            window.showToast(data.error || 'Error sending file', 'error');
          }
        } catch (err) {
          window.showToast('Network error during upload', 'error');
        } finally {
          if (uploadStatus) uploadStatus.classList.add('hidden');
        }
      } else {
        socket.emit('chat_send_message', {
          conversationId: activeConvId,
          senderId: currentUserId,
          senderName: currentUserName,
          senderAvatar: currentUserAvatar,
          senderRole: currentUserRole,
          content
        });

        if (messageInput) {
          messageInput.value = '';
          messageInput.focus();
        }
      }

      socket.emit('chat_typing', {
        conversationId: activeConvId,
        userId: currentUserId,
        userName: currentUserName,
        isTyping: false
      });
    });
  }

  // Filter Buttons
  const filterBtns = document.querySelectorAll('.conv-filter-btn');
  const convItems = document.querySelectorAll('.conv-item');
  const platformContainer = document.getElementById('platform-convs-container');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-emerald-600', 'text-white');
        b.classList.add('bg-slate-200', 'text-slate-700');
      });
      btn.classList.remove('bg-slate-200', 'text-slate-700');
      btn.classList.add('bg-emerald-600', 'text-white');

      const filter = btn.getAttribute('data-filter');

      if (filter === 'platform') {
        convItems.forEach(item => item.style.display = 'none');
        if (platformContainer) platformContainer.classList.remove('hidden');
      } else {
        if (platformContainer) platformContainer.classList.add('hidden');
        convItems.forEach(item => {
          const itemType = item.getAttribute('data-type');
          if (filter === 'all' || itemType === filter) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      }
    });
  });

  const convSearchInput = document.getElementById('conversation-search');
  if (convSearchInput) {
    convSearchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      convItems.forEach(item => {
        const name = item.getAttribute('data-partner-name') || '';
        const lastMsg = item.getAttribute('data-last-message') || '';
        if (name.includes(q) || lastMsg.includes(q)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  }

  const openModalBtn = document.getElementById('open-new-chat-modal');
  const closeModalBtn = document.getElementById('close-new-chat-modal');
  const newChatModal = document.getElementById('new-chat-modal');
  const contactSearchInput = document.getElementById('contact-search-input');
  const contactItems = document.querySelectorAll('.contact-item');

  if (openModalBtn && newChatModal) {
    openModalBtn.addEventListener('click', () => newChatModal.classList.remove('hidden'));
  }
  if (closeModalBtn && newChatModal) {
    closeModalBtn.addEventListener('click', () => newChatModal.classList.add('hidden'));
  }
  if (newChatModal) {
    newChatModal.addEventListener('click', (e) => {
      if (e.target === newChatModal) newChatModal.classList.add('hidden');
    });
  }

  if (contactSearchInput) {
    contactSearchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      contactItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const role = item.getAttribute('data-role') || '';
        if (name.includes(q) || role.includes(q)) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    });
  }
</script>

<%- include('partials/footer') %>

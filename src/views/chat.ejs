<%- include('partials/header', { title: 'Messages' }) %>

<% const mobileListActive = (typeof showMobileList !== 'undefined' && showMobileList) || !activeConversation; %>

<div class="max-w-5xl mx-auto px-2 sm:px-6 py-2 sm:py-6 w-full flex flex-col h-[calc(100dvh-8.25rem)] md:h-[calc(100dvh-5.5rem)]">

  <div class="bg-white rounded-2xl border border-slate-200/90 flex-grow flex overflow-hidden h-full">
    
    <!-- Left Sidebar: Conversations List -->
    <div id="chat-sidebar" class="<%= mobileListActive ? 'flex' : 'hidden md:flex' %> flex-col w-full md:w-80 border-r border-slate-200/80 flex-shrink-0 bg-[#FAFAFA] h-full">
      
      <div class="p-4 border-b border-slate-200/80 bg-white space-y-3 flex-shrink-0">
        <div class="flex items-center justify-between">
          <h2 class="font-bold text-slate-900 text-sm">Messages (<%= conversations ? conversations.length : 0 %>)</h2>
          <button id="open-new-chat-modal" type="button" class="px-2.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-lg transition">
            + New Chat
          </button>
        </div>

        <a href="/chat?support=1" class="w-full py-2 px-3 bg-amber-50 hover:bg-amber-100 text-amber-900 font-semibold text-xs rounded-xl border border-amber-200/80 transition flex items-center justify-between">
          <span class="flex items-center gap-2">
            <i class="fa-solid fa-headset text-amber-600"></i>
            <span>Contact Admin Support</span>
          </span>
          <i class="fa-solid fa-chevron-right text-[10px] text-amber-500"></i>
        </a>

        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-xs text-slate-400"></i>
          <input type="text" id="conversation-search" placeholder="Search conversations..." class="w-full text-xs pl-8 pr-3 py-2 bg-[#FAFAFA] border border-slate-200 rounded-xl focus:bg-white focus:border-slate-900 focus:outline-none">
        </div>
      </div>

      <!-- Conversations List -->
      <div id="conversations-list" class="flex-grow overflow-y-auto divide-y divide-slate-100">
        <% if (conversations && conversations.length > 0) { %>
          <% conversations.forEach(conv => { %>
            <% const isActive = !mobileListActive && activeConversation && activeConversation.id === conv.id; %>
            <a href="/chat?conversationId=<%= conv.id %>" 
               class="conv-item block p-3.5 hover:bg-white transition <%= isActive ? 'bg-white border-l-2 border-slate-900' : '' %>"
               data-conv-id="<%= conv.id %>"
               data-type="<%= conv.type %>"
               data-partner-name="<%= (conv.partnerName || '').toLowerCase() %>"
               data-last-message="<%= (conv.lastMessageText || '').toLowerCase() %>">
              
              <div class="flex items-start gap-3 min-w-0">
                <img src="<%= conv.partnerAvatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + (conv.partnerName || 'User') %>" 
                     alt="<%= conv.partnerName %>" 
                     class="w-10 h-10 rounded-full border border-slate-200 object-cover flex-shrink-0">

                <div class="flex-grow min-w-0">
                  <div class="flex items-center justify-between gap-1 mb-0.5">
                    <span class="font-semibold text-xs text-slate-900 truncate">
                      <%= conv.partnerName %>
                    </span>
                    <span class="text-[10px] text-slate-400 flex-shrink-0">
                      <% const d = new Date(conv.lastMessageAt || conv.createdAt); %>
                      <%= d.toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %>
                    </span>
                  </div>

                  <div class="flex items-center justify-between gap-2">
                    <p class="text-xs text-slate-500 truncate <%= conv.unreadCount > 0 ? 'font-bold text-slate-900' : '' %>">
                      <%= conv.lastMessageText || 'Conversation started' %>
                    </p>
                    <% if (conv.unreadCount > 0) { %>
                      <span class="tw-unread px-1.5 py-1 text-[10px] min-w-[20px] flex-shrink-0">
                        <%= conv.unreadCount > 9 ? '9+' : conv.unreadCount %>
                      </span>
                    <% } else { %>
                      <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 md:hidden"></i>
                    <% } %>
                  </div>
                </div>
              </div>

            </a>
          <% }) %>
        <% } else { %>
          <div class="p-8 text-center text-slate-400 space-y-2">
            <p class="text-xs">No conversations yet.</p>
            <button type="button" onclick="document.getElementById('open-new-chat-modal').click()" class="px-3 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded-lg">
              Start a Chat
            </button>
          </div>
        <% } %>

        <% if (user && user.role === 'ADMIN' && typeof platformConversations !== 'undefined' && platformConversations.length > 0) { %>
          <div class="px-4 py-2 bg-slate-100 text-[10px] font-bold uppercase tracking-wider text-slate-500">
            All Platform Chats (Admin)
          </div>
          <% platformConversations.forEach(pConv => { %>
            <a href="/chat?conversationId=<%= pConv.id %>" class="block p-3.5 hover:bg-white transition text-xs">
              <div class="font-semibold text-slate-900 truncate"><%= pConv.participantsSummary || pConv.subject %></div>
              <div class="text-slate-400 text-[11px] truncate"><%= pConv.lastMessageText %></div>
            </a>
          <% }) %>
        <% } %>
      </div>

    </div>

    <!-- Right Column: Active Conversation -->
    <div id="chat-main" class="<%= mobileListActive ? 'hidden md:flex' : 'flex' %> flex-col flex-grow bg-white h-full overflow-hidden">
      
      <% if (activeConversation && activePartner) { %>
        
        <div class="px-3 sm:px-4 py-3 border-b border-slate-200/80 flex items-center justify-between gap-2 bg-white flex-shrink-0">
          <div class="flex items-center gap-2.5 min-w-0">
            <button type="button" id="mobile-back-to-list-btn" class="md:hidden inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold flex-shrink-0">
              <i class="fa-solid fa-arrow-left text-[10px]"></i>
              <span>Chats</span>
            </button>
            <img src="<%= activePartner.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + activePartner.name %>" 
                 alt="<%= activePartner.name %>" 
                 class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-slate-200 object-cover flex-shrink-0">
            <div class="min-w-0">
              <h3 class="font-bold text-slate-900 text-xs sm:text-sm truncate"><%= activePartner.name %></h3>
              <p class="text-[10px] sm:text-[11px] text-emerald-600">Online</p>
            </div>
          </div>

          <% if (activePartner.id) { %>
            <a href="/profile/<%= activePartner.id %>" class="text-xs font-medium text-slate-500 hover:text-slate-900 flex-shrink-0">
              View Profile
            </a>
          <% } %>
        </div>

        <!-- Messages -->
        <div id="chat-messages-container" class="flex-grow p-3.5 sm:p-5 overflow-y-auto space-y-3 bg-[#FAFAFA]/50 min-h-0">
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(msg => { %>
              <% const isMe = user && user.id === msg.senderId; %>
              <div class="message-row flex flex-col <%= isMe ? 'items-end' : 'items-start' %>">
                <span class="text-[10px] text-slate-400 mb-0.5"><%= msg.senderName %></span>
                <div class="max-w-[82%] px-3.5 py-2.5 rounded-2xl text-xs leading-relaxed break-words <%= isMe ? 'bg-slate-900 text-white' : 'bg-white text-slate-800 border border-slate-200/90' %>">
                  <% if (msg.content) { %>
                    <p class="whitespace-pre-line"><%= msg.content %></p>
                  <% } %>
                  <% if (msg.fileUrl) { %>
                    <a href="<%= msg.fileUrl %>" download="<%= msg.fileName || 'file' %>" target="_blank" class="mt-1.5 inline-flex items-center gap-1.5 underline font-medium">
                      <i class="fa-solid fa-paperclip"></i> <%= msg.fileName || 'Download attachment' %>
                    </a>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div id="empty-chat-state" class="text-center py-12 text-slate-400 text-xs">
              Send a message below to start the conversation.
            </div>
          <% } %>
        </div>

        <div id="file-preview-bar" class="hidden px-4 py-2 bg-slate-100 border-t border-slate-200 flex items-center justify-between text-xs text-slate-700 flex-shrink-0">
          <span id="preview-file-name" class="font-semibold truncate">file.pdf</span>
          <button type="button" id="cancel-file-btn" class="text-rose-600"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div id="chat-upload-status" class="hidden px-4 py-1.5 bg-slate-50 border-t border-slate-100 text-[11px] text-slate-500 flex-shrink-0">
          Uploading file...
        </div>

        <form id="direct-chat-form" class="p-2.5 sm:p-3 border-t border-slate-200/80 bg-white flex items-center gap-2 flex-shrink-0">
          <input type="file" id="direct-file-input" class="hidden" accept=".pdf,.zip,.rar,.tar,.gz,.png,.jpg,.jpeg,.webp,.txt,.doc,.docx">
          <button type="button" id="direct-attach-btn" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition flex-shrink-0">
            <i class="fa-solid fa-paperclip text-xs"></i>
          </button>
          <input type="text" id="direct-message-input" autocomplete="off" placeholder="Write a message..." class="flex-grow text-xs sm:text-sm px-3.5 py-2 bg-[#FAFAFA] border border-slate-200 focus:bg-white focus:border-slate-900 rounded-xl focus:outline-none transition min-w-0">
          <button type="submit" id="direct-send-btn" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-xl transition flex-shrink-0">
            Send
          </button>
        </form>

      <% } else { %>
        <div class="flex-grow flex flex-col items-center justify-center p-6 text-center space-y-3">
          <h3 class="font-bold text-slate-900 text-sm">Select a conversation</h3>
          <p class="text-xs text-slate-400 max-w-xs">
            Chat directly with method authors, buyers, or Admin Support.
          </p>
          <div class="flex gap-2 pt-1">
            <button type="button" onclick="document.getElementById('open-new-chat-modal').click()" class="px-3.5 py-2 bg-slate-900 text-white font-semibold text-xs rounded-xl">
              New Chat
            </button>
            <a href="/chat?support=1" class="px-3.5 py-2 bg-slate-100 text-slate-700 font-semibold text-xs rounded-xl">
              Admin Support
            </a>
          </div>
        </div>
      <% } %>

    </div>

  </div>

</div>

<!-- New Conversation Modal -->
<div id="new-chat-modal" class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full max-h-[80vh] flex flex-col shadow-xl border border-slate-200 overflow-hidden toast-anim">
    <div class="p-4 border-b border-slate-100 flex items-center justify-between">
      <h3 class="font-bold text-slate-900 text-sm">New Conversation</h3>
      <button type="button" id="close-new-chat-modal" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center">
        <i class="fa-solid fa-xmark text-xs"></i>
      </button>
    </div>

    <div id="contacts-list" class="flex-grow overflow-y-auto divide-y divide-slate-100 p-2">
      <% if (contacts && contacts.length > 0) { %>
        <% contacts.forEach(c => { %>
          <div class="contact-item p-3 rounded-xl hover:bg-slate-50 transition flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <img src="<%= c.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + c.name %>" class="w-9 h-9 rounded-full border border-slate-200 object-cover flex-shrink-0">
              <div class="min-w-0">
                <h4 class="font-semibold text-xs text-slate-900 truncate"><%= c.name %></h4>
                <p class="text-[11px] text-slate-400 truncate"><%= c.role === 'ADMIN' ? 'Admin Support' : (c.servicesCount > 0 ? 'Author' : 'Member') %></p>
              </div>
            </div>
            <a href="/chat?recipientId=<%= c.id %>" class="px-3 py-1.5 bg-slate-900 text-white font-semibold text-xs rounded-lg">
              Chat
            </a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<script>
  const currentUserId = "<%= user ? user.id : '' %>";
  const activeConvId = "<%= activeConversation ? activeConversation.id : '' %>";
  const socket = io();

  if (currentUserId) socket.emit('join_user');

  const chatSidebar = document.getElementById('chat-sidebar');
  const chatMain = document.getElementById('chat-main');
  const mobileBackBtn = document.getElementById('mobile-back-to-list-btn');

  // Instant mobile toggle back to conversation list
  if (mobileBackBtn && chatSidebar && chatMain) {
    mobileBackBtn.addEventListener('click', () => {
      chatMain.classList.add('hidden');
      chatMain.classList.remove('flex');
      chatSidebar.classList.remove('hidden');
      chatSidebar.classList.add('flex');
      if (window.history && window.history.replaceState) {
        window.history.replaceState({}, '', '/chat');
      }
    });
  }

  const messagesContainer = document.getElementById('chat-messages-container');
  const chatForm = document.getElementById('direct-chat-form');
  const messageInput = document.getElementById('direct-message-input');
  const fileInput = document.getElementById('direct-file-input');
  const attachBtn = document.getElementById('direct-attach-btn');
  const filePreviewBar = document.getElementById('file-preview-bar');
  const previewFileName = document.getElementById('preview-file-name');
  const cancelFileBtn = document.getElementById('cancel-file-btn');
  const uploadStatus = document.getElementById('chat-upload-status');
  const emptyState = document.getElementById('empty-chat-state');

  let selectedFile = null;

  function scrollToBottom() {
    if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }
  scrollToBottom();

  if (activeConvId) {
    socket.emit('join_conversation', { conversationId: activeConvId });
    socket.emit('chat_mark_read', { conversationId: activeConvId });
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  socket.on('new_chat_message', (msg) => {
    if (msg.conversationId !== activeConvId || !messagesContainer) return;
    if (emptyState) emptyState.style.display = 'none';
    const isMe = msg.senderId === currentUserId;
    const row = document.createElement('div');
    row.className = `message-row flex flex-col ${isMe ? 'items-end' : 'items-start'}`;
    const fileHtml = msg.fileUrl ? `<a href="${encodeURI(msg.fileUrl)}" download="${escapeHtml(msg.fileName || 'file')}" target="_blank" class="mt-1.5 inline-flex items-center gap-1.5 underline font-medium"><i class="fa-solid fa-paperclip"></i> ${escapeHtml(msg.fileName || 'Attachment')}</a>` : '';
    row.innerHTML = `
      <span class="text-[10px] text-slate-400 mb-0.5">${escapeHtml(msg.senderName || 'Member')}</span>
      <div class="max-w-[82%] px-3.5 py-2.5 rounded-2xl text-xs leading-relaxed break-words ${isMe ? 'bg-slate-900 text-white' : 'bg-white text-slate-800 border border-slate-200/90'}">
        ${msg.content ? `<p class="whitespace-pre-line">${escapeHtml(msg.content)}</p>` : ''}
        ${fileHtml}
      </div>
    `;
    messagesContainer.appendChild(row);
    scrollToBottom();
    if (!isMe) socket.emit('chat_mark_read', { conversationId: activeConvId });
  });

  if (attachBtn && fileInput) {
    attachBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      selectedFile = file;
      if (previewFileName) previewFileName.textContent = file.name;
      if (filePreviewBar) filePreviewBar.classList.remove('hidden');
    });
  }

  if (cancelFileBtn) {
    cancelFileBtn.addEventListener('click', () => {
      selectedFile = null;
      if (fileInput) fileInput.value = '';
      if (filePreviewBar) filePreviewBar.classList.add('hidden');
    });
  }

  if (chatForm) {
    chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = messageInput ? messageInput.value.trim() : '';
      if (!content && !selectedFile) return;

      if (selectedFile) {
        if (uploadStatus) uploadStatus.classList.remove('hidden');
        const formData = new FormData();
        formData.append('conversationId', activeConvId);
        formData.append('content', content);
        formData.append('file', selectedFile);
        try {
          const res = await fetch('/api/chat/messages', { method: 'POST', body: formData });
          const data = await res.json();
          if (data.success) {
            if (messageInput) messageInput.value = '';
            selectedFile = null;
            if (fileInput) fileInput.value = '';
            if (filePreviewBar) filePreviewBar.classList.add('hidden');
          }
        } finally {
          if (uploadStatus) uploadStatus.classList.add('hidden');
        }
      } else {
        socket.emit('chat_send_message', { conversationId: activeConvId, content });
        if (messageInput) messageInput.value = '';
      }
    });
  }

  const convSearchInput = document.getElementById('conversation-search');
  const convItems = document.querySelectorAll('.conv-item');
  if (convSearchInput) {
    convSearchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      convItems.forEach(item => {
        const name = item.getAttribute('data-partner-name') || '';
        const lastMsg = item.getAttribute('data-last-message') || '';
        item.style.display = (name.includes(q) || lastMsg.includes(q)) ? 'block' : 'none';
      });
    });
  }

  const openModalBtn = document.getElementById('open-new-chat-modal');
  const closeModalBtn = document.getElementById('close-new-chat-modal');
  const newChatModal = document.getElementById('new-chat-modal');
  if (openModalBtn && newChatModal) openModalBtn.addEventListener('click', () => newChatModal.classList.remove('hidden'));
  if (closeModalBtn && newChatModal) closeModalBtn.addEventListener('click', () => newChatModal.classList.add('hidden'));
</script>

<%- include('partials/footer') %>

PORT=3000
HOST="127.0.0.1"
SESSION_SECRET="replace-with-64-byte-cryptographic-random-hex"
ENABLE_DEMO_MODE="false"

# PostgreSQL Connection
DATABASE_URL="postgresql://trustwork_user:yourpassword@localhost:5432/trustwork"

# Google OAuth 2.0 & Firebase Auth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://51.20.182.245.sslip.io/auth/google/callback"
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_PROJECT_ID="your-project"
FIREBASE_APP_ID="your-firebase-app-id"

# Telegram Stars Payments (official currency for digital goods)
# 1. Create a bot with @BotFather and paste its token
# 2. Set a public HTTPS base URL for the webhook (e.g. https://your-domain.com)
# 3. Set a random webhook secret (1-256 chars, A-Z a-z 0-9 _ -)
TELEGRAM_BOT_TOKEN="123456789:AA...your-bot-token..."
TELEGRAM_BOT_USERNAME="your_bot_username"
# Public HTTPS URL used for the webhook (leave empty to use long polling in dev)
TELEGRAM_WEBHOOK_URL="https://your-domain.com"
# 1-256 chars, A-Z a-z 0-9 _ - (also used as the webhook path segment)
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-secret"
# Set to "false" to disable long polling when no webhook URL is set
TELEGRAM_POLLING="true"
# Stars charged per 1 USD (Telegram sells Stars in packs; adjust to your margin)
TG_STARS_PER_USD="77"

# SMTP Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFICATION_EMAIL=your-email@gmail.com
ADMIN_EMAIL=your-email@gmail.com
